        private int LiveBullTriggerScore(int index)
        {
            return LiveBullTriggerScore(Bars, index);
        }

        private int LiveBullTriggerScore(Bars bars, int index)
        {
            if (bars == null || index < 20 || index >= bars.Count)
                return 0;

            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0)
                return 0;

            double open = bars.OpenPrices[index];
            double close = bars.ClosePrices[index];
            double high = bars.HighPrices[index];
            double low = bars.LowPrices[index];
            double range = high - low;
            double body = Math.Abs(close - open);
            double closeLocation = range > 0 ? (close - low) / range : 0.5;
            double ema = GetEma(bars, index, FastEma);
            double priorHigh = HighestHigh(bars, Math.Max(0, index - 6), index - 1);
            double priorBody = Math.Abs(
                bars.ClosePrices[index - 1] -
                bars.OpenPrices[index - 1]);

            int score = 0;
            double referencePrice = index == bars.Count - 1 ? Symbol.Ask : close;
            if (referencePrice > ema) score++;
            if (close > open && body >= atr * MinimumTriggerBodyAtr) score++;
            if (closeLocation >= MinimumCloseLocation) score++;
            if (close > bars.HighPrices[index - 1]) score++;
            if (close > priorHigh) score++;
            if (body >= Math.Max(
                    atr * 0.12,
                    priorBody * 1.10)) score++;

            // On the live forming bar, use a break of the PREVIOUS bar high.
            // The current bar high already includes the latest price update.
            if (index == bars.Count - 1 &&
                Symbol.Ask >= bars.HighPrices[index - 1] + atr * EntryTriggerBufferAtr &&
                score < 6)
            {
                score = Math.Min(6, score + 1);
            }

            return Math.Min(6, score);
        }

        private int LiveBearTriggerScore(int index)
        {
            return LiveBearTriggerScore(Bars, index);
        }

        private int LiveBearTriggerScore(Bars bars, int index)
        {
            if (bars == null || index < 20 || index >= bars.Count)
                return 0;

            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0)
                return 0;

            double open = bars.OpenPrices[index];
            double close = bars.ClosePrices[index];
            double high = bars.HighPrices[index];
            double low = bars.LowPrices[index];
            double range = high - low;
            double body = Math.Abs(close - open);
            double closeLocation = range > 0 ? (high - close) / range : 0.5;
            double ema = GetEma(bars, index, FastEma);
            double priorLow = LowestLow(bars, Math.Max(0, index - 6), index - 1);
            double priorBody = Math.Abs(
                bars.ClosePrices[index - 1] -
                bars.OpenPrices[index - 1]);

            int score = 0;
            double referencePrice = index == bars.Count - 1 ? Symbol.Bid : close;
            if (referencePrice < ema) score++;
            if (close < open && body >= atr * MinimumTriggerBodyAtr) score++;
            if (closeLocation >= MinimumCloseLocation) score++;
            if (close < bars.LowPrices[index - 1]) score++;
            if (close < priorLow) score++;
            if (body >= Math.Max(
                    atr * 0.12,
                    priorBody * 1.10)) score++;

            if (index == bars.Count - 1 &&
                Symbol.Bid <= bars.LowPrices[index - 1] - atr * EntryTriggerBufferAtr &&
                score < 6)
            {
                score = Math.Min(6, score + 1);
            }

            return Math.Min(6, score);
        }

        private bool HasFreshM5Trigger(Bars bars, int index, int direction)
        {
            if (bars == null || index < 20 || index >= bars.Count)
                return false;

            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0)
                return false;

            double range = bars.HighPrices[index] - bars.LowPrices[index];
            double body = Math.Abs(bars.ClosePrices[index] - bars.OpenPrices[index]);
            if (range <= 0 || range > atr * MaximumTriggerRangeAtr)
                return false;

            bool directional = direction == 1
                ? bars.ClosePrices[index] > bars.OpenPrices[index]
                : bars.ClosePrices[index] < bars.OpenPrices[index];
            if (!directional || body < atr * MinimumTriggerBodyAtr)
                return false;

            double location = direction == 1
                ? (bars.ClosePrices[index] - bars.LowPrices[index]) / range
                : (bars.HighPrices[index] - bars.ClosePrices[index]) / range;
            if (location < MinimumCloseLocation)
                return false;

            int evidence = 0;

            // A micro-break and a 6-bar range break are the same structural
            // family; count them once so one candle cannot fake two confirmations.
            bool rangeBreak = direction == 1
                ? bars.ClosePrices[index] > HighestHigh(bars, Math.Max(0, index - 6), index - 1)
                : bars.ClosePrices[index] < LowestLow(bars, Math.Max(0, index - 6), index - 1);
            bool microBreak = direction == 1
                ? bars.ClosePrices[index] > bars.HighPrices[index - 1]
                : bars.ClosePrices[index] < bars.LowPrices[index - 1];
            if (rangeBreak || microBreak) evidence++;

            bool reclaim = UseLiquiditySweep && (direction == 1
                ? HasBullLiquiditySweep(bars, index)
                : HasBearLiquiditySweep(bars, index));
            if (reclaim) evidence++;

            bool structural = UseMssChoch && (direction == 1
                ? HasBullMss(bars, index) || HasBullChoch(bars, index)
                : HasBearMss(bars, index) || HasBearChoch(bars, index));
            if (structural) evidence++;

            bool displacement = UseDisplacement && (direction == 1
                ? HasBullDisplacement(bars, index)
                : HasBearDisplacement(bars, index));
            if (displacement) evidence++;

            bool zoneRetest = (UseFvg && (direction == 1 ? HasBullFvg(bars, index) : HasBearFvg(bars, index))) ||
                              (UseOrderBlock && (direction == 1 ? HasBullOb(bars, index) : HasBearOb(bars, index)));
            if (zoneRetest) evidence++;

            return evidence >= Math.Max(1, MinimumFreshTriggerEvidence) &&
                   (rangeBreak || microBreak || structural || displacement || reclaim || zoneRetest);
        }

