            return s.Contains("CONFIRMED BUY") ||
                   s.Contains("CONFIRMED SELL") ||
                   s.Contains("HIGH-CONFIDENCE ENTRY") ||
                   s.Contains("TP1 HIT") ||
                   s.Contains("TP2 HIT") ||
