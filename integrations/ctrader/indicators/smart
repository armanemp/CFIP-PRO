        private int CalculateSmartDirectionalConfidence(int direction)
        {
            if (_smartDecision == null || direction == 0)
                return 0;

            double share = direction == 1
                ? _smartDecision.BuyShare
                : _smartDecision.SellShare;

            double evidence = direction == 1
                ? _smartDecision.BuyEvidence
                : _smartDecision.SellEvidence;

            // Evidence is a normalized count of independent decision families.
            // Keep it bounded and combine it with the directional evidence share.
            double evidenceCoverage =
                _smartDecision.EvidenceCoverage > 0
                    ? _smartDecision.EvidenceCoverage
                    : Clamp(
                        evidence / 6.0,
                        0,
                        1) * 100.0;

            double confidence =
                share * 0.65 +
                evidenceCoverage * 0.35;

            if (_smartDecision.Direction == direction)
                confidence += 3.0;

            return (int)Math.Round(
                Clamp(confidence, 0, 100));
        }

        private void CalculateDirectionalShares(
            int bullScore,
            int bearScore,
            out int buyShare,
            out int sellShare)
        {
            double bull = Math.Max(0, bullScore);
            double bear = Math.Max(0, bearScore);
            double total = bull + bear;

            if (total <= 0)
            {
                buyShare = 50;
                sellShare = 50;
                return;
            }

            buyShare = (int)Math.Round(
                100.0 * bull / total,
                MidpointRounding.AwayFromZero);

            buyShare = (int)Clamp(buyShare, 0, 100);
            sellShare = 100 - buyShare;
        }

        private int CalculateConfidence(
            int direction,
            int liveScore,
            Analysis m5,
            Analysis m15,
            Analysis m30,
            Analysis h1,
            Analysis h4)
        {
            double weighted = 0;
            double total = 0;

            AddConfidence(
                ref weighted,
                ref total,
                m5,
                direction,
                Math.Max(0, M5Weight) / (double)Math.Max(1, M5Weight + M15Weight + M30Weight + H1Weight + H4Weight));

            AddConfidence(
                ref weighted,
                ref total,
                m15,
                direction,
                Math.Max(0, M15Weight) / (double)Math.Max(1, M5Weight + M15Weight + M30Weight + H1Weight + H4Weight));

            AddConfidence(
                ref weighted,
                ref total,
                m30,
                direction,
                Math.Max(0, M30Weight) / (double)Math.Max(1, M5Weight + M15Weight + M30Weight + H1Weight + H4Weight));

            AddConfidence(
                ref weighted,
                ref total,
                h1,
                direction,
                Math.Max(0, H1Weight) / (double)Math.Max(1, M5Weight + M15Weight + M30Weight + H1Weight + H4Weight));

            AddConfidence(
                ref weighted,
                ref total,
                h4,
                direction,
                Math.Max(0, H4Weight) / (double)Math.Max(1, M5Weight + M15Weight + M30Weight + H1Weight + H4Weight));

            double analysis =
                total > 0
                    ? weighted / total
                    : 50;

            double live =
                liveScore *
                100.0 /
                6.0;

            double confidence =
                analysis * 0.80 +
                live * 0.20;

            if (m5 != null &&
                m15 != null &&
                m5.Direction == direction &&
                m15.Direction == direction)
            {
                confidence += 6;
            }

            if (m30 != null &&
                m30.Direction == direction)
                confidence += 2;

            if (h1 != null &&
                h1.Direction == direction)
                confidence += 2;

            if (h4 != null &&
                h4.Direction == direction)
                confidence += 1;

            if (m5 != null &&
                m5.Choppy)
                confidence -= 4;

            if (m15 != null &&
                m15.Choppy)
                confidence -= 5;

            if (h1 != null &&
                h1.Direction != 0 &&
                h1.Direction != direction)
            {
                confidence -=
                    HigherTfPenalty * 0.50;
            }

            if (h4 != null &&
                h4.Direction != 0 &&
                h4.Direction != direction)
            {
                confidence -=
                    HigherTfPenalty * 0.30;
            }

            if (m5 != null)
            {
                if (direction == 1 && m5.DisplacementBull) confidence += 2;
                if (direction == -1 && m5.DisplacementBear) confidence += 2;
                if (direction == 1 && m5.MssBull) confidence += 3;
                if (direction == -1 && m5.MssBear) confidence += 3;
                if (direction == 1 && m5.ChochBull) confidence += 2;
                if (direction == -1 && m5.ChochBear) confidence += 2;
                if (direction == 1 && m5.Discount) confidence += 2;
                if (direction == -1 && m5.Premium) confidence += 2;
            }

            if (m15 != null)
            {
                if (direction == 1 && m15.DisplacementBull) confidence += 2;
                if (direction == -1 && m15.DisplacementBear) confidence += 2;
                if (direction == 1 && m15.EqualLow) confidence += 1;
                if (direction == -1 && m15.EqualHigh) confidence += 1;
            }

            return
                (int)Math.Round(
                    (double)Clamp(
                        confidence,
                        0,
                        100));
        }

        private void AddConfidence(
            ref double weighted,
            ref double total,
            Analysis a,
            int direction,
            double weight)
        {
            if (a == null ||
                a.MaxScore <= 0)
                return;

            double net =
                direction == 1
                    ? a.BullScore - a.BearScore
                    : a.BearScore - a.BullScore;

            double value =
                50 +
                net /
                a.MaxScore *
                50;

            weighted +=
                Clamp(
                    value,
                    0,
                    100) *
                weight;

            total += weight;
        }

