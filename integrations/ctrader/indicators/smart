        // ============================================================

        private bool HasBullMss(Bars bars, int index)
        {
            int high = FindPreviousSwingHigh(bars, index, SwingStrength, 1);
            int low = FindPreviousSwingLow(bars, index, SwingStrength, 1);
            if (high < 0 || low < 0) return false;
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            double breakLevel = bars.HighPrices[high] + atr * Math.Max(0.0, StructureBreakAtr);
            return bars.ClosePrices[index] > breakLevel &&
                   bars.ClosePrices[index - 1] <= breakLevel;
        }

        private bool HasBearMss(Bars bars, int index)
        {
            int low = FindPreviousSwingLow(bars, index, SwingStrength, 1);
            int high = FindPreviousSwingHigh(bars, index, SwingStrength, 1);
            if (low < 0 || high < 0) return false;
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            double breakLevel = bars.LowPrices[low] - atr * Math.Max(0.0, StructureBreakAtr);
            return bars.ClosePrices[index] < breakLevel &&
                   bars.ClosePrices[index - 1] >= breakLevel;
        }

        private bool HasBullChoch(Bars bars, int index)
        {
            int low1 = FindPreviousSwingLow(bars, index, SwingStrength, 1);
            int low2 = FindPreviousSwingLow(bars, index, SwingStrength, 2);
            int high = FindPreviousSwingHigh(bars, index, SwingStrength, 1);
            if (low1 < 0 || low2 < 0 || high < 0) return false;
            bool priorBear = bars.LowPrices[low1] < bars.LowPrices[low2];
            return priorBear && bars.ClosePrices[index] > bars.HighPrices[high];
        }

        private bool HasBearChoch(Bars bars, int index)
        {
            int high1 = FindPreviousSwingHigh(bars, index, SwingStrength, 1);
            int high2 = FindPreviousSwingHigh(bars, index, SwingStrength, 2);
            int low = FindPreviousSwingLow(bars, index, SwingStrength, 1);
            if (high1 < 0 || high2 < 0 || low < 0) return false;
            bool priorBull = bars.HighPrices[high1] > bars.HighPrices[high2];
            return priorBull && bars.ClosePrices[index] < bars.LowPrices[low];
        }

        private bool HasBullDisplacement(Bars bars, int index)
        {
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            double range = bars.HighPrices[index] - bars.LowPrices[index];
            double body = Math.Abs(bars.ClosePrices[index] - bars.OpenPrices[index]);
            return bars.ClosePrices[index] > bars.OpenPrices[index] &&
                   range >= atr * DisplacementAtr &&
                   body >= atr * DisplacementAtr * 0.55 &&
                   CloseLocation(bars, index) >= 0.65;
        }

        private bool HasBearDisplacement(Bars bars, int index)
        {
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            double range = bars.HighPrices[index] - bars.LowPrices[index];
            double body = Math.Abs(bars.ClosePrices[index] - bars.OpenPrices[index]);
            return bars.ClosePrices[index] < bars.OpenPrices[index] &&
                   range >= atr * DisplacementAtr &&
                   body >= atr * DisplacementAtr * 0.55 &&
                   CloseLocation(bars, index) <= 0.35;
        }

        private bool HasEqualHigh(Bars bars, int index)
        {
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            int h1 = FindPreviousSwingHigh(bars, index, SwingStrength, 1);
            int h2 = FindPreviousSwingHigh(bars, index, SwingStrength, 2);
            return h1 >= 0 && h2 >= 0 &&
                   Math.Abs(bars.HighPrices[h1] - bars.HighPrices[h2]) <= atr * EqualLevelToleranceAtr;
        }

        private bool HasEqualLow(Bars bars, int index)
        {
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            int l1 = FindPreviousSwingLow(bars, index, SwingStrength, 1);
            int l2 = FindPreviousSwingLow(bars, index, SwingStrength, 2);
            return l1 >= 0 && l2 >= 0 &&
                   Math.Abs(bars.LowPrices[l1] - bars.LowPrices[l2]) <= atr * EqualLevelToleranceAtr;
        }

        private bool IsDiscount(Bars bars, int index)
        {
            int start = Math.Max(0, index - StructureLookback);
            double high = HighestHigh(bars, start, index);
            double low = LowestLow(bars, start, index);
            if (high <= low) return false;
            return bars.ClosePrices[index] <= low + (high - low) * 0.45;
        }

        private bool IsPremium(Bars bars, int index)
        {
            int start = Math.Max(0, index - StructureLookback);
            double high = HighestHigh(bars, start, index);
            double low = LowestLow(bars, start, index);
            if (high <= low) return false;
            return bars.ClosePrices[index] >= low + (high - low) * 0.55;
        }

        private double CloseLocation(Bars bars, int index)
        {
            double range = bars.HighPrices[index] - bars.LowPrices[index];
            if (range <= 0) return 0.5;
            return (bars.ClosePrices[index] - bars.LowPrices[index]) / range;
        }

        private bool IsRegimeNoTradeBlocked(out string reason)
        {
            reason = "";
            if (!UseRegimeNoTradeGuard || !EnableSmartDecisionEngine)
                return false;

            string regime = _smartRegime ?? "UNKNOWN";
            if (BlockCompressionRegime && regime == "COMPRESSION")
            {
                reason = "COMPRESSION REGIME";
                return true;
            }

            if (BlockWeakRangeTransition &&
                (regime == "RANGE" || regime == "TRANSITION") &&
                (_smartQuality < NoTradeMinimumSmartQuality || _smartDirection == 0))
            {
                reason = "WEAK " + regime + " | SMART Q " + _smartQuality;
                return true;
            }

            return false;
        }

        private bool IsNewsEventBlocked(
            DateTime time,
            Bars bars,
            int index,
            out string reason)
        {
            reason = "";
            if (!EnableNewsEventGuard)
                return false;

            if (IsInsideNewsWindow(time, NewsBlackoutWindowsUtc, out string window))
            {
                reason = "MANUAL NEWS WINDOW " + window;
                return true;
            }

            if (UseVolatilityEventGuard && bars != null && index >= 30)
            {
                double atr = GetAtr(bars, index, AtrPeriod);
                double oldAtr = GetAtr(bars, Math.Max(20, index - 8), AtrPeriod);
                double range = bars.HighPrices[index] - bars.LowPrices[index];

                bool rangeShock = atr > 0 && range >= atr * Math.Max(1.20, EventShockRangeAtr);
                bool atrShock = atr > 0 && oldAtr > 0 && atr >= oldAtr * Math.Max(1.05, EventShockAtrExpansion);

                if (rangeShock || atrShock)
                    _lastEventShockBar = index;

                if (_lastEventShockBar >= 0 &&
                    index - _lastEventShockBar <= Math.Max(0, EventGuardCooldownBars))
                {
                    reason = rangeShock || atrShock
                        ? "VOLATILITY EVENT SHOCK PROXY"
                        : "POST-EVENT COOLDOWN " + (index - _lastEventShockBar) + " BAR";
                    return true;
                }
            }

            return false;
        }

        private bool IsInsideNewsWindow(DateTime time, string windows, out string matched)
        {
            matched = "";
            if (string.IsNullOrWhiteSpace(windows))
                return false;

            string[] parts = windows.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
            int nowMinutes = time.Hour * 60 + time.Minute;

            foreach (string raw in parts)
            {
                string item = raw.Trim();
                string[] bounds = item.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries);
                if (bounds.Length != 2)
                    continue;

                if (!TryParseHourMinute(bounds[0].Trim(), out int start) ||
                    !TryParseHourMinute(bounds[1].Trim(), out int end))
                    continue;

                bool inside = start <= end
                    ? nowMinutes >= start && nowMinutes <= end
                    : nowMinutes >= start || nowMinutes <= end;

                if (inside)
                {
                    matched = item;
                    return true;
                }
            }

            return false;
        }

        private bool TryParseHourMinute(string value, out int minutes)
        {
            minutes = 0;
            string[] p = value.Split(new[] { ':' }, StringSplitOptions.RemoveEmptyEntries);
            if (p.Length != 2)
                return false;

            if (!int.TryParse(p[0], out int hour) || !int.TryParse(p[1], out int minute))
                return false;

            if (hour < 0 || hour > 23 || minute < 0 || minute > 59)
                return false;

            minutes = hour * 60 + minute;
            return true;
        }

        private bool IsSessionAllowed(DateTime time)
        {
            if (!UseSessionFilter) return true;
            int hour = time.Hour;
            if (SessionStartUtc <= SessionEndUtc)
                return hour >= SessionStartUtc && hour < SessionEndUtc;
            return hour >= SessionStartUtc || hour < SessionEndUtc;
        }

        private bool IsFridayAllowed(DateTime time)
        {
            if (!AvoidFridayLateEntry) return true;
            return time.DayOfWeek != DayOfWeek.Friday || time.Hour < FridayCutoffUtc;
        }

        private bool IsSpreadAllowed(Bars bars, int index)
        {
            if (!UseSpreadFilter) return true;
            double atr = GetAtr(bars, Math.Max(1, index - 1), AtrPeriod);
            if (atr <= 0) return true;
            return (Symbol.Ask - Symbol.Bid) <= atr * MaximumSpreadAtr;
        }

        private void BootstrapDirectionalBias(Analysis m5, Analysis m15, int m5ClosedIndex, int m5LiveIndex)
        {
            _bullStabilityCount = 0;
            _bearStabilityCount = 0;
            _lastDirectionalBias = 0;

            if (_m5 == null || m5 == null || m5ClosedIndex < 0)
            {
                _lastDirectionalBiasM5Bar = m5LiveIndex;
                return;
            }

            int required = RequireStableM5Direction ? Math.Max(1, StableM5Bars) : 1;
            int maximum = Math.Min(required, m5ClosedIndex + 1);

            for (int k = 0; k < maximum; k++)
            {
                int i = m5ClosedIndex - k;
                Analysis a = k == 0 ? m5 : GetCachedClosedAnalysis(_m5, i);
                if (a == null || a.Direction == 0)
                    break;

                if (a.Direction == 1)
                    _bullStabilityCount++;
                else if (a.Direction == -1)
                    _bearStabilityCount++;
            }

            int m15Direction = m15 != null ? m15.Direction : 0;
            bool allowBull = !RequireCoreAgreement ||
                             m15Direction == 1 ||
                             (AllowM15NeutralPullback && m15Direction == 0);
            bool allowBear = !RequireCoreAgreement ||
                             m15Direction == -1 ||
                             (AllowM15NeutralPullback && m15Direction == 0);

            if (_bullStabilityCount >= required && allowBull)
                _lastDirectionalBias = 1;
            else if (_bearStabilityCount >= required && allowBear)
                _lastDirectionalBias = -1;

            _lastDirectionalBiasM5Bar = m5LiveIndex;
        }

        private void UpdateDirectionalBias(Analysis m5, Analysis m15, int m5BarIndex)
        {
            // Calculate() runs on every tick in real time. Stability counters must
            // advance once per closed M5 decision bar, never once per tick.
            if (m5BarIndex == _lastDirectionalBiasM5Bar)
                return;

            int m5Direction = m5 != null ? m5.Direction : 0;
            int m15Direction = m15 != null ? m15.Direction : 0;

            if (m5Direction == 1)
            {
                _bullStabilityCount++;
                _bearStabilityCount = 0;
            }
            else if (m5Direction == -1)
            {
                _bearStabilityCount++;
                _bullStabilityCount = 0;
            }
            else
            {
                _bullStabilityCount = 0;
                _bearStabilityCount = 0;
            }

            int required = RequireStableM5Direction ? Math.Max(1, StableM5Bars) : 1;

            if (!PreventRapidDirectionFlip)
            {
                if (m5Direction == 1 && _bullStabilityCount >= required)
                    _lastDirectionalBias = 1;
                else if (m5Direction == -1 && _bearStabilityCount >= required)
                    _lastDirectionalBias = -1;
            }
            else if (_lastDirectionalBias == 0)
            {
                bool m15AllowsBull = !RequireCoreAgreement ||
                    m15Direction == 1 ||
                    (AllowM15NeutralPullback && m15Direction == 0);
                bool m15AllowsBear = !RequireCoreAgreement ||
                    m15Direction == -1 ||
                    (AllowM15NeutralPullback && m15Direction == 0);

                if (m5Direction == 1 && _bullStabilityCount >= required && m15AllowsBull)
                    _lastDirectionalBias = 1;
                else if (m5Direction == -1 && _bearStabilityCount >= required && m15AllowsBear)
                    _lastDirectionalBias = -1;
            }
            else if (_lastDirectionalBias == 1)
            {
                bool valid = m5Direction == 1 || (AllowM15NeutralPullback && m5Direction == 0);
                if (!valid && m5Direction == -1 && _bearStabilityCount >= required)
                {
                    bool m15Reversal = m15Direction == -1 && (m15.MssBear || m15.ChochBear) &&
                        (!RequireReversalForce || m15.DisplacementBear || m15.LiquidityBear);
                    if (m15Reversal && CanAcceptConfirmedDirection(-1, m5BarIndex, m5, m15, null, null, null))
                        _lastDirectionalBias = -1;
                }
            }
            else if (_lastDirectionalBias == -1)
            {
                bool valid = m5Direction == -1 || (AllowM15NeutralPullback && m5Direction == 0);
                if (!valid && m5Direction == 1 && _bullStabilityCount >= required)
                {
                    bool m15Reversal = m15Direction == 1 && (m15.MssBull || m15.ChochBull) &&
                        (!RequireReversalForce || m15.DisplacementBull || m15.LiquidityBull);
                    if (m15Reversal && CanAcceptConfirmedDirection(1, m5BarIndex, m5, m15, null, null, null))
                        _lastDirectionalBias = 1;
                }
            }

            _lastDirectionalBiasM5Bar = m5BarIndex;
        }

        private bool CanAcceptConfirmedDirection(
            int direction,
            int m5BarIndex,
            Analysis m5,
            Analysis m15,
            Analysis m30,
            Analysis h1,
            Analysis h4)
        {
            if (!PreventRapidDirectionFlip)
                return true;

            if (_lastConfirmedSignalDirection == 0 ||
                _lastConfirmedSignalM5Bar < 0)
                return true;

            int elapsed = m5BarIndex - _lastConfirmedSignalM5Bar;
            if (elapsed < 0)
                return false;

            if (direction == _lastConfirmedSignalDirection)
            {
                if (_signalActive)
                    return false;
                if (_lastExitM5Bar >= 0 && m5BarIndex - _lastExitM5Bar < Math.Max(0, ExitReentryCooldownM5))
                    return false;
                return true;
            }

            if (elapsed < Math.Max(1, OppositeSignalCooldownBars))
                return false;

            if (_signalActive && !AllowOppositeWhileActive)
                return false;

            if (RequireM15ReversalForOpposite)
            {
                if (m15 == null || m15.Direction != direction)
                    return false;

                bool m15Structural = direction == 1
                    ? (m15.MssBull || m15.ChochBull)
                    : (m15.MssBear || m15.ChochBear);
                bool m15Force = direction == 1
                    ? (m15.DisplacementBull || m15.LiquidityBull)
                    : (m15.DisplacementBear || m15.LiquidityBear);
                bool m15Reversal = RequireReversalForce
                    ? (m15Structural && m15Force)
                    : (m15Structural || m15Force);

                if (!m15Reversal)
                    return false;
            }

            int oppositeEvidence = 0;
            if (m5 != null)
            {
                if (direction == 1)
                {
                    if (m5.MssBull) oppositeEvidence++;
                    if (m5.ChochBull) oppositeEvidence++;
                    if (m5.DisplacementBull) oppositeEvidence++;
                    if (m5.LiquidityBull) oppositeEvidence++;
                }
                else
                {
                    if (m5.MssBear) oppositeEvidence++;
                    if (m5.ChochBear) oppositeEvidence++;
                    if (m5.DisplacementBear) oppositeEvidence++;
                    if (m5.LiquidityBear) oppositeEvidence++;
                }
            }

            if (oppositeEvidence < Math.Max(1, MinimumOppositeM5Structure))
                return false;

            if (m30 != null &&
                h1 != null &&
                m30.Direction != 0 &&
                h1.Direction != 0 &&
                m30.Direction == -direction &&
                h1.Direction == -direction)
                return false;

            if (h4 != null &&
                h4.Direction == -direction &&
                h1 != null &&
                h1.Direction == -direction)
                return false;

            return true;
        }

        private bool CanAcceptEarlyDirection(
            int direction,
            int m5BarIndex,
            Analysis m15,
            Analysis m30,
            Analysis h1,
            Analysis h4)
        {
            if (!PreventRapidDirectionFlip)
                return true;

            int previousDirection = _predictionDirection != 0
                ? _predictionDirection
                : (_lastEarlyBias != 0
                    ? _lastEarlyBias
                    : _lastConfirmedSignalDirection);

            int previousBar = _predictionDirection != 0
                ? _predictionBar
                : (_lastEarlyBiasM5Bar >= 0
                    ? _lastEarlyBiasM5Bar
                    : _lastConfirmedSignalM5Bar);

            if (previousDirection == 0 || previousBar < 0)
                return true;

            if (direction == previousDirection)
                return true;

            if (m5BarIndex - previousBar < Math.Max(1, OppositeSignalCooldownBars))
                return false;

            if (_signalActive && !AllowOppositeWhileActive)
                return false;

            if (m15 != null && m15.Direction == direction)
            {
                bool structural = direction == 1
                    ? (m15.MssBull || m15.ChochBull)
                    : (m15.MssBear || m15.ChochBear);
                bool force = direction == 1
                    ? (m15.DisplacementBull || m15.LiquidityBull)
                    : (m15.DisplacementBear || m15.LiquidityBear);
                bool reversal = RequireReversalForce
                    ? structural && force
                    : structural || force;
                if (reversal)
                    return true;
            }

            return false;
        }

        private bool IsCooldownAllowed(int m5BarIndex)
        {
            if (CooldownBars <= 0 || _lastSignalDecisionM5Bar < 0)
                return true;

            return m5BarIndex - _lastSignalDecisionM5Bar >= CooldownBars;
        }

