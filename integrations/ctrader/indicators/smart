        // ============================================================

        public override void Calculate(int index)
        {
            if (!IsLastBar)
                return;

            if (!IsSupportedTimeFrame())
                return;

            UpdateAlertPopupLifetime();

            if (_m5 == null || _m15 == null)
            {
                DrawStatus("CFIP MTF INTELLIGENCE\nLOADING M5/M15 MARKET DATA...");
                return;
            }

            if (Bars.Count < 30 || _m5.Count < 100 || _m15.Count < 100)
            {
                DrawStatus("CFIP MTF INTELLIGENCE\nBUILDING DATA: M5=" + _m5.Count + " M15=" + _m15.Count);
                return;
            }

            if (_bulkActionInProgress &&
                (DateTime.UtcNow - _bulkActionStartedUtc).TotalMilliseconds >= 1200)
            {
                _bulkActionInProgress = false;
            }

            ResetPendingDecisionAlerts();

            // Existing plan is checked first; a new plan is never allowed to
            // self-trigger an exit on its creation tick.
            MonitorActiveLevels();

            // Compute all decision layers before rendering any directional object.
            _suppressIntermediatePanelRender = true;
            EvaluateSmartDecision(index);
            EvaluateEngine(index);
            EvaluateLiveReaction(index);

            if (_signalActive && EnableLiveExitManagement)
                UpdateLiveExitPlan();

            if (_signalActive && AutoProtectBrokerPositions)
                UpdateBrokerPositionProtection();

            _suppressIntermediatePanelRender = false;

            // Exactly one owner renders the visible directional state.
            RenderSynchronizedPresentation(index);
            // Alerts follow the same priority as the visible state.
            FlushCoordinatedDecisionAlerts();

            ResolveAuthoritativeHeader();
            DrawUnifiedPanel();

            int currentM5Live = Math.Max(1, _m5.Count - 1);
            if (ShowHistorical && _lastHistoricalRenderM5Bar != currentM5Live)
            {
                DrawHistoricalSignals();
                _lastHistoricalRenderM5Bar = currentM5Live;
            }
            else if (!ShowHistorical && _lastHistoricalRenderM5Bar != -1)
            {
                ClearHistoricalObjects();
                _lastHistoricalRenderM5Bar = -1;
            }

            // FINAL authoritative paint pass. This deliberately runs after every
            // other renderer because DrawUnifiedPanel(), historical rendering,
            // reaction rendering, and state transitions may remove/replace chart
            // objects. The active confirmed plan must be the last owner of these
            // six object names on every tick.
            EnsureConfirmedPlanLines(index);
        }

        private void ResolveAuthoritativeHeader()
        {
            if (_signalActive && _signalDirection != 0)
            {
                SetEngineStateHeader(_signalDirection == 1 ? "BUY ACTIVE" : "SELL ACTIVE");
                return;
            }

            if (_liveReactionDirection != 0)
            {
                SetEngineStateHeader(_liveReactionDirection == 1 ? "BUY REACTION" : "SELL REACTION");
                return;
            }

            if (_predictionDirection != 0)
            {
                SetEngineStateHeader(_predictionDirection == 1 ? "BUY WATCH" : "SELL WATCH");
                return;
            }

            if (EnableSmartDecisionEngine && _smartQuality >= Math.Max(0, MinimumSmartQuality - 8))
            {
                if (_smartAction == "BUY WATCH" || (_smartDirection == 1 && _smartAction == "BUY"))
                {
                    SetEngineStateHeader("BUY SMART WATCH");
                    return;
                }
                if (_smartAction == "SELL WATCH" || (_smartDirection == -1 && _smartAction == "SELL"))
                {
                    SetEngineStateHeader("SELL SMART WATCH");
                    return;
                }
            }

            if (!string.IsNullOrWhiteSpace(_contextStatusText))
            {
                SetEngineStateHeader("CONTEXT");
                return;
            }

            if (_signalDirection != 0 && !string.IsNullOrWhiteSpace(_signalOutcome) && _signalOutcome != "ACTIVE")
            {
                SetEngineStateHeader(_signalOutcome);
                return;
            }

            SetEngineStateHeader("WAITING");
        }




