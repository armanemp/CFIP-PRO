        private string GetSmartExitMode()
        {
            if (!_signalActive ||
                _signalDirection == 0 ||
                _signalInitialRisk <= 0)
                return "NO ACTIVE EXIT PLAN";

            double market = _signalDirection == 1
                ? Symbol.Bid
                : Symbol.Ask;

            double currentRR = _signalDirection == 1
                ? (market - _signalEntry) / _signalInitialRisk
                : (_signalEntry - market) / _signalInitialRisk;

            double pressure =
                CalculateSmartExitPressure(
                    market,
                    currentRR);

            _smartExitPressure = pressure;

            if (pressure >= 82)
                return "EXIT RISK | PRESSURE " +
                       Math.Round(pressure).ToString();

            if (pressure >= SmartExitPressureThreshold)
                return "EXIT WATCH | PRESSURE " +
                       Math.Round(pressure).ToString();

            if (EnableDynamicSlTrail &&
                currentRR >= Math.Max(
                    SmartTrailMinimumRR,
                    TrailStartRR))
            {
                return "STRUCTURAL LOCK | PRESSURE " +
                       Math.Round(pressure).ToString();
            }

            if (MoveSlToBreakEven &&
                currentRR >= Math.Max(
                    0.20,
                    BreakEvenTriggerRR))
            {
                return "PROTECTED | PRESSURE " +
                       Math.Round(pressure).ToString();
            }

            return "STRUCTURAL HOLD | PRESSURE " +
                   Math.Round(pressure).ToString();
        }

        private string GetStablePanelHeader()
        {
            string candidate;

            if (_signalActive && _signalDirection != 0)
                candidate = _signalDirection == 1 ? "BUY ACTIVE" : "SELL ACTIVE";
            else if (_liveReactionDirection != 0)
                candidate = _liveReactionDirection == 1 ? "BUY REACTION" : "SELL REACTION";
            else if (_predictionDirection != 0)
                candidate = _predictionDirection == 1 ? "BUY WATCH" : "SELL WATCH";
            else if (EnableSmartDecisionEngine && _smartQuality >= Math.Max(0, MinimumSmartQuality - 8))
            {
                if (_smartAction == "BUY WATCH" || (_smartDirection == 1 && _smartAction == "BUY"))
                    candidate = "BUY SMART WATCH";
                else if (_smartAction == "SELL WATCH" || (_smartDirection == -1 && _smartAction == "SELL"))
                    candidate = "SELL SMART WATCH";
                else
                    candidate = "WAITING";
            }
            else if (!string.IsNullOrWhiteSpace(_contextStatusText))
                candidate = "CONTEXT";
            else if (_signalDirection != 0 && !string.IsNullOrWhiteSpace(_signalOutcome) && _signalOutcome != "ACTIVE")
                candidate = _signalOutcome;
            else
                candidate = "WAITING";

            DateTime now = DateTime.UtcNow;
            if (string.IsNullOrWhiteSpace(_panelStableHeader))
            {
                _panelStableHeader = candidate;
                _panelStableHeaderSinceUtc = now;
                return _panelStableHeader;
            }

            if (string.Equals(candidate, _panelStableHeader, StringComparison.Ordinal))
                return _panelStableHeader;

            // Confirmed ACTIVE/terminal states are authoritative immediately.
            bool authoritative = _signalActive || candidate == "CONTEXT" ||
                                 (!string.IsNullOrWhiteSpace(_signalOutcome) && _signalOutcome != "ACTIVE" &&
                                  candidate == _signalOutcome);
            double heldSeconds = (now - _panelStableHeaderSinceUtc).TotalSeconds;
            if (authoritative || PanelStateHoldSeconds <= 0 || heldSeconds >= PanelStateHoldSeconds)
            {
                _panelStableHeader = candidate;
                _panelStableHeaderSinceUtc = now;
            }

            return _panelStableHeader;
        }

        private void DrawUnifiedPanel()
        {
            if (_suppressIntermediatePanelRender)
                return;

            bool showStatus =
                ShowEngineStatus &&
                !string.IsNullOrWhiteSpace(_engineStatusText);

            bool showPlan =
                ShowTradePlanPanel &&
                _signalDirection != 0 &&
                (_signalActive ||
                 (!string.IsNullOrWhiteSpace(_signalOutcome) &&
                  _signalOutcome != "ACTIVE"));

            bool showEarly =
                EnableEarlyPrediction &&
                _predictionDirection != 0 &&
                !_signalActive &&
                _liveReactionDirection == 0;

            bool showReaction =
                EnableLiveReaction &&
                _liveReactionDirection != 0 &&
                (!_signalActive ||
                 _liveReactionDirection != _signalDirection);

            bool showContext =
                ShowContextEventMarker &&
                !string.IsNullOrWhiteSpace(_contextStatusText);

            bool showButtons = ShowTradePlanPanel && ShowTradeActionButtons;

            if (!showStatus &&
                !showPlan &&
                !showEarly &&
                !showReaction &&
                !showContext &&
                string.IsNullOrWhiteSpace(_tradeActionStatusText) &&
                (!EnableSmartDecisionEngine || _smartDecision == null))
            {
                RemoveTradePlanPanel();
                return;
            }

            VerticalAlignment vertical;
            HorizontalAlignment horizontal;

            switch (TradePlanPosition)
            {
                case CFIPPanelCorner.TopLeft:
                    vertical = VerticalAlignment.Top;
                    horizontal = HorizontalAlignment.Left;
                    break;

                case CFIPPanelCorner.TopRight:
                    vertical = VerticalAlignment.Top;
                    horizontal = HorizontalAlignment.Right;
                    break;

                case CFIPPanelCorner.BottomRight:
                    vertical = VerticalAlignment.Bottom;
                    horizontal = HorizontalAlignment.Right;
                    break;

                default:
                    vertical = VerticalAlignment.Bottom;
                    horizontal = HorizontalAlignment.Left;
                    break;
            }

            List<string> lines = new List<string>();

            // The panel is intentionally divided into stable semantic sections.
            // The header is held briefly so fast intrabar transitions do not make
            // the entire box appear to flicker between WAITING/WATCH/REACTION.
            string stableHeader = GetStablePanelHeader();

            if (showStatus)
            {
                lines.Add("STATUS");
                lines.Add(stableHeader);

                string statusText = _engineStatusText ?? "";
                string[] statusParts =
                    statusText.Split(
                        new[] { '\r', '\n' },
                        StringSplitOptions.RemoveEmptyEntries);

                for (int i = 0; i < statusParts.Length; i++)
                {
                    string detail = statusParts[i].Trim();

                    if (string.IsNullOrWhiteSpace(detail))
                        continue;

                    if (detail.StartsWith(
                            "CFIP MTF INTELLIGENCE",
                            StringComparison.OrdinalIgnoreCase))
                        continue;

                    if (string.Equals(
                            detail,
                            stableHeader,
                            StringComparison.OrdinalIgnoreCase))
                        continue;

                    lines.Add(detail);
                }
            }

            if (showPlan)
            {
                lines.Add("");
                lines.Add("TRADE PLAN");
                string directionText =
                    _signalDirection == 1 ? "BUY" : "SELL";

                double planRR =
                    _signalInitialRisk > 0 && _signalTp1 > 0
                        ? Math.Abs(_signalTp1 - _signalEntry) /
                          _signalInitialRisk
