            _signalTp2Source = EnableSmartDecisionEngine ? "STRUCTURE" : "RR FALLBACK";
            _signalTp3Source = EnableSmartDecisionEngine ? "STRUCTURE" : "RR FALLBACK";
            _signalTp4Source = EnableSmartDecisionEngine ? "STRUCTURE" : "RR FALLBACK";

