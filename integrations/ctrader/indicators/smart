        // ============================================================
        // FVG
        // ============================================================

        private bool HasBullFvg(
            Bars bars,
            int index)
        {
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0 || index < 3)
                return false;

            int start = Math.Max(2, index - FvgLookback);

            for (int i = index - 1; i >= start; i--)
            {
                double gap = bars.LowPrices[i] - bars.HighPrices[i - 2];
                if (gap < atr * MinimumFvgAtr || index - i > MaximumZoneAgeBars)
                    continue;

                double zoneLow = bars.HighPrices[i - 2];
                double zoneHigh = bars.LowPrices[i];
                bool invalidated = false;

                // A bullish FVG is no longer actionable after a closed candle
                // closes below the lower edge. Do not resurrect broken gaps.
for (int j = i + 1; j <= index; j++)
                {
                    if (bars.ClosePrices[j] < zoneLow)
                    {
                        invalidated = true;
                        break;
                    }
                }

                if (invalidated)
                    continue;

                bool currentRetest =
                    bars.LowPrices[index] <= zoneHigh &&
                    bars.HighPrices[index] >= zoneLow;

                if (RequireFvgRetest && !currentRetest)
                    continue;

                if (!RequireFvgRetest || currentRetest)
                    return true;
            }

            return false;
        }

