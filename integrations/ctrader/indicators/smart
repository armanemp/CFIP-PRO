        private void DrawHistoricalSignals()
        {
            ClearHistoricalObjects();

            int drawn = 0;

            int last =
                Bars.Count - 2;

            for (int i = last;
                 i >= 50 &&
                 drawn < HistoricalSignalLimit;
                 i--)
            {
                DateTime time =
                    Bars.OpenTimes[i];

                int m5Index =
                    GetLastClosedIndexBefore(
                        _m5,
                        time);

                int m15Index =
                    GetLastClosedIndexBefore(
                        _m15,
                        time);

                if (m5Index < 50 ||
                    m15Index < 50)
                    continue;

                Analysis m5 =
                    GetClosedAnalysis(
                        _m5,
                        m5Index);

                Analysis m15 =
                    GetClosedAnalysis(
                        _m15,
                        m15Index);

                if (m5 == null ||
                    m15 == null ||
                    m5.Direction == 0 ||
                    m15.Direction == 0 ||
                    m5.Direction !=
                    m15.Direction)
                    continue;

                int direction =
                    m5.Direction;

                int live =
                    direction == 1
                        ? HistoricalBullTriggerScore(i)
                        : HistoricalBearTriggerScore(i);

                if (live <
                    LiveTriggerScore)
                    continue;

                int confidence =
                    CalculateConfidence(
                        direction,
                        live,
                        m5,
                        m15,
                        null,
                        null,
                        null);

                if (confidence <
                    MinimumConfidence)
                    continue;

                DrawHistoricalSignal(
                    i,
                    direction,
                    confidence);

                drawn++;
            }
        }

        private int HistoricalBullTriggerScore(
            int index)
        {
            // Historical bars are closed. Reuse the exact live trigger scorer.
            return LiveBullTriggerScore(Bars, index);
        }

        private int HistoricalBearTriggerScore(
            int index)
        {
            // Historical bars are closed. Reuse the exact live trigger scorer.
            return LiveBearTriggerScore(Bars, index);
        }

        private void DrawHistoricalSignal(
            int index,
            int direction,
            int confidence)
        {
            string suffix =
                "_" + index;

            Color color =
                direction == 1
                    ? ConfirmedBuyArrowColor
                    : ConfirmedSellArrowColor;

            double atr = GetAtr(Bars, Math.Max(1, Math.Min(index, Bars.Count - 1)), AtrPeriod);
            double arrowOffset = atr > 0
                ? Math.Max(atr * Math.Max(0.05, ArrowOffsetAtr),
                    Symbol.PipSize * Math.Max(1.0, MinimumArrowOffsetPips))
                : Symbol.PipSize * Math.Max(1.0, MinimumArrowOffsetPips);

            double price =
                direction == 1
                    ? Bars.LowPrices[index] - arrowOffset
                    : Bars.HighPrices[index] + arrowOffset;

            if (ShowHistoricalArrows)
            {
                Chart.DrawIcon(
                    HistoricalPrefix +
                    "ARROW" +
                    suffix,
                    direction == 1
                        ? ChartIconType.UpArrow
                        : ChartIconType.DownArrow,
                    index,
                    price,
                    color);
            }

            _historicalDrawnIndices.Add(index);
        }

        private bool HasStableSimpleDirection(Bars bars, int index, int direction, int requiredBars)
        {
            if (bars == null || index < 20 || index >= bars.Count)
                return false;

            int count = Math.Max(1, requiredBars);
            for (int k = 0; k < count; k++)
            {
                int i = index - k;
                if (i < 10) return false;

                double fast = GetEma(bars, i, FastEma);
                double slow = GetEma(bars, i, SlowEma);
                double rsi = GetRsi(bars, i, RsiPeriod);
                double dmi = GetDmiBias(bars, i, AdxPeriod);
                bool bull = bars.ClosePrices[i] > fast && fast >= slow && rsi >= 50 && dmi >= 0;
                bool bear = bars.ClosePrices[i] < fast && fast <= slow && rsi <= 50 && dmi <= 0;

                if ((direction == 1 && !bull) || (direction == -1 && !bear))
                    return false;
            }

            return true;
        }

        private DateTime GetClosedBarReferenceTime(Bars bars, int closedIndex)
        {
            if (bars == null || bars.Count == 0)
                return DateTime.MinValue;

            int i = Math.Max(0, Math.Min(closedIndex, bars.Count - 1));
            TimeSpan span;
            if (i + 1 < bars.Count)
                span = bars.OpenTimes[i + 1] - bars.OpenTimes[i];
            else if (i > 0)
                span = bars.OpenTimes[i] - bars.OpenTimes[i - 1];
            else
                span = TimeSpan.FromMinutes(1);

            if (span <= TimeSpan.Zero)
                span = TimeSpan.FromMinutes(1);

            return bars.OpenTimes[i] + span;
        }

        // ============================================================
        // INDEX
        // ============================================================

        private int GetLastClosedIndexBefore(
            Bars bars,
            DateTime referenceTime)
        {
            if (bars == null || bars.Count < 2)
                return -1;

            int probe = bars.OpenTimes.GetIndexByTime(referenceTime);
            if (probe < 0)
                probe = bars.Count - 1;

            probe = Math.Max(0, Math.Min(probe, bars.Count - 1));

            // A bar contributes to an HTF decision only after its full duration
            // has elapsed. This avoids using a currently forming M15/H1/H4 bar.
            for (int i = probe; i >= 0; i--)
            {
                TimeSpan span;
                if (i + 1 < bars.Count)
                    span = bars.OpenTimes[i + 1] - bars.OpenTimes[i];
                else if (i > 0)
                    span = bars.OpenTimes[i] - bars.OpenTimes[i - 1];
                else
                    span = TimeSpan.FromMinutes(1);

                if (span <= TimeSpan.Zero)
                    span = TimeSpan.FromMinutes(1);

                if (bars.OpenTimes[i] + span <= referenceTime)
                    return i;
            }

            return -1;
        }

        // ============================================================
        // HIGHEST / LOWEST
        // ============================================================

        private double HighestHigh(
            Bars bars,
            int start,
            int end)
        {
            if (bars == null ||
                bars.Count == 0)
                return 0;

            start =
                Math.Max(
                    0,
                    start);

            end =
                Math.Min(
                    bars.Count - 1,
                    end);

            if (start > end)
                return bars.HighPrices[
                    Math.Max(
                        0,
                        end)];

            double highest =
                double.MinValue;

            for (int i = start;
                 i <= end;
                 i++)
            {
                if (bars.HighPrices[i] >
                    highest)
                {
                    highest =
                        bars.HighPrices[i];
                }
            }

            return highest;
        }

        private double LowestLow(
            Bars bars,
            int start,
            int end)
        {
            if (bars == null ||
                bars.Count == 0)
                return 0;

            start =
                Math.Max(
                    0,
                    start);

            end =
                Math.Min(
                    bars.Count - 1,
                    end);

            if (start > end)
                return bars.LowPrices[
                    Math.Max(
                        0,
                        end)];

            double lowest =
                double.MaxValue;

            for (int i = start;
                 i <= end;
                 i++)
            {
                if (bars.LowPrices[i] <
                    lowest)
                {
                    lowest =
                        bars.LowPrices[i];
                }
            }

            return lowest;
        }

