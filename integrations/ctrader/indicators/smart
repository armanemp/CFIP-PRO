        private void ApplyTargetMetadata(            List<SmartLevel> candidates,
            double target,
            ref string source,
            ref int quality,
            double atr)
        {            SmartLevel level =
                FindClosestSmartLevel(
                    candidates,
                    target,
                    atr);

            if (level == null)
                return;

            source =
                FormatSmartLevelSource(level);

            quality =
                (int)Math.Round(
                    Clamp(level.Score, 0, 100));
        }

        private SmartLevel FindClosestSmartLevel(
            List<SmartLevel> candidates,
            double price,
            double atr)
        {
            if (candidates == null ||
                candidates.Count == 0 ||
                price <= 0 ||
                atr <= 0)
                return null;

            double tolerance =
                Math.Max(
                    Symbol.PipSize * 4.0,
                    atr * Math.Max(0.05, SmartLevelClusterAtr * 1.5));

            SmartLevel best = null;
            double bestDistance = double.MaxValue;

            foreach (SmartLevel candidate in candidates)
            {
                if (candidate == null ||
                    candidate.Price <= 0)
                    continue;

                double distance =
                    Math.Abs(
                        candidate.Price - price);

                if (distance > tolerance)
                    continue;

                if (distance < bestDistance - Symbol.PipSize * 0.25 ||
                    (
                        Math.Abs(distance - bestDistance) <= Symbol.PipSize * 0.25 &&
                        (best == null || candidate.Score > best.Score)
                    ))
                {
                    best = candidate;
                    bestDistance = distance;
                }
            }

            return best;
        }

        private string FormatSmartLevelSource(
            SmartLevel level)
        {
            if (level == null)
                return "STRUCTURE";

            string source =
                string.IsNullOrWhiteSpace(level.SourceTimeframe)
                    ? ""
                    : level.SourceTimeframe;

            string kind =
                string.IsNullOrWhiteSpace(level.Kind)
                    ? "STRUCTURE"
                    : level.Kind;

            if (!string.IsNullOrWhiteSpace(source))
                return kind + "·" + source;

            return kind;
        }

        private bool TryAdvanceLiveTargets(double atr, int closedIndex, double market)
        {
            if (!_signalActive ||
                !EnableSmartDecisionEngine ||
                atr <= 0 ||
                _signalDirection == 0)
                return false;

            int liveBar = _m5 != null ? Math.Max(1, _m5.Count - 1) : closedIndex;
            double refreshDistance = Math.Max(Symbol.PipSize * 4.0, atr * Math.Max(0.05, TargetUpdateStepAtr));
            if (_lastSmartTargetCalcM5Bar == liveBar &&
                Math.Abs(market - _lastSmartTargetCalcPrice) < refreshDistance)
                return false;

            _lastSmartTargetCalcM5Bar = liveBar;
            _lastSmartTargetCalcPrice = market;

            double old1 = _signalTp1;
            double old2 = _signalTp2;
            double old3 = _signalTp3;
            double old4 = _signalTp4;

            List<SmartLevel> candidates = BuildSmartTargetCandidates(_m5, closedIndex, _signalDirection, market, atr);
            if (candidates.Count == 0)
                return false;

            // Never move a target backward and never synthesize a target from market +/- step.
            List<double> selected = SelectSmartTargetSequence(
                candidates,
                market,
                _signalInitialRisk,
                _signalDirection,
                atr,
                true);

            if (_signalDirection == 1)
            {
                if (!_tp1Alerted && selected.Count > 0 && (_signalTp1 <= 0 || selected[0] > _signalTp1))
                    _signalTp1 = NormalizePrice(selected[0]);
                if (!_tp2Alerted && selected.Count > 1 && (_signalTp2 <= 0 || selected[1] > Math.Max(_signalTp2, _signalTp1)))
                    _signalTp2 = NormalizePrice(selected[1]);
                if (!_tp3Alerted && selected.Count > 2 && (_signalTp3 <= 0 || selected[2] > Math.Max(_signalTp3, _signalTp2)))
                    _signalTp3 = NormalizePrice(selected[2]);
                if (!_tp4Alerted && selected.Count > 3 && (_signalTp4 <= 0 || selected[3] > Math.Max(_signalTp4, _signalTp3 > 0 ? _signalTp3 : _signalTp2)))
                    _signalTp4 = NormalizePrice(selected[3]);
            }
            else
            {
                if (!_tp1Alerted && selected.Count > 0 && (_signalTp1 <= 0 || selected[0] < _signalTp1))
                    _signalTp1 = NormalizePrice(selected[0]);
                if (!_tp2Alerted && selected.Count > 1 && (_signalTp2 <= 0 || selected[1] < Math.Min(_signalTp2, _signalTp1)))
                    _signalTp2 = NormalizePrice(selected[1]);
                if (!_tp3Alerted && selected.Count > 2 && (_signalTp3 <= 0 || selected[2] < Math.Min(_signalTp3, _signalTp2)))
                    _signalTp3 = NormalizePrice(selected[2]);
                if (!_tp4Alerted && selected.Count > 3 && (_signalTp4 <= 0 || selected[3] < Math.Min(_signalTp4, _signalTp3 > 0 ? _signalTp3 : _signalTp2)))
                    _signalTp4 = NormalizePrice(selected[3]);
            }

            double liveEntry = _signalEntry;
            double liveSl = _signalSl;
            double liveTp1 = _signalTp1;
            double liveTp2 = _signalTp2;
            double liveTp3 = _signalTp3;
            double liveTp4 = _signalTp4;

            if (!NormalizeAndValidatePlanLevels(
                    _signalDirection,
                    ref liveEntry,
                    ref liveSl,
                    ref liveTp1,
                    ref liveTp2,
                    ref liveTp3,
                    ref liveTp4))
            {
                _signalTp1 = old1;
                _signalTp2 = old2;
                _signalTp3 = old3;
                _signalTp4 = old4;
                return false;
            }

            _signalEntry = liveEntry;
            _signalSl = liveSl;
            _signalTp1 = liveTp1;
            _signalTp2 = liveTp2;
            _signalTp3 = liveTp3;
            _signalTp4 = liveTp4;

            bool changed =
                Math.Abs(_signalTp1 - old1) > Symbol.PipSize * 0.5 ||
                Math.Abs(_signalTp2 - old2) > Symbol.PipSize * 0.5 ||
                Math.Abs(_signalTp3 - old3) > Symbol.PipSize * 0.5 ||
                Math.Abs(_signalTp4 - old4) > Symbol.PipSize * 0.5;

            if (changed)
                RefreshSignalLevelMetadata(_m5, closedIndex);

            return changed;
        }

        private double FindNearestStructuralSwingAbove(Bars bars, int index, double price)
        {
            if (bars == null || index < 10 || index >= bars.Count)
                return 0;
            int last = index - Math.Max(1, SwingStrength);
            int first = Math.Max(SwingStrength, index - Math.Max(60, LiquidityLookback * 2));
            double best = double.MaxValue;
            for (int i = first; i <= last; i++)
            {
                double h = bars.HighPrices[i];
                if (h <= price) continue;
                bool swing = true;
                for (int j = 1; j <= SwingStrength; j++)
                {
                    if (i - j < 0 || i + j > index || h <= bars.HighPrices[i - j] || h <= bars.HighPrices[i + j])
                    { swing = false; break; }
                }
                if (swing && h < best) best = h;
            }
            return best == double.MaxValue ? 0 : NormalizePrice(best);
        }

        private double FindNearestStructuralSwingBelow(Bars bars, int index, double price)
        {
            if (bars == null || index < 10 || index >= bars.Count)
                return 0;
            int last = index - Math.Max(1, SwingStrength);
            int first = Math.Max(SwingStrength, index - Math.Max(60, LiquidityLookback * 2));
            double best = double.MinValue;
            for (int i = first; i <= last; i++)
            {
                double l = bars.LowPrices[i];
                if (l >= price) continue;
                bool swing = true;
                for (int j = 1; j <= SwingStrength; j++)
                {
                    if (i - j < 0 || i + j > index || l >= bars.LowPrices[i - j] || l >= bars.LowPrices[i + j])
                    { swing = false; break; }
                }
                if (swing && l > best) best = l;
            }
            return best == double.MinValue ? 0 : NormalizePrice(best);
        }

        private bool NormalizeAndValidatePlanLevels(
            int direction,
            ref double entry,
            ref double sl,
            ref double tp1,
            ref double tp2,
            ref double tp3,
            ref double tp4)
        {
            if (direction != 1 && direction != -1)
                return false;

            entry = NormalizePrice(entry);
            sl = NormalizePrice(sl);
            tp1 = NormalizePrice(tp1);
            tp2 = NormalizePrice(tp2);
            tp3 = tp3 > 0 ? NormalizePrice(tp3) : 0;
            tp4 = tp4 > 0 ? NormalizePrice(tp4) : 0;

            if (!IsFinitePositive(entry) || !IsFinitePositive(sl) ||
                !IsFinitePositive(tp1) || !IsFinitePositive(tp2))
                return false;

            double minStep = Math.Max(Symbol.TickSize, Symbol.PipSize * 0.10);

            if (direction == 1)
            {
                if (!(sl < entry && entry < tp1 && tp1 < tp2))
                    return false;
                if (tp3 > 0 && tp3 <= tp2 + minStep) tp3 = 0;
                if (tp4 > 0 && (tp3 <= 0 || tp4 <= tp3 + minStep)) tp4 = 0;
            }
            else
            {
                if (!(sl > entry && entry > tp1 && tp1 > tp2))
                    return false;
                if (tp3 > 0 && tp3 >= tp2 - minStep) tp3 = 0;
                if (tp4 > 0 && (tp3 <= 0 || tp4 >= tp3 - minStep)) tp4 = 0;
            }

            return true;
        }

        private bool IsFinitePositive(double value)
        {
            return value > 0.0 && !double.IsNaN(value) && !double.IsInfinity(value);
        }

