        private bool HasBullStructure(
            Bars bars,
            int index)
        {
            int h1 =
                FindPreviousSwingHigh(
                    bars,
                    index,
                    SwingStrength,
                    1);

            int h2 =
                FindPreviousSwingHigh(
                    bars,
                    index,
                    SwingStrength,
                    2);

            int l1 =
                FindPreviousSwingLow(
                    bars,
                    index,
                    SwingStrength,
                    1);

            int l2 =
                FindPreviousSwingLow(
                    bars,
                    index,
                    SwingStrength,
                    2);

            bool hh =
                h1 >= 0 &&
                h2 >= 0 &&
                bars.HighPrices[h1] >
                bars.HighPrices[h2];

            bool hl =
                l1 >= 0 &&
                l2 >= 0 &&
                bars.LowPrices[l1] >
                bars.LowPrices[l2];

            double atr = GetAtr(bars, index, AtrPeriod);
            bool bos =
                h1 >= 0 &&
                bars.ClosePrices[index] >
                bars.HighPrices[h1] + atr * StructureBreakAtr;

            return (hh && hl) || bos;
        }

        private bool HasBearStructure(
            Bars bars,
            int index)
        {
            int h1 =
                FindPreviousSwingHigh(
                    bars,
                    index,                    SwingStrength,
                    1);

            int h2 =
                FindPreviousSwingHigh(
                    bars,
                    index,
                    SwingStrength,
                    2);

            int l1 =
                FindPreviousSwingLow(
                    bars,
                    index,
                    SwingStrength,
                    1);

            int l2 =
                FindPreviousSwingLow(
                    bars,
                    index,
                    SwingStrength,
                    2);

            bool lh =
                h1 >= 0 &&
                h2 >= 0 &&
                bars.HighPrices[h1] <
                bars.HighPrices[h2];

            bool ll =
                l1 >= 0 &&
                l2 >= 0 &&
                bars.LowPrices[l1] <
                bars.LowPrices[l2];

            double atr = GetAtr(bars, index, AtrPeriod);
            bool bos =
                l1 >= 0 &&
                bars.ClosePrices[index] <
                bars.LowPrices[l1] - atr * StructureBreakAtr;

            return (lh && ll) || bos;
        }

        private int FindPreviousSwingHigh(
            Bars bars,
            int index,
            int strength,
            int occurrence)
        {
            int found = 0;

            int start =
                Math.Min(
                    index - strength - 1,
                    bars.Count -
                    strength - 1);

            for (int i = start;
                 i >= strength;
                 i--)
            {
                bool swing = true;

                for (int j = 1;
                     j <= strength;
                     j++)
                {
                    if (bars.HighPrices[i] <=
                        bars.HighPrices[i - j] ||
                        bars.HighPrices[i] <=
                        bars.HighPrices[i + j])
                    {
                        swing = false;
                        break;
                    }
                }

                if (!swing)
                    continue;

                found++;

                if (found == occurrence)
                    return i;
            }

            return -1;
        }

        private int FindPreviousSwingLow(
            Bars bars,
            int index,
            int strength,
            int occurrence)
        {
            int found = 0;

            int start =
                Math.Min(
                    index - strength - 1,
                    bars.Count -
                    strength - 1);

            for (int i = start;
                 i >= strength;
                 i--)
            {
                bool swing = true;

                for (int j = 1;
                     j <= strength;
                     j++)
                {
                    if (bars.LowPrices[i] >=
                        bars.LowPrices[i - j] ||
                        bars.LowPrices[i] >=
                        bars.LowPrices[i + j])
                    {
                        swing = false;
                        break;
                    }
                }

                if (!swing)
                    continue;

                found++;

                if (found == occurrence)
                    return i;
            }

            return -1;
        }

