        private void EvaluateEarlyPrediction(
            int chartIndex,
            int m5LiveIndex,
            int m5ClosedIndex,
            Analysis m5,
            Analysis m15,
            Analysis m30,
            Analysis h1,
            Analysis h4)
        {
            Prediction p =
                BuildPrediction(
                    chartIndex,
                    m5ClosedIndex,
                    m5,
                    m15,
                    m30,
                    h1,
                    h4);

            if (p.Direction != 0 &&
                !CanAcceptEarlyDirection(
                    p.Direction,
                    m5LiveIndex,
                    m15,
                    m30,
                    h1,
                    h4))
            {
                p = new Prediction();
            }

            if (p.Direction == 0 ||
                p.Confidence < SetupConfidence)
            {
                _predictionBar = m5LiveIndex;
                _predictionDirection = 0;
                _predictionConfidence = 0;
                ClearEarlyObjects();
                return;
            }

            _lastEarlyBias = p.Direction;
            _lastEarlyBiasM5Bar = m5LiveIndex;
            _predictionBar = m5LiveIndex;
            _predictionDirection = p.Direction;
            _predictionConfidence = p.Confidence;
            _predictionEntry = p.Entry;
            _predictionStopLoss = p.StopLoss;
            _predictionZoneLow = p.ZoneLow;
            _predictionZoneHigh = p.ZoneHigh;
            _predictionTarget1 = p.Target1;
            _predictionTarget2 = p.Target2;
            _predictionTarget3 = p.Target3;
            _predictionTarget4 = p.Target4;
            _predictionTrigger = p.Trigger;

            // Presentation is intentionally deferred to RenderSynchronizedPresentation().
            // The decision layer only updates state; it never owns chart objects.
        }

        // ============================================================
        // PREDICTION ENGINE
        // ============================================================

        private Prediction BuildPrediction(
            int chartIndex,
            int m5ClosedIndex,
            Analysis m5,
            Analysis m15,
            Analysis m30,
            Analysis h1,
            Analysis h4)
        {
            Prediction p = new Prediction();

            Bars executionBars = _m5 ?? Bars;
            int executionIndex = executionBars == _m5
                ? m5ClosedIndex
                : Math.Max(1, chartIndex - 1);

            if (executionBars == null ||
                executionIndex < 30 ||
                executionIndex >= executionBars.Count)
                return p;

            double atr = GetAtr(
                executionBars,
                executionIndex,
                AtrPeriod);

            if (!IsFinitePositive(atr))
                return p;

            int direction = 0;
            int confidence = 0;

            if (EnableSmartDecisionEngine &&
                _smartDecision != null)
            {
                int minimumShare =
                    Math.Max(
                        52,
                        MinimumSmartDirectionShare - 3);

                if (_smartDirection != 0 &&
                    _smartQuality >=
                        Math.Max(
                            MinimumEarlyConfidence,
                            SetupConfidence) &&
                    (
                        _smartDirection == 1
                            ? _smartBuyShare
                            : _smartSellShare
                    ) >= minimumShare)
                {
                    direction = _smartDirection;
                    confidence = _smartQuality;
                }
            }
            else
            {
                // Compatibility path only when Smart Decision is disabled.
                // This is intentionally a small directional fallback rather than
                // a second full prediction engine.
                int bull = 0;
                int bear = 0;

                AddFallbackDirectionWeight(m5, 32, ref bull, ref bear);
                AddFallbackDirectionWeight(m15, 28, ref bull, ref bear);
                AddFallbackDirectionWeight(m30, 18, ref bull, ref bear);
                AddFallbackDirectionWeight(h1, 14, ref bull, ref bear);
                AddFallbackDirectionWeight(h4, 8, ref bull, ref bear);

                int liveBull = LiveBullTriggerScore(
                    executionBars,
                    executionIndex);

                int liveBear = LiveBearTriggerScore(
                    executionBars,
                    executionIndex);

                bull += liveBull * 2;
                bear += liveBear * 2;

                if (bull >= 35 && bull >= bear + 8)
                    direction = 1;
                else if (bear >= 35 && bear >= bull + 8)
                    direction = -1;

                double total = Math.Max(1, bull + bear);
                double share = 100.0 *
                    Math.Max(bull, bear) /
                    total;

                confidence = (int)Math.Round(
                    Clamp(share, 0, 100));
            }

            if (direction == 0)
                return p;

            p.Direction = direction;
            p.Confidence = confidence;

            double entry = NormalizePrice(
                direction == 1
                    ? Symbol.Ask
                    : Symbol.Bid);

            if (!IsFinitePositive(entry))
                return new Prediction();

            p.Entry = entry;

            Zone selectedZone =
                direction == 1
                    ? FindNearestBullishZone(
                        executionBars,
                        executionIndex)
                    : FindNearestBearishZone(
                        executionBars,
                        executionIndex);

            if (selectedZone != null)
            {
                p.ZoneLow = NormalizePrice(
                    Math.Min(
                        selectedZone.Low,
                        selectedZone.High));

                p.ZoneHigh = NormalizePrice(
                    Math.Max(
                        selectedZone.Low,
                        selectedZone.High));
            }
            else
            {
                // A watch zone is allowed to be approximate, but execution SL/TP
                // are never approximate: those come from the structural exit engine.
                p.ZoneLow = NormalizePrice(
                    direction == 1
                        ? entry - atr * 0.20
                        : entry - atr * 0.10);

                p.ZoneHigh = NormalizePrice(
                    direction == 1
                        ? entry + atr * 0.10
                        : entry + atr * 0.20);
            }

            int previousEnd =
                Math.Max(
                    0,
                    executionIndex - 1);

            double previousHigh =
                HighestHigh(
                    executionBars,
                    Math.Max(
                        0,
                        previousEnd - LiquidityLookback + 1),
                    previousEnd);

            double previousLow =
                LowestLow(
                    executionBars,
                    Math.Max(
                        0,
                        previousEnd - LiquidityLookback + 1),
                    previousEnd);

            p.Trigger = NormalizePrice(
                direction == 1
                    ? previousHigh
                    : previousLow);

            if (direction == 1 &&
                (p.Trigger <= p.Entry || p.Trigger > p.Entry + atr * 2.0))
            {
                double localBreak =
                    FindNearestSwingAbove(
                        executionBars,
                        executionIndex,
                        p.Entry + atr * 0.02);

                p.Trigger = NormalizePrice(
                    localBreak > p.Entry
                        ? localBreak
                        : p.Entry + atr * 0.25);
            }
            else if (direction == -1 &&
                     (p.Trigger >= p.Entry || p.Trigger < p.Entry - atr * 2.0))
            {
                double localBreak =
                    FindNearestSwingBelow(
                        executionBars,
                        executionIndex,
                        p.Entry - atr * 0.02);

                p.Trigger = NormalizePrice(
                    localBreak > 0 && localBreak < p.Entry
                        ? localBreak
                        : p.Entry - atr * 0.25);
            }

            double structuralSl;
            double structuralTp1;
            double structuralTp2;
            double structuralTp3;
            double structuralTp4;

            bool riskBuilt = EnableSmartDecisionEngine
                ? TryBuildSmartRiskPlan(
                    executionBars,
                    executionIndex,
                    direction,
                    p.Entry,
                    out structuralSl,
                    out structuralTp1,
                    out structuralTp2,
                    out structuralTp3,
                    out structuralTp4)
                : TryBuildFallbackRiskPlan(
                    executionBars,
                    executionIndex,
                    direction,
                    p.Entry,
                    out structuralSl,
                    out structuralTp1,
                    out structuralTp2,
                    out structuralTp3,
                    out structuralTp4);

            if (!riskBuilt)
                return new Prediction();

            p.StopLoss = NormalizePrice(structuralSl);
            p.Target1 = NormalizePrice(structuralTp1);
            p.Target2 = NormalizePrice(structuralTp2);
            p.Target3 = structuralTp3 > 0
                ? NormalizePrice(structuralTp3)
                : 0;
            p.Target4 = structuralTp4 > 0
                ? NormalizePrice(structuralTp4)
                : 0;

            if (direction == 1 &&
                !(p.StopLoss < p.Entry &&
                  p.Entry < p.Target1 &&
                  p.Target1 < p.Target2))
                return new Prediction();

            if (direction == -1 &&
                !(p.StopLoss > p.Entry &&
                  p.Entry > p.Target1 &&
                  p.Target1 > p.Target2))
                return new Prediction();

            return p;
        }

        private void AddFallbackDirectionWeight(
            Analysis analysis,
            int weight,
            ref int bull,
            ref int bear)
        {
            if (analysis == null || weight <= 0)
                return;

            if (analysis.Direction == 1)
                bull += weight;
            else if (analysis.Direction == -1)
                bear += weight;

            if (analysis.MssBull || analysis.ChochBull)
                bull += Math.Max(1, weight / 3);

            if (analysis.MssBear || analysis.ChochBear)
                bear += Math.Max(1, weight / 3);

            if (analysis.DisplacementBull)
                bull += Math.Max(1, weight / 5);

            if (analysis.DisplacementBear)
                bear += Math.Max(1, weight / 5);

            if (analysis.LiquidityBull)
                bull += Math.Max(1, weight / 6);

            if (analysis.LiquidityBear)
                bear += Math.Max(1, weight / 6);
        }

        // ============================================================
        // PREDICTION ANALYSIS
        // ============================================================

        // ============================================================
        // PREDICTIVE ZONES
        // ============================================================

        private Zone FindNearestBullishZone(
            Bars bars,
            int index)
        {
            if (bars == null || bars.Count < 30)
                return null;

            int currentIndex = Math.Max(2, Math.Min(index, bars.Count - 1));
            double atr = GetAtr(bars, currentIndex, AtrPeriod);
            if (atr <= 0)
                return null;

            double price = Symbol.Ask;
            Zone best = null;
            double bestScore = double.MaxValue;
            int lookback = Math.Max(FvgLookback, ObLookback);
            int start = Math.Max(2, currentIndex - lookback);

            for (int i = currentIndex - 1; i >= start; i--)
            {
                int age = currentIndex - i;
                if (age > MaximumZoneAgeBars)
                    continue;

                // ----------------------------------------------------
                // Bullish FVG: gap[i] = Low[i] - High[i-2].
                // Reject if a later CLOSED candle closed below the gap.
                // ----------------------------------------------------
                if (UseFvg && i >= 2)
                {
                    double gap = bars.LowPrices[i] - bars.HighPrices[i - 2];
                    if (gap >= atr * MinimumFvgAtr)
                    {
                        double zoneLow = bars.HighPrices[i - 2];
                        double zoneHigh = bars.LowPrices[i];
                        bool invalidated = false;
                        bool previouslyRetested = false;

                        for (int j = i + 1; j <= currentIndex; j++)
                        {
                            if (bars.ClosePrices[j] < zoneLow)
                            {
                                invalidated = true;
                                break;
                            }

                            if (j < currentIndex &&
                                bars.LowPrices[j] <= zoneHigh &&
                                bars.HighPrices[j] >= zoneLow)
                            {
                                previouslyRetested = true;
                            }
                        }

                        bool currentTouch =
                            bars.LowPrices[currentIndex] <= zoneHigh &&
                            bars.HighPrices[currentIndex] >= zoneLow;

                        bool retestOk = !RequireFvgRetest || currentTouch || previouslyRetested;

                        if (!invalidated && retestOk)
                        {
                            double distance = Math.Abs(price - (zoneLow + zoneHigh) * 0.5);
                            double sidePenalty = price < zoneLow ? (zoneLow - price) / atr : 0.0;
                            double score = distance / atr + sidePenalty * 0.5;

                            if (score < bestScore)
                            {
                                bestScore = score;
                                best = new Zone { Low = zoneLow, High = zoneHigh };
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Bullish OB: last bearish candle before bullish impulse.
                // Reject if subsequently closed below its low.
                // ----------------------------------------------------
                if (UseOrderBlock && i + 1 < bars.Count && bars.ClosePrices[i] < bars.OpenPrices[i])
                {
                    double impulseBody = Math.Abs(bars.ClosePrices[i + 1] - bars.OpenPrices[i + 1]);
                    bool displaced =
                        bars.ClosePrices[i + 1] > bars.HighPrices[i] &&
                        (!RequireObDisplacement || impulseBody >= atr * ObDisplacementAtr);

                    if (displaced)
                    {
                        double zoneLow = bars.LowPrices[i];
                        double zoneHigh = bars.HighPrices[i];
                        bool invalidated = false;

                        for (int j = i + 2; j <= currentIndex; j++)
                        {
                            if (bars.ClosePrices[j] < zoneLow)
                            {
                                invalidated = true;
                                break;
                            }                        }

                        bool currentTouch =
                            bars.LowPrices[currentIndex] <= zoneHigh &&
                            bars.HighPrices[currentIndex] >= zoneLow;

                        if (!invalidated && currentTouch)
                        {
                            double distance = Math.Abs(price - (zoneLow + zoneHigh) * 0.5);
                            double score = distance / atr + 0.10;

                            if (score < bestScore)
                            {
                                bestScore = score;
                                best = new Zone { Low = zoneLow, High = zoneHigh };
                            }
                        }
                    }
                }
            }

            return best;
        }

        private Zone FindNearestBearishZone(
            Bars bars,
            int index)
        {
            if (bars == null || bars.Count < 30)
                return null;

            int currentIndex = Math.Max(2, Math.Min(index, bars.Count - 1));
            double atr = GetAtr(bars, currentIndex, AtrPeriod);
            if (atr <= 0)
                return null;

            double price = Symbol.Bid;
            Zone best = null;
            double bestScore = double.MaxValue;
            int lookback = Math.Max(FvgLookback, ObLookback);
            int start = Math.Max(2, currentIndex - lookback);

            for (int i = currentIndex - 1; i >= start; i--)
            {
                int age = currentIndex - i;
                if (age > MaximumZoneAgeBars)
                    continue;

                // ----------------------------------------------------
                // Bearish FVG: gap[i] = Low[i-2] - High[i].
                // Reject if a later CLOSED candle closed above the gap.
                // ----------------------------------------------------
                if (UseFvg && i >= 2)
                {
                    double gap = bars.LowPrices[i - 2] - bars.HighPrices[i];
                    if (gap >= atr * MinimumFvgAtr)
                    {
                        double zoneLow = bars.HighPrices[i];
                        double zoneHigh = bars.LowPrices[i - 2];
                        bool invalidated = false;
                        bool previouslyRetested = false;

                        for (int j = i + 1; j <= currentIndex; j++)
                        {
                            if (bars.ClosePrices[j] > zoneHigh)
                            {
                                invalidated = true;
                                break;
                            }

                            if (j < currentIndex &&
                                bars.HighPrices[j] >= zoneLow &&
                                bars.LowPrices[j] <= zoneHigh)
                            {
                                previouslyRetested = true;
                            }
                        }

                        bool currentTouch =
                            bars.HighPrices[currentIndex] >= zoneLow &&
                            bars.LowPrices[currentIndex] <= zoneHigh;

                        bool retestOk = !RequireFvgRetest || currentTouch || previouslyRetested;

                        if (!invalidated && retestOk)
                        {
                            double distance = Math.Abs(price - (zoneLow + zoneHigh) * 0.5);
                            double sidePenalty = price > zoneHigh ? (price - zoneHigh) / atr : 0.0;
                            double score = distance / atr + sidePenalty * 0.5;

                            if (score < bestScore)
                            {
                                bestScore = score;
                                best = new Zone { Low = zoneLow, High = zoneHigh };
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Bearish OB: last bullish candle before bearish impulse.
                // Reject if subsequently closed above its high.
                // ----------------------------------------------------
                if (UseOrderBlock && i + 1 < bars.Count && bars.ClosePrices[i] > bars.OpenPrices[i])
                {
                    double impulseBody = Math.Abs(bars.ClosePrices[i + 1] - bars.OpenPrices[i + 1]);
                    bool displaced =
                        bars.ClosePrices[i + 1] < bars.LowPrices[i] &&
                        (!RequireObDisplacement || impulseBody >= atr * ObDisplacementAtr);

                    if (displaced)
                    {
                        double zoneLow = bars.LowPrices[i];
                        double zoneHigh = bars.HighPrices[i];
                        bool invalidated = false;

                        for (int j = i + 2; j <= currentIndex; j++)
                        {
                            if (bars.ClosePrices[j] > zoneHigh)
                            {
                                invalidated = true;
                                break;
                            }
                        }

                        bool currentTouch =
                            bars.HighPrices[currentIndex] >= zoneLow &&
                            bars.LowPrices[currentIndex] <= zoneHigh;

                        if (!invalidated && currentTouch)
                        {
                            double distance = Math.Abs(price - (zoneLow + zoneHigh) * 0.5);
                            double score = distance / atr + 0.10;

                            if (score < bestScore)
                            {
                                bestScore = score;
                                best = new Zone { Low = zoneLow, High = zoneHigh };
                            }
                        }
                    }
                }
            }

            return best;
        }

