private void UpdateBrokerPositionProtection()
        {
            if (!_signalActive || !AutoProtectBrokerPositions || _signalDirection == 0)
                return;
            if ((DateTime.UtcNow - _lastBrokerModifyUtc).TotalMilliseconds < Math.Max(100, BrokerModifyCooldownMs))
                return;

            double brokerSl = _signalSl;
            double brokerTp = GetNextBrokerTarget();
            bool any = false;

            foreach (Position position in Positions)
            {
                if (position == null || position.SymbolName != SymbolName)
                    continue;
                if ((_signalDirection == 1 && position.TradeType != TradeType.Buy) ||
                    (_signalDirection == -1 && position.TradeType != TradeType.Sell))
                    continue;
                if (!string.IsNullOrWhiteSpace(ManagedPositionLabel) && position.Label != ManagedPositionLabel)
                    continue;

                bool improveSl = !position.StopLoss.HasValue ||
                    (_signalDirection == 1 ? brokerSl > position.StopLoss.Value : brokerSl < position.StopLoss.Value);
                bool improveTp = SyncBrokerTakeProfit && brokerTp > 0 &&
                    (!position.TakeProfit.HasValue ||
                     (PreventBrokerTpBackwardMove
                        ? (_signalDirection == 1 ? brokerTp > position.TakeProfit.Value : brokerTp < position.TakeProfit.Value)
                        : true));

                if (!improveSl && !improveTp)
                    continue;

                double? newTp = position.TakeProfit;
                if (improveTp) newTp = brokerTp;
                double? newSl = improveSl ? brokerSl : position.StopLoss;

                try
                {
                    ModifyPositionAsync(position, newSl, newTp);
                    any = true;
                }
                catch (Exception ex)
                {
                    Print("CFIP broker protection failed: {0}", ex.Message);
                }
            }

            if (any)
                _lastBrokerModifyUtc = DateTime.UtcNow;
        }

