        // ============================================================
        // ADVANCED MARKET CONFLUENCE
        // ============================================================

        private bool HasVolumeExpansion(Bars bars, int index, int direction)
        {
            if (index < 25) return false;
            double avg = 0;
            int count = 0;
            for (int i = index - 20; i < index; i++) { avg += bars.TickVolumes[i]; count++; }
            if (count == 0 || avg <= 0) return false;
            avg /= count;
            double current = bars.TickVolumes[index];
            bool directional = direction == 1 ? bars.ClosePrices[index] > bars.OpenPrices[index] : bars.ClosePrices[index] < bars.OpenPrices[index];
            return directional && current >= avg * 1.15;
        }

        private bool HasMacdBias(Bars bars, int index, int direction)
        {
            if (index < 35) return false;
            double fast = GetEma(bars, index, 12);
            double slow = GetEma(bars, index, 26);
            double hist = fast - slow;
            double prev = GetEma(bars, index - 2, 12) - GetEma(bars, index - 2, 26);
            return direction == 1 ? hist > 0 && hist >= prev : hist < 0 && hist <= prev;
        }

        private bool HasVwapBias(Bars bars, int index, int direction)
        {
            if (index < 20) return false;
            int start = Math.Max(0, index - 47);
            double pv = 0;
            double vol = 0;
            for (int i = start; i <= index; i++)
            {
                double typical = (bars.HighPrices[i] + bars.LowPrices[i] + bars.ClosePrices[i]) / 3.0;
                double v = Math.Max(1.0, bars.TickVolumes[i]);
                pv += typical * v;
                vol += v;
            }
            if (vol <= 0) return false;
            double vwap = pv / vol;
            return direction == 1 ? bars.ClosePrices[index] > vwap : bars.ClosePrices[index] < vwap;
        }

        private bool HasHealthyVolatility(Bars bars, int index, int direction)
        {
            if (index < 30) return false;
            double atr = GetAtr(bars, index, AtrPeriod);
            double oldAtr = GetAtr(bars, index - 10, AtrPeriod);
            if (atr <= 0 || oldAtr <= 0) return false;
            double body = Math.Abs(bars.ClosePrices[index] - bars.OpenPrices[index]);
            bool directional = direction == 1 ? bars.ClosePrices[index] > bars.OpenPrices[index] : bars.ClosePrices[index] < bars.OpenPrices[index];
            return directional && body >= atr * 0.12 && atr >= oldAtr * 0.85 && atr <= oldAtr * 1.80;
        }

