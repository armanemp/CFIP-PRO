        // ============================================================

        private bool HasBullMomentum(
            Bars bars,
            int index,
            double atr)
        {
            if (index <= 0)
                return false;

            double body =
                bars.ClosePrices[index] -
                bars.OpenPrices[index];

            return body >= atr * 0.12 &&
                   bars.ClosePrices[index] >
                   bars.ClosePrices[index - 1];
        }

        private bool HasBearMomentum(
            Bars bars,
            int index,
            double atr)
        {
            if (index <= 0)
                return false;

            double body =
                bars.OpenPrices[index] -
                bars.ClosePrices[index];

            return body >= atr * 0.12 &&
                   bars.ClosePrices[index] <
                   bars.ClosePrices[index - 1];
        }

        private bool HasBullRejection(
            Bars bars,
            int index)
        {
            if (index < 0 ||
                index >= bars.Count)
                return false;

            double body =
                Math.Abs(
                    bars.ClosePrices[index] -
                    bars.OpenPrices[index]);

            double wick =
                Math.Min(
                    bars.OpenPrices[index],
                    bars.ClosePrices[index]) -
                bars.LowPrices[index];

            double location = (bars.ClosePrices[index] - bars.LowPrices[index]) /
                               Math.Max(Symbol.PipSize, bars.HighPrices[index] - bars.LowPrices[index]);

            return wick >=
                   Math.Max(
                       body * 0.7,
                       Symbol.PipSize * 2) &&
                   location >= 0.58 &&
                   bars.ClosePrices[index] >= bars.LowPrices[index] +
                   (bars.HighPrices[index] - bars.LowPrices[index]) * 0.50;
        }

        private bool HasBearRejection(
            Bars bars,
            int index)
        {
            if (index < 0 ||
                index >= bars.Count)
                return false;

            double body =
                Math.Abs(
                    bars.ClosePrices[index] -
                    bars.OpenPrices[index]);

            double wick =
                bars.HighPrices[index] -
                Math.Max(
                    bars.OpenPrices[index],
                    bars.ClosePrices[index]);

            double location = (bars.HighPrices[index] - bars.ClosePrices[index]) /
                               Math.Max(Symbol.PipSize, bars.HighPrices[index] - bars.LowPrices[index]);

            return wick >=
                   Math.Max(
                       body * 0.7,
                       Symbol.PipSize * 2) &&
                   location >= 0.58 &&
                   bars.ClosePrices[index] <= bars.HighPrices[index] -
                   (bars.HighPrices[index] - bars.LowPrices[index]) * 0.50;
        }

        // ============================================================
        // CHOPPY
        // ============================================================

        private bool IsChoppy(
            Bars bars,
            int index)
        {
            double atr =
                GetAtr(
                    bars,
                    index,
                    AtrPeriod);

            if (atr <= 0)
                return true;

            double fast =
                GetEma(
                    bars,
                    index,
                    FastEma);

            double slow =
                GetEma(
                    bars,                    index,
                    SlowEma);

            double adx =
                GetAdx(
                    bars,
                    index,
                    AdxPeriod);

            return adx < AdxMinimum &&
                   Math.Abs(
                       fast - slow) <
                   atr * 0.35;
        }

