        private Analysis Analyze(
            Bars bars,
            int index)
        {
            Analysis a =
                new Analysis();

            double atr =
                GetAtr(
                    bars,
                    index,
                    AtrPeriod);

            if (atr <= 0)
                return a;

            if (UseInternalStructure && HasBullStructure(
                bars,
                index))
            {
                a.StructureBull = true;
                a.BullScore += 20;
            }

            if (UseInternalStructure && HasBearStructure(
                bars,
                index))
            {
                a.StructureBear = true;
                a.BearScore += 20;
            }

            if (UseLiquiditySweep && HasBullLiquiditySweep(
                bars,
                index))
            {
                a.LiquidityBull = true;
                a.BullScore += 15;
            }

            if (UseLiquiditySweep && HasBearLiquiditySweep(
                bars,
                index))
            {
                a.LiquidityBear = true;
                a.BearScore += 15;
            }

            if (UseFvg && HasBullFvg(bars, index))
            {
                a.FvgBull = true;
                a.BullScore += 10;
            }

            if (UseFvg && HasBearFvg(bars, index))
            {
                a.FvgBear = true;
                a.BearScore += 10;
            }

            if (UseOrderBlock && HasBullOb(bars, index))
            {
                a.ObBull = true;
                a.BullScore += 10;
            }

            if (UseOrderBlock && HasBearOb(bars, index))
            {
                a.ObBear = true;
                a.BearScore += 10;
            }

            double fast =
                GetEma(
                    bars,
                    index,
                    FastEma);

            double slow =
                GetEma(
                    bars,
                    index,
                    SlowEma);

            if (fast > slow &&
                bars.ClosePrices[index] > fast)
            {
                a.TrendBull = true;
                a.BullScore += 10;
            }

            if (fast < slow &&
                bars.ClosePrices[index] < fast)
            {
                a.TrendBear = true;
                a.BearScore += 10;
            }

            double rsi =
                GetRsi(
                    bars,
                    index,
                    RsiPeriod);

            if (rsi >= 55)
                a.BullScore += 5;

            if (rsi <= 45)
                a.BearScore += 5;

            double dmi =
                GetDmiBias(
                    bars,
                    index,
                    AdxPeriod);

            double adx =
                GetAdx(
                    bars,
                    index,
                    AdxPeriod);

            if (adx >= AdxMinimum)
            {
                if (dmi > 0)
                {
                    a.BullScore += 5;
                    a.TrendBull = true;
                }

                if (dmi < 0)
                {
                    a.BearScore += 5;
                    a.TrendBear = true;
                }
            }

            if (HasBullMomentum(
                bars,
                index,
                atr))
            {
                a.MomentumBull = true;
                a.BullScore += 8;
            }

            if (HasBearMomentum(
                bars,
                index,
                atr))
            {
                a.MomentumBear = true;
                a.BearScore += 8;
            }

            if (HasBullRejection(
                bars,
                index))
            {
                a.RejectionBull = true;
                a.BullScore += 7;
            }

            if (HasBearRejection(
                bars,
                index))
            {
                a.RejectionBear = true;
                a.BearScore += 7;
            }

            if (UseMssChoch)
            {
                a.MssBull = HasBullMss(bars, index);
                a.MssBear = HasBearMss(bars, index);
                a.ChochBull = HasBullChoch(bars, index);
                a.ChochBear = HasBearChoch(bars, index);

                if (a.MssBull) a.BullScore += 8;
                if (a.MssBear) a.BearScore += 8;
                if (a.ChochBull) a.BullScore += 7;
                if (a.ChochBear) a.BearScore += 7;
            }

            if (UseDisplacement)
            {
                a.DisplacementBull = HasBullDisplacement(bars, index);
                a.DisplacementBear = HasBearDisplacement(bars, index);

                if (a.DisplacementBull) a.BullScore += 6;
                if (a.DisplacementBear) a.BearScore += 6;
            }

            if (UseEqualHighLow)
            {
                a.EqualHigh = HasEqualHigh(bars, index);
                a.EqualLow = HasEqualLow(bars, index);

                if (a.EqualLow) a.BullScore += 4;
                if (a.EqualHigh) a.BearScore += 4;
            }

            if (UsePremiumDiscount)
            {
                a.Discount = IsDiscount(bars, index);
                a.Premium = IsPremium(bars, index);

                if (a.Discount) a.BullScore += 4;
                if (a.Premium) a.BearScore += 4;
            }

            // Advanced confluence: optional volume/MACD/VWAP/volatility evidence.
            // These are supporting evidence only and cannot create a signal alone.
            if (UseAdvancedConfluence)
            {
                a.VolumeBull = HasVolumeExpansion(bars, index, 1);
                a.VolumeBear = HasVolumeExpansion(bars, index, -1);
                a.MacdBull = HasMacdBias(bars, index, 1);
                a.MacdBear = HasMacdBias(bars, index, -1);
                a.VwapBull = HasVwapBias(bars, index, 1);
                a.VwapBear = HasVwapBias(bars, index, -1);
                a.VolatilityBull = HasHealthyVolatility(bars, index, 1);
                a.VolatilityBear = HasHealthyVolatility(bars, index, -1);

                if (a.VolumeBull) a.BullScore += 3;
                if (a.VolumeBear) a.BearScore += 3;
                if (a.MacdBull) a.BullScore += 3;
                if (a.MacdBear) a.BearScore += 3;
                if (a.VwapBull) a.BullScore += 2;
                if (a.VwapBear) a.BearScore += 2;
                if (a.VolatilityBull) a.BullScore += 2;
                if (a.VolatilityBear) a.BearScore += 2;
            }

            a.MaxScore =
                (UseInternalStructure ? 20 : 0) +
                (UseLiquiditySweep ? 15 : 0) +
                (UseFvg ? 10 : 0) +
                (UseOrderBlock ? 10 : 0) +
                10 +
                5 +
                5 +
                8 +
                7 +
                (UseMssChoch ? 15 : 0) +
                (UseDisplacement ? 6 : 0) +
                (UseEqualHighLow ? 4 : 0) +
                (UsePremiumDiscount ? 4 : 0) +
                (UseAdvancedConfluence ? 10 : 0);

            if (a.BullScore >= 45 &&
                a.BullScore >
                a.BearScore + 6)
            {
                a.Direction = 1;
            }
            else if (a.BearScore >= 45 &&
                     a.BearScore >
                     a.BullScore + 6)
            {
                a.Direction = -1;
            }
            else
            {
                a.Direction = 0;
            }

            a.Choppy =
                IsChoppy(
                    bars,
                    index);

            return a;
        }

