        private void SendRestrictionAlert(string message, int eventBar = -1)
        {
            if (string.IsNullOrWhiteSpace(message))
                return;

            bool newsGuard =
                message.StartsWith("NEWS / EVENT GUARD", StringComparison.OrdinalIgnoreCase);

            bool allowRestrictionAlert =
                newsGuard
                    ? AlertOnNewsEventGuard
                    : AlertOnEntryRestriction || ShowEntryRestrictionPopup;

            if (!allowRestrictionAlert)
                return;

            if (!TryAcceptAlert(
                newsGuard ? "NEWS_GUARD" : "RESTRICTION",
                message,
                0,
                eventBar,
                newsGuard
                    ? "NEWS_GUARD"
                    : "RESTRICTION"))
                return;

            if (EnableSoundAlerts &&
                (newsGuard || AlertOnEntryRestriction))
            {
                try
                {
                    if (!string.IsNullOrWhiteSpace(SoundFilePath))
                        Notifications.PlaySound(SoundFilePath);
                    else
                        Notifications.PlaySound(SoundType.Announcement);
                }
                catch (Exception ex)
                {
                    Print("CFIP restriction sound alert failed: {0}", ex.Message);
                }
            }

            if (ShowPopupAlert &&
                (newsGuard || ShowEntryRestrictionPopup))
            {
                try
                {
                    ShowInternalAlertPopup(
                        newsGuard
                            ? "CFIP MTF NEWS / EVENT GUARD"
                            : "CFIP MTF ENTRY BLOCKED",
                        message,
                        PopupNotificationState.Information);
                }
                catch (Exception ex)
                {
                    Print("CFIP restriction popup alert failed: {0}", ex.Message);
                }
            }

            if (EnableEmailAlerts &&
                (newsGuard || AlertOnEntryRestriction) &&
                !string.IsNullOrWhiteSpace(SenderEmail) &&
                !string.IsNullOrWhiteSpace(ReceiverEmail))
            {
                try
                {
                    Notifications.SendEmail(
                        SenderEmail,
                        ReceiverEmail,
                        newsGuard
                            ? "CFIP MTF News / Event Guard"
                            : "CFIP MTF Restriction / No-Trade Alert",
                        message);
                }
                catch (Exception ex)
                {
                    Print("CFIP restriction email alert failed: {0}", ex.Message);
                }
            }
        }

