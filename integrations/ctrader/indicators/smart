            RegisterNativeIndicators(_d1);
            RegisterNativeIndicators(_w1);

            if (Bars != null && FindNativeIndicatorSet(Bars) == null)
                RegisterNativeIndicators(Bars);
        }

        private NativeIndicatorSet FindNativeIndicatorSet(Bars bars)
        {
            if (bars == null)
                return null;

            for (int i = 0; i < _nativeIndicators.Count; i++)
            {
                NativeIndicatorSet set = _nativeIndicators[i];

                if (set != null &&
                    object.ReferenceEquals(set.Bars, bars))
                    return set;
            }

            return null;
        }

        private NativeIndicatorSet RegisterNativeIndicators(Bars bars)
        {
            if (bars == null)
                return null;

            NativeIndicatorSet existing =
                FindNativeIndicatorSet(bars);

            if (existing != null)
                return existing;

            try
            {
                NativeIndicatorSet set =
                    new NativeIndicatorSet
                    {
                        Bars = bars
                    };

                int[] emaPeriods =
                {
                    FastEma,
                    SlowEma,
                    12,
                    26
                };

                for (int i = 0; i < emaPeriods.Length; i++)
                {
                    int period = emaPeriods[i];

                    if (period > 1 &&
                        !set.Emas.ContainsKey(period))
                    {
                        set.Emas[period] =
                            Indicators.ExponentialMovingAverage(
                                bars.ClosePrices,
                                period);
                    }
                }

                if (AtrPeriod >= 2)
                {
                    set.Atr =
                        Indicators.AverageTrueRange(
                            bars,
                            AtrPeriod,
                            MovingAverageType.WilderSmoothing);
                }

                if (RsiPeriod >= 2)
                {
                    set.Rsi =
                        Indicators.RelativeStrengthIndex(
                            bars.ClosePrices,
                            RsiPeriod);
                }

                if (AdxPeriod >= 2)
                {
                    set.Dms =
                        Indicators.DirectionalMovementSystem(
                            bars,
                            AdxPeriod,
                            MovingAverageType.WilderSmoothing);
                }

                _nativeIndicators.Add(set);
                return set;
            }
            catch (Exception ex)
            {
                Print(
                    "CFIP native indicator initialization failed for {0}: {1}",
                    bars.TimeFrame,
                    ex.Message);
                return null;
            }
        }

        private NativeIndicatorSet GetNativeIndicatorSet(Bars bars)
        {
            NativeIndicatorSet set =
                FindNativeIndicatorSet(bars);

            return set ??
                   RegisterNativeIndicators(bars);
        }

        private double GetEma(
            Bars bars,
            int index,
            int period)
        {
            if (bars == null ||
                index < 0 ||
                index >= bars.Count)
                return 0.0;

            if (period <= 1)
                return bars.ClosePrices[index];

            NativeIndicatorSet set =
                GetNativeIndicatorSet(bars);

            if (set == null)
                return 0.0;

            if (!set.Emas.TryGetValue(
                    period,
                    out ExponentialMovingAverage ema))
            {
                try
                {
                    ema =
                        Indicators.ExponentialMovingAverage(
                            bars.ClosePrices,
                            period);

                    set.Emas[period] = ema;
                }
                catch (Exception ex)
                {
                    Print(
                        "CFIP EMA initialization failed [{0}/{1}]: {2}",
                        bars.TimeFrame,
                        period,
                        ex.Message);
                    return 0.0;
                }
            }

            if (ema == null ||
                index >= ema.Result.Count)
                return 0.0;

            double value =
                ema.Result[index];

            return IsFinitePositive(value)
                ? value
                : 0.0;
        }

        private double GetRsi(
            Bars bars,
            int index,
            int period)
        {
            if (bars == null ||
                period < 2 ||
                index < 0 ||
                index >= bars.Count)
                return 50.0;

            NativeIndicatorSet set =
                GetNativeIndicatorSet(bars);

            if (set == null ||
                set.Rsi == null ||
                index >= set.Rsi.Result.Count)
                return 50.0;

            double value =
                set.Rsi.Result[index];

            if (double.IsNaN(value) ||
                double.IsInfinity(value))
                return 50.0;

            return Clamp(
                value,
                0.0,
                100.0);
        }

        private double GetAtr(
            Bars bars,
            int index,
            int period)
        {
            if (bars == null ||
                period < 2 ||
                index < 0 ||
                index >= bars.Count)
                return 0.0;

            NativeIndicatorSet set =
                GetNativeIndicatorSet(bars);

            if (set == null ||
                set.Atr == null ||
                index >= set.Atr.Result.Count)
                return 0.0;

            double value =
                set.Atr.Result[index];

            return IsFinitePositive(value)
                ? value
                : 0.0;
        }

        private double GetDmiBias(
            Bars bars,
            int index,
            int period)
        {
            if (bars == null ||
                period < 2 ||
                index < 0 ||
                index >= bars.Count)
                return 0.0;

            NativeIndicatorSet set =
                GetNativeIndicatorSet(bars);

            if (set == null ||
                set.Dms == null ||
                index >= set.Dms.DIPlus.Count ||
                index >= set.Dms.DIMinus.Count)
                return 0.0;

            double plus = set.Dms.DIPlus[index];
            double minus = set.Dms.DIMinus[index];

            if (double.IsNaN(plus) ||
                double.IsInfinity(plus) ||
                double.IsNaN(minus) ||
                double.IsInfinity(minus))
                return 0.0;

            double total = plus + minus;

            if (total <= 1e-12)
                return 0.0;

            return Clamp(
                (plus - minus) / total,
                -1.0,
                1.0);
        }

        private double GetAdx(
            Bars bars,
            int index,
            int period)
        {
            if (bars == null ||
                period < 2 ||
                index < 0 ||
                index >= bars.Count)
                return 0.0;

            NativeIndicatorSet set =
                GetNativeIndicatorSet(bars);

            if (set == null ||
                set.Dms == null ||
                index >= set.Dms.ADX.Count)
                return 0.0;

            double value =
                set.Dms.ADX[index];

            if (double.IsNaN(value) ||
                double.IsInfinity(value))
                return 0.0;

            return Clamp(
                value,
                0.0,
                100.0);
        }


