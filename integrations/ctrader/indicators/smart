        private void GetAdaptiveSmartThresholds(
            string regime,
            out int qualityThreshold,
            out int shareThreshold,
            out int edgeThreshold)
        {
            qualityThreshold = Math.Max(40, Math.Min(95, MinimumSmartQuality));
            shareThreshold = Math.Max(50, Math.Min(90, MinimumSmartDirectionShare));
            edgeThreshold = Math.Max(4, Math.Min(30, MinimumEdge));

            if (!AdaptiveSmartThresholds)
                return;

            int b = Math.Max(0, SmartRegimeBuffer);
            switch (regime ?? "UNKNOWN")
            {
                case "TREND":
                case "EXPANSION":
                    qualityThreshold -= b;
                    shareThreshold -= Math.Max(1, b / 3);
                    edgeThreshold -= Math.Max(1, b / 3);
                    break;

                case "REVERSAL":
                    qualityThreshold -= Math.Max(1, b / 2);
                    break;

                case "RANGE":
                    qualityThreshold += Math.Max(1, b / 2);
                    shareThreshold += Math.Max(1, b / 3);
                    edgeThreshold += Math.Max(1, b / 3);
                    break;

                case "COMPRESSION":
                    qualityThreshold += b;
                    shareThreshold += Math.Max(1, b / 2);
                    edgeThreshold += Math.Max(1, b / 2);
                    break;
            }

            qualityThreshold = Math.Max(40, Math.Min(95, qualityThreshold));
            shareThreshold = Math.Max(50, Math.Min(90, shareThreshold));
            edgeThreshold = Math.Max(4, Math.Min(30, edgeThreshold));
        }

        private int CalculateSmartRegimeQuality(Bars bars, int index, string regime)
        {
            if (bars == null || index < 35)
                return 0;

            double atr = GetAtr(bars, index, AtrPeriod);
            double oldAtr = GetAtr(bars, Math.Max(20, index - 12), AtrPeriod);
            double adx = GetAdx(bars, index, AdxPeriod);
            if (atr <= 0 || oldAtr <= 0)
                return 0;

            double fast = GetEma(bars, index, FastEma);
            double slow = GetEma(bars, index, SlowEma);
            double slope = Math.Abs(fast - GetEma(bars, Math.Max(10, index - 4), FastEma)) / atr;
            double spread = Math.Abs(fast - slow) / atr;
            double expansion = atr / oldAtr;
            double adxQuality = Clamp(adx / Math.Max(1.0, AdxMinimum * 2.0), 0.0, 1.0);

            double q;
            switch (regime ?? "UNKNOWN")
            {
                case "TREND":
                    q = 55 + Clamp(spread, 0, 2) * 18 + Clamp(slope, 0, 1) * 12 + adxQuality * 15;
                    break;
                case "EXPANSION":
                    q = 50 + Clamp((expansion - 1.0) * 45, 0, 25) + adxQuality * 25;
                    break;
                case "REVERSAL":
                    q = 48 + adxQuality * 20 + Clamp((expansion - 0.9) * 35, 0, 25);
                    break;
                case "RANGE":
                    q = 45 + (1 - adxQuality) * 25 + Clamp(1 - spread, 0, 1) * 20;
                    break;
                case "COMPRESSION":
                    q = 35 + (1 - adxQuality) * 20;
                    break;
                default:
                    q = 42;
                    break;
            }

            return (int)Math.Round(Clamp(q, 0, 100));
        }

        private int CalculateSmartTimeframeAgreement(
            int direction,
            Analysis a5,
            Analysis a15,
            Analysis a30,
            Analysis h1,
            Analysis h4,
            Analysis w1)
        {
            if (direction == 0)
                return 0;

            Analysis[] frames = { a5, a15, a30, h1, h4, w1 };
            double[] weights =
            {
                Math.Max(0.0, M5Weight),
                Math.Max(0.0, M15Weight),
                Math.Max(0.0, M30Weight),
                Math.Max(0.0, H1Weight),
                Math.Max(0.0, H4Weight),
                SmartWeeklyContext
                    ? Math.Max(0.5, Math.Min(3.0, Math.Max(0.5, H4Weight * 0.75)))
                    : 0.0
            };

            double total = 0.0;
            double aligned = 0.0;

            for (int i = 0; i < frames.Length; i++)
            {
                if (frames[i] == null || weights[i] <= 0)
                    continue;

                total += weights[i];

                if (frames[i].Direction == direction)
                    aligned += weights[i];
            }

            return total > 0
                ? (int)Math.Round(Clamp(aligned / total * 100.0, 0.0, 100.0))
                : 0;
        }

        private int CalculateSmartConsensusQuality(
            int direction,
            Analysis a5,
            Analysis a15,
            Analysis a30,
            Analysis h1,
            Analysis h4,
            Analysis w1,
            int liveTriggerScore,
            double entryQuality,
            out int independentEvidence)
        {
            independentEvidence = 0;

            if (direction == 0)
                return 0;

            Analysis[] frames =
            {
                a5,
                a15,
                a30,
                h1,
                h4,
                w1
            };

            double[] weights =
            {
                Math.Max(0.0, M5Weight),
                Math.Max(0.0, M15Weight),
                Math.Max(0.0, M30Weight),
                Math.Max(0.0, H1Weight),
                Math.Max(0.0, H4Weight),
                SmartWeeklyContext
                    ? Math.Max(
                        0.5,
                        Math.Min(
                            3.0,
                            Math.Max(0.5, H4Weight * 0.75)))
                    : 0.0
            };

            double weightedAgreement = 0.0;
            double totalWeight = 0.0;

            for (int i = 0; i < frames.Length; i++)
            {
                if (frames[i] == null || weights[i] <= 0)
                    continue;

                totalWeight += weights[i];

                if (frames[i].Direction == direction)
                    weightedAgreement += weights[i];
            }

            double tfAgreement =
                totalWeight > 0
                    ? weightedAgreement / totalWeight * 100.0
                    : 0.0;

            Analysis core = a5;
            if (core == null)
                return 0;

            bool structure =
                direction == 1
                    ? (core.MssBull ||
                       core.ChochBull ||
                       core.StructureBull)
                    : (core.MssBear ||
                       core.ChochBear ||
                       core.StructureBear);

            bool liquidity =
                direction == 1
                    ? (core.LiquidityBull ||
                       core.EqualLow ||
                       core.Discount)
                    : (core.LiquidityBear ||
                       core.EqualHigh ||
                       core.Premium);

            bool zone =
                direction == 1
                    ? (core.FvgBull || core.ObBull)
                    : (core.FvgBear || core.ObBear);

            bool momentum =
                direction == 1
                    ? (core.TrendBull ||
                       core.MomentumBull ||
                       core.VolumeBull ||
                       core.MacdBull ||
                       core.VwapBull)
                    : (core.TrendBear ||
                       core.MomentumBear ||
                       core.VolumeBear ||
                       core.MacdBear ||
                       core.VwapBear);

            // Trigger evidence must be independently earned. The previous
            // implementation compared the live score against LiveTriggerScore
            // itself, which made any positive configured threshold self-satisfy.
            bool trigger =
                liveTriggerScore >=
                Math.Max(
                    1,
                    Math.Min(
                        6,
                        PrecisionTriggerScore));

            bool entry =
                entryQuality >= 65.0;

            if (tfAgreement >= Math.Max(50, SmartMinimumTimeframeAgreement))
                independentEvidence++;
            if (structure) independentEvidence++;
            if (liquidity) independentEvidence++;
            if (zone) independentEvidence++;
            if (momentum) independentEvidence++;
            if (trigger) independentEvidence++;
            if (entry) independentEvidence++;

            double structureScore = structure ? 100.0 : 0.0;
            double liquidityZoneScore =
                liquidity && zone
                    ? 100.0
                    : liquidity || zone
                        ? 58.0
                        : 0.0;
            double momentumScore = momentum ? 100.0 : 0.0;
            double triggerScore =
                Clamp(
                    liveTriggerScore / 6.0 * 100.0,
                    0.0,
                    100.0);
            double entryScore = Clamp(entryQuality, 0.0, 100.0);

            double consensus =
                tfAgreement * 0.42 +
                structureScore * 0.18 +
                liquidityZoneScore * 0.12 +
                momentumScore * 0.10 +
                triggerScore * 0.10 +
                entryScore * 0.08;

            return (int)Math.Round(
                Clamp(consensus, 0.0, 100.0));
        }

        private bool GetStrongClosedStructuralReversal(
            Bars bars,
            int index,
            Analysis a5,
            out int direction,
            out int quality)
        {
            direction = 0;
            quality = 0;

            if (bars == null || a5 == null || index < 25 || index >= bars.Count)
                return false;

            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0)
                return false;

            bool bullStructure = a5.MssBull || a5.ChochBull || a5.DisplacementBull;
            bool bearStructure = a5.MssBear || a5.ChochBear || a5.DisplacementBear;
            bool bullSweep = HasBullLiquiditySweep(bars, index);
            bool bearSweep = HasBearLiquiditySweep(bars, index);
            bool bullZone = a5.FvgBull || a5.ObBull || a5.LiquidityBull;
            bool bearZone = a5.FvgBear || a5.ObBear || a5.LiquidityBear;
            bool bullBreak = bars.ClosePrices[index] > HighestHigh(bars, Math.Max(0, index - 4), index - 1);
            bool bearBreak = bars.ClosePrices[index] < LowestLow(bars, Math.Max(0, index - 4), index - 1);

            double body = Math.Abs(bars.ClosePrices[index] - bars.OpenPrices[index]);
            bool bullBody = bars.ClosePrices[index] > bars.OpenPrices[index] &&
                            body >= atr * Math.Max(0.06, MinimumTriggerBodyAtr * 0.75);
            bool bearBody = bars.ClosePrices[index] < bars.OpenPrices[index] &&
                            body >= atr * Math.Max(0.06, MinimumTriggerBodyAtr * 0.75);

            int bull = (bullStructure ? 38 : 0) +
                       (bullSweep ? 22 : 0) +
                       (bullBreak ? 22 : 0) +
                       (bullZone ? 10 : 0) +
                       (bullBody ? 8 : 0);

            int bear = (bearStructure ? 38 : 0) +
                       (bearSweep ? 22 : 0) +
                       (bearBreak ? 22 : 0) +
                       (bearZone ? 10 : 0) +
                       (bearBody ? 8 : 0);

            if (bull >= bear + 12 && bullStructure && (bullSweep || bullBreak) && bull >= 65)
            {
                direction = 1;
                quality = Math.Min(100, bull);
                return true;
            }

            if (bear >= bull + 12 && bearStructure && (bearSweep || bearBreak) && bear >= 65)
            {
                direction = -1;
                quality = Math.Min(100, bear);
                return true;
            }

            return false;
        }

        private int CalculateFastReversalQuality(
            Bars bars,
            int index,
            int direction,
            out int evidence)
        {
            evidence = 0;
            if (!EnableFastReversalIntelligence || bars == null || direction == 0 ||
                index < 30 || index >= bars.Count)
                return 0;

            double atr = GetAtr(bars, index, AtrPeriod);
            if (!IsFinitePositive(atr))
                return 0;

            int lookback = Math.Max(3, FastReversalLookbackBars);
            int start = Math.Max(20, index - lookback + 1);
            int score = 0;
            bool sweep = false, structure = false, displacement = false;
            bool zone = false, rejection = false, microBreak = false;
            bool emaReclaim = false, momentum = false;

            for (int i = start; i <= index; i++)
            {
                bool s = direction == 1 ? HasBullLiquiditySweep(bars, i) : HasBearLiquiditySweep(bars, i);
                bool st = direction == 1 ? (HasBullMss(bars, i) || HasBullChoch(bars, i)) : (HasBearMss(bars, i) || HasBearChoch(bars, i));
                bool d = direction == 1 ? HasBullDisplacement(bars, i) : HasBearDisplacement(bars, i);
                bool z = direction == 1 ? (HasBullFvg(bars, i) || HasBullOb(bars, i)) : (HasBearFvg(bars, i) || HasBearOb(bars, i));
                bool r = direction == 1 ? HasBullRejection(bars, i) : HasBearRejection(bars, i);

                sweep |= s; structure |= st; displacement |= d; zone |= z; rejection |= r;

                double body = Math.Abs(bars.ClosePrices[i] - bars.OpenPrices[i]);
                bool directional = direction == 1 ? bars.ClosePrices[i] > bars.OpenPrices[i] : bars.ClosePrices[i] < bars.OpenPrices[i];
                if (directional && body >= atr * Math.Max(0.05, MinimumTriggerBodyAtr * 0.75))
                    momentum = true;

                if (i > 0)
                    microBreak |= direction == 1 ? bars.ClosePrices[i] > bars.HighPrices[i - 1] : bars.ClosePrices[i] < bars.LowPrices[i - 1];

                double fast = GetEma(bars, i, FastEma);
                double slow = GetEma(bars, i, SlowEma);
                emaReclaim |= direction == 1 ? bars.ClosePrices[i] > fast && fast >= slow : bars.ClosePrices[i] < fast && fast <= slow;
            }

            if (structure) { score += 26; evidence++; }
            if (sweep) { score += 18; evidence++; }
            if (displacement) { score += 17; evidence++; }
            if (zone) { score += 12; evidence++; }
            if (rejection) { score += 8; evidence++; }
            if (microBreak) { score += 10; evidence++; }
            if (emaReclaim) score += 5;
            if (momentum) score += 4;

            int locationQuality = CalculateEntryLocationQuality(bars, index, direction);
            if (locationQuality >= Math.Max(40, FastReversalMinimumZoneQuality))
                score += 10;

            if (!structure && !sweep)
                score -= 12;

            if (structure && displacement && (sweep || zone))
                score += 8;

            int retest = CalculateRetestQuality(bars, index, direction);
            if (retest >= MinimumRetestQuality)
            {
                score += 7;
                evidence++;
            }

            return (int)Clamp(score, 0, 100);
        }

        private void EvaluateSmartDecision(int chartIndex)
        {
            if (!EnableSmartDecisionEngine ||
                _m5 == null ||
                _m15 == null ||
                _m5.Count < 70 ||
                _m15.Count < 70)
            {
                _smartDecision = null;
                _smartDirection = 0;
                _smartBuyShare = 50;
                _smartSellShare = 50;
                _smartQuality = 0;
                _smartEntryQuality = 0;
                _smartRegime = "UNKNOWN";
                _smartAction = "WAIT";
                _smartReason = "";
                _smartConsensusQuality = 0;
                _smartIndependentEvidence = 0;
                _smartDecisionM5Bar = -1;
                return;
            }

            int liveIndex = _m5.Count - 1;
            DateTime reference =
                _m5.OpenTimes[liveIndex];
            int m5Index =
                GetLastClosedIndexBefore(_m5, reference);

            if (SmartUseClosedBarDecision &&
                _smartDecision != null &&
                _smartDecisionM5Bar == m5Index)
            {
                return;
            }

            _smartDecision = null;
            _smartDirection = 0;
            _smartBuyShare = 50;
            _smartSellShare = 50;
            _smartQuality = 0;
            _smartEntryQuality = 0;
            _smartRegime = "UNKNOWN";
            _smartAction = "WAIT";
            _smartReason = "";
            _smartConsensusQuality = 0;
            _smartIndependentEvidence = 0;

            int m15Index =
                GetLastClosedIndexBefore(
                    _m15,
                    reference);

            int m30Index =
                _m30 != null
                    ? GetLastClosedIndexBefore(_m30, reference)
                    : -1;

            int h1Index =
                _h1 != null
                    ? GetLastClosedIndexBefore(_h1, reference)
                    : -1;

            int h4Index =
                _h4 != null
                    ? GetLastClosedIndexBefore(_h4, reference)
                    : -1;

            Analysis a5 =
                GetCachedClosedAnalysis(
                    _m5,
                    m5Index);

            Analysis a15 =
                m15Index >= 50
                    ? GetCachedClosedAnalysis(_m15, m15Index)
                    : null;

            Analysis a30 =
                m30Index >= 50
                    ? GetCachedClosedAnalysis(_m30, m30Index)
                    : null;

            Analysis ah1 =
                h1Index >= 50
                    ? GetCachedClosedAnalysis(_h1, h1Index)
                    : null;

            Analysis ah4 =
                h4Index >= 50
                    ? GetCachedClosedAnalysis(_h4, h4Index)
                    : null;

            Analysis aw1 = null;
            if (SmartWeeklyContext && _w1 != null)
            {
                int w1Index =
                    GetLastClosedIndexBefore(
                        _w1,
                        reference);

                if (w1Index >= 30)
                {
                    aw1 =
                        GetCachedClosedAnalysis(
                            _w1,
                            w1Index);
                }
            }

            if (a5 == null || a15 == null)
                return;

            Bars smartTriggerBars =
                UseM5Trigger ? _m5 : _m15;

            int smartTriggerLiveIndex =
                smartTriggerBars == _m5
                    ? liveIndex
                    : Math.Max(1, _m15.Count - 1);

            int decisionIndex =
                UseM5Trigger
                    ? (SmartUseClosedBarDecision
                        ? m5Index
                        : smartTriggerLiveIndex)
                    : (SmartUseClosedBarDecision
                        ? m15Index
                        : smartTriggerLiveIndex);

            int liveBull =
                smartTriggerBars != null &&
                decisionIndex >= 20
                    ? LiveBullTriggerScore(
                        smartTriggerBars,
                        decisionIndex)
                    : 0;

            int liveBear =
                smartTriggerBars != null &&
                decisionIndex >= 20
                    ? LiveBearTriggerScore(
                        smartTriggerBars,
                        decisionIndex)
                    : 0;

            string regime =
                DetectSmartRegime(
                    _m5,
                    m5Index);

            _smartRegimeQuality =
                CalculateSmartRegimeQuality(
                    _m5,
                    m5Index,
                    regime);

            GetAdaptiveSmartThresholds(
                regime,
                out int adaptiveQualityThreshold,
                out int adaptiveShareThreshold,
                out int adaptiveEdgeThreshold);

            double bull = 0.0;
            double bear = 0.0;
            double bullEvidence = 0.0;
            double bearEvidence = 0.0;

            // Frame weights are relative weights, not percentages.
            // AddSmartAnalysisContribution normalizes every Analysis to 0..1 first.
            double smartWeightScale = 3.0;

            AddSmartAnalysisContribution(
                a5, Math.Max(0.0, M5Weight) * smartWeightScale,
                ref bull, ref bear,
                ref bullEvidence, ref bearEvidence);

            AddSmartAnalysisContribution(
                a15, Math.Max(0.0, M15Weight) * smartWeightScale,
                ref bull, ref bear,
                ref bullEvidence, ref bearEvidence);

            AddSmartAnalysisContribution(
                a30, Math.Max(0.0, M30Weight) * smartWeightScale,
                ref bull, ref bear,
                ref bullEvidence, ref bearEvidence);

            AddSmartAnalysisContribution(
                ah1, Math.Max(0.0, H1Weight) * smartWeightScale,
                ref bull, ref bear,
                ref bullEvidence, ref bearEvidence);

            AddSmartAnalysisContribution(
                ah4, Math.Max(0.0, H4Weight) * smartWeightScale,
                ref bull, ref bear,
                ref bullEvidence, ref bearEvidence);

            if (aw1 != null)
            {
                AddSmartAnalysisContribution(
                    aw1,
                    Math.Max(
                        1.0,
                        Math.Min(
                            3.0,
                            Math.Max(0.5, H4Weight * 0.75))),
                    
                    ref bull, ref bear,
                    ref bullEvidence, ref bearEvidence);
            }

            // One fast trigger family. It replaces the previous double-counting
            // of live trigger score + precision trigger bonus.
            double bullTrigger =
                Clamp(liveBull / 6.0 * 10.0, 0, 10);

            double bearTrigger =
                Clamp(liveBear / 6.0 * 10.0, 0, 10);

            bull += bullTrigger;
            bear += bearTrigger;

            if (liveBull >= PrecisionTriggerScore)
                bullEvidence += 1.0;

            if (liveBear >= PrecisionTriggerScore)
                bearEvidence += 1.0;

            // Current closed-bar entry quality is a separate execution-family
            // measure. It is bounded and cannot dominate the MTF context.
            double bullEntryQuality =
                CalculateSmartEntryQuality(
                    _m5,
                    decisionIndex,
                    1);

            double bearEntryQuality =
                CalculateSmartEntryQuality(
                    _m5,
                    decisionIndex,
                    -1);

            _smartEntryQuality =
                Math.Max(
                    bullEntryQuality,
                    bearEntryQuality);

            bull += bullEntryQuality * 0.08;
            bear += bearEntryQuality * 0.08;

            bullEvidence +=
                Clamp(bullEntryQuality / 100.0, 0, 1);

            bearEvidence +=
                Clamp(bearEntryQuality / 100.0, 0, 1);

            // Closed M1 is an optional independent fast confirmation.
            if (_m1 != null && _m1.Count >= 70)
            {
                int m1Index =
                    GetLastClosedIndexBefore(
                        _m1,
                        reference);

                if (m1Index >= 50)
                {
                    Analysis m1 =
                        GetCachedClosedAnalysis(
                            _m1,
                            m1Index);

                    if (m1 != null)
                    {
                        AddSmartAnalysisContribution(
                            m1,
                            Math.Max(
                                1.0,
                                Math.Min(
                                    3.0,
                                    Math.Max(0.5, M5Weight * 0.40))),
                            
                            ref bull, ref bear,
                            ref bullEvidence, ref bearEvidence);
                    }
                }
            }

            if (AdaptiveRegimeWeighting)
            {
                ApplySmartRegimeAdjustment(
                    regime,
                    a5,
                    a15,
                    GetRsi(_m5, m5Index, RsiPeriod),
                    GetAdx(_m5, m5Index, AdxPeriod),
                    ref bull,
                    ref bear,
                    ref bullEvidence,
                    ref bearEvidence);
            }

            _fastReversalDirection = 0;
            _fastReversalQuality = 0;
            _fastReversalEvidence = 0;

            if (EnableFastReversalIntelligence)
            {
                int candidateDirection =
                    _smartLastStableDirection != 0
                        ? -_smartLastStableDirection
                        : (bull > bear ? 1 : bear > bull ? -1 : 0);

                if (candidateDirection != 0)
                {
                    if (_fastReversalCalculatedM5Bar != m5Index ||
                        _fastReversalCalculatedCandidateDirection != candidateDirection)
                    {
                        _fastReversalQuality =
                            CalculateFastReversalQuality(
                                _m5,
                                m5Index,
                                candidateDirection,
                                out _fastReversalEvidence);

                        _fastReversalCalculatedM5Bar = m5Index;
                        _fastReversalCalculatedCandidateDirection = candidateDirection;
                    }

                    if (_fastReversalQuality >= Math.Max(55, FastReversalMinimumQuality))
                    {
                        _fastReversalDirection = candidateDirection;
                        double reversalBoost = _fastReversalQuality * 0.22;

                        if (_fastReversalDirection == 1)
                        {
                            bull += reversalBoost;
                            bear = Math.Max(0, bear - reversalBoost * 0.35);
                        }
                        else
                        {
                            bear += reversalBoost;
                            bull = Math.Max(0, bull - reversalBoost * 0.35);
                        }
                    }
                }
            }

            double conflict =
                CalculateSmartConflictPenalty(
                    a5, a15, a30, ah1, ah4, aw1);

            // Conflict is a penalty on net directional evidence, not an
            // arbitrary percentage subtraction from both sides.
            double conflictHalf =
                conflict * 0.50;

            if (bull > bear)
                bull = Math.Max(0, bull - conflictHalf);
            else if (bear > bull)
                bear = Math.Max(0, bear - conflictHalf);

            CalculateSmartSoftmaxShares(
                bull,
                bear,
                Math.Max(4.0, SmartScoreTemperature),
                out int buyShare,
                out int sellShare);

            int edge =
                Math.Abs(
                    buyShare - sellShare);

            int direction = 0;

            int requiredShare = adaptiveShareThreshold;
            int requiredEdge = adaptiveEdgeThreshold;

            if (buyShare >= requiredShare &&
                buyShare >= sellShare + requiredEdge)
            {
                direction = 1;
            }
            else if (sellShare >= requiredShare &&
                     sellShare >= buyShare + requiredEdge)
            {
                direction = -1;
            }

            double strongestShare =
                Math.Max(
                    buyShare,
                    sellShare);

            double evidenceCapacity = 2.0; // trigger + entry quality

            if (a5 != null) evidenceCapacity += 1.0;
            if (a15 != null) evidenceCapacity += 1.0;
            if (a30 != null && M30Weight > 0) evidenceCapacity += 1.0;
            if (ah1 != null && H1Weight > 0) evidenceCapacity += 1.0;
            if (ah4 != null && H4Weight > 0) evidenceCapacity += 1.0;
            if (aw1 != null) evidenceCapacity += 1.0;

            if (_m1 != null && UseM1Trigger)
            {
                int m1EvidenceIndex =
                    GetLastClosedIndexBefore(_m1, reference);

                if (m1EvidenceIndex >= 50)
                    evidenceCapacity += 1.0;
            }

            double evidenceCoverage =
                Clamp(
                    Math.Max(
                        bullEvidence,
                        bearEvidence) /
                    Math.Max(1.0, evidenceCapacity),
                    0,
                    1) * 100.0;

            int quality =
                (int)Math.Round(
                    Clamp(
                        strongestShare * 0.44 +
                        evidenceCoverage * 0.22 +
                        edge * 0.28 +
                        _smartRegimeQuality * 0.12 -
                        conflict * 0.60,
                        0,
                        100));

            if (a5.Choppy && a15.Choppy)
                quality =
                    Math.Max(
                        0,
                        quality - 10);

            int provisionalDirection = direction;
            int independentEvidence = 0;
            int consensusQuality =
                provisionalDirection != 0
                    ? CalculateSmartConsensusQuality(
                        provisionalDirection,
                        a5,
                        a15,
                        a30,
                        ah1,
                        ah4,
                        aw1,
                        provisionalDirection == 1
                            ? liveBull
                            : liveBear,
                        provisionalDirection == 1
                            ? bullEntryQuality
                            : bearEntryQuality,
                        out independentEvidence)
                    : 0;

            _smartConsensusQuality = consensusQuality;
            _smartIndependentEvidence = independentEvidence;
            _smartTimeframeAgreement = CalculateSmartTimeframeAgreement(
                provisionalDirection,
                a5,
                a15,
                a30,
                ah1,
                ah4,
                aw1);

            // Feed independent consensus back into quality. This keeps the
            // displayed quality aligned with the actual gate instead of allowing
            // a high softmax share to remain high when cross-timeframe evidence
            // is structurally weak.
            quality =
                (int)Math.Round(
                    Clamp(
                        quality * 0.88 +
                        consensusQuality * 0.12,
                        0,
                        100));

            if (direction != 0)
            {
                bool weakRegime =
                    _smartRegimeQuality <
                    Math.Max(30, SmartRegimeQualityFloor);

                bool weakConsensus =
                    RequireSmartConsensus &&
                    (
                        consensusQuality <
                        Math.Max(50, SmartConsensusThreshold) ||
                        independentEvidence <
                        Math.Max(2, SmartMinimumIndependentEvidence) ||
                        _smartTimeframeAgreement <
                        Math.Max(50, SmartMinimumTimeframeAgreement)
                    );

                bool strongClosedReversal =
                    GetStrongClosedStructuralReversal(
                        _m5,
                        m5Index,
                        a5,
                        out int reversalDirection,
                        out int reversalQuality);

                if ((weakRegime && !strongClosedReversal) ||
                    (weakConsensus && !strongClosedReversal))
                    direction = 0;

                if (strongClosedReversal &&
                    reversalDirection != 0 &&
                    reversalQuality >= Math.Max(65, MinimumStructuralSequence))
                    direction = reversalDirection;

                if (_fastReversalDirection != 0 &&
                    _fastReversalQuality >= Math.Max(55, FastReversalMinimumQuality) &&
                    _fastReversalEvidence >= 2)
                {
                    bool htfHardConflict =
                        ah1 != null && ah4 != null &&
                        ah1.Direction == -_fastReversalDirection &&
                        ah4.Direction == -_fastReversalDirection;

                    if (!htfHardConflict &&
                        (AllowFastM5ReversalBeforeM15 ||
                         a15.Direction == _fastReversalDirection))
                    {
                        direction = _fastReversalDirection;
                        quality = Math.Max(quality, Math.Min(100, _fastReversalQuality + 4));
                    }
                }
            }

            // Do not allow one weak bar to flip an established decision.
            // A genuine MSS/CHOCH/displacement can still break the hysteresis.
            if (direction != 0 &&
                _smartLastStableDirection != 0 &&
                direction != _smartLastStableDirection)
            {
                bool genuineFlip =
                    direction == 1
                        ? (a5.MssBull || a5.ChochBull || a5.DisplacementBull)
                        : (a5.MssBear || a5.ChochBear || a5.DisplacementBear);

                bool fastFlip =
                    _fastReversalDirection == direction &&
                    _fastReversalQuality >= Math.Max(55, FastReversalMinimumQuality) &&
                    _fastReversalEvidence >= 2;

                if (!genuineFlip &&
                    !fastFlip &&
                    quality < adaptiveQualityThreshold + 6)
                    direction = 0;
            }

            if (direction != 0 &&
                quality < adaptiveQualityThreshold)
                direction = 0;

            _smartDecision =
                new SmartDecision
                {
                    Direction = direction,
                    BuyScore = bull,
                    SellScore = bear,
                    BuyShare = buyShare,
                    SellShare = sellShare,
                    Edge = edge,
                    Quality = quality,
                    BuyEvidence = bullEvidence,
                    SellEvidence = bearEvidence,
                    EvidenceCoverage = evidenceCoverage,
                    Regime = regime,
                    RegimeQuality = _smartRegimeQuality,
                    LiveBuy = liveBull,
                    LiveSell = liveBear
                };

            _smartDecisionM5Bar = m5Index;
            _smartDirection = direction;
            _smartBuyShare = buyShare;
            _smartSellShare = sellShare;
            _smartQuality = quality;
            _smartRegime = regime;

            if (direction != 0)
            {
                _smartLastStableDirection = direction;
                _smartOppositeBars = 0;
            }
            else if (_smartLastStableDirection != 0)
            {
                _smartOppositeBars++;
                if (_smartOppositeBars >= Math.Max(1, SmartFlipConfirmationBars))
                    _smartLastStableDirection = 0;
            }

            if (direction != 0)
            {
                _smartAction =
                    direction == 1
                        ? "BUY"
                        : "SELL";

                _smartReason =
                    BuildSmartReason(
                        direction,
                        a5,
                        a15,
                        aw1,
                        direction == 1
                            ? liveBull
                            : liveBear);

                if (_fastReversalDirection == direction &&
                    _fastReversalQuality > 0)
                {
                    _smartReason +=
                        " | FAST REVERSAL Q" +
                        _fastReversalQuality +
                        " E" +
                        _fastReversalEvidence;
                }
            }
            else
            {
                _smartAction =
                    buyShare > sellShare
                        ? "BUY WATCH"
                        : sellShare > buyShare
                            ? "SELL WATCH"
                            : "WAIT";

                _smartReason =
                    "BALANCED EVIDENCE";
            }

            if (AlertOnSmartDecision &&
                direction != 0 &&
                (
                    direction != _lastSmartDecisionAlertDirection ||
                    _smartAction != _lastSmartDecisionAlertAction
                ) &&
                (DateTime.UtcNow - _lastSmartDecisionAlertUtc).TotalSeconds >=
                    Math.Max(1, SmartAlertCooldownSeconds))
            {
                _lastSmartDecisionAlertUtc =
                    DateTime.UtcNow;

                _lastSmartDecisionAlertDirection =
                    direction;

                _lastSmartDecisionAlertAction =
                    _smartAction;

                QueueSmartDecisionAlert(
                    (_smartAction == "BUY"
                        ? "SMART DECISION BUY"
                        : "SMART DECISION SELL") +
                    " | Q " + quality +
                    " | EVIDENCE B" + buyShare +
                    "/S" + sellShare +
                    " | COVERAGE " +
                    Math.Round(evidenceCoverage) +
                    "% | EDGE " + edge +
                    "pp | " + regime,
                    direction,
                    liveIndex);
            }
        }

        private void AddSmartAnalysisContribution(
            Analysis a,
            double weight,
            ref double bull,
            ref double bear,
            ref double bullEvidence,
            ref double bearEvidence)
        {
            if (a == null ||
                weight <= 0 ||
                a.MaxScore <= 0)
                return;

            double bullQuality =
                Clamp(
                    a.BullScore /
                    (double)Math.Max(1, a.MaxScore),
                    0,
                    1);

            double bearQuality =
                Clamp(
                    a.BearScore /
                    (double)Math.Max(1, a.MaxScore),
                    0,
                    1);

            // A timeframe contributes one normalized directional family.
            // Individual flags inside Analysis are not added again here.
            bull += bullQuality * weight;
            bear += bearQuality * weight;

            bullEvidence += bullQuality;
            bearEvidence += bearQuality;
        }

        private string DetectSmartRegime(Bars bars, int index)
        {
            if (bars == null || index < 35)
                return "UNKNOWN";

            double atr = GetAtr(
                bars,
                index,
                AtrPeriod);

            double oldAtr =
                GetAtr(
                    bars,
                    Math.Max(20, index - 12),
                    AtrPeriod);

            double adx =
                GetAdx(
                    bars,
                    index,
                    AdxPeriod);

            double fast =
                GetEma(
                    bars,
                    index,
                    FastEma);

            double slow =
                GetEma(
                    bars,
                    index,
                    SlowEma);

            double fastPast =
                GetEma(
                    bars,
                    Math.Max(10, index - 4),
                    FastEma);

            if (atr <= 0 || oldAtr <= 0)
                return "UNKNOWN";

            double expansion =
                atr / oldAtr;

            double spread =
                Math.Abs(fast - slow) / atr;

            double slope =
                Math.Abs(fast - fastPast) / atr;

            if (adx >= Math.Max(20, AdxMinimum + 4) &&
                spread >= 0.45 &&
                slope >= 0.08)
                return "TREND";

            if (expansion >= 1.30 &&
                adx >= AdxMinimum)
                return "EXPANSION";

            bool mssBull =
                HasBullMss(bars, index) ||
                HasBullChoch(bars, index);

            bool mssBear =
                HasBearMss(bars, index) ||
                HasBearChoch(bars, index);

            if ((mssBull || mssBear) &&
                !(mssBull && mssBear) &&
                expansion >= 1.0)
                return "REVERSAL";

            if (expansion <= 0.78 &&
                adx < AdxMinimum + 4)
                return "COMPRESSION";

            if (adx < AdxMinimum &&
                spread < 0.35)
                return "RANGE";

            return "TRANSITION";
        }

        private void ApplySmartRegimeAdjustment(
            string regime,
            Analysis a5,
            Analysis a15,
            double rsi,
            double adx,
            ref double bull,
            ref double bear,
            ref double bullEvidence,
            ref double bearEvidence)
        {
            if (a5 == null || a15 == null)
                return;

            if (regime == "TREND")
            {
                if (a5.TrendBull &&
                    a15.TrendBull)
                {
                    bull += 4.0;
                    bullEvidence += 0.5;
                }

                if (a5.TrendBear &&
                    a15.TrendBear)
                {
                    bear += 4.0;
                    bearEvidence += 0.5;
                }
            }
            else if (regime == "RANGE")
            {
                if (a5.LiquidityBull &&
                    (a5.RejectionBull || a5.EqualLow))
                {
                    bull += 4.0;
                    bullEvidence += 0.5;
                }

                if (a5.LiquidityBear &&
                    (a5.RejectionBear || a5.EqualHigh))
                {
                    bear += 4.0;
                    bearEvidence += 0.5;
                }

                if (rsi >= 68)
                    bull *= 0.90;

                if (rsi <= 32)
                    bear *= 0.90;
            }
            else if (regime == "EXPANSION")
            {
                if (a5.DisplacementBull &&
                    adx >= AdxMinimum)
                {
                    bull += 5.0;
                    bullEvidence += 0.5;
                }

                if (a5.DisplacementBear &&
                    adx >= AdxMinimum)
                {
                    bear += 5.0;
                    bearEvidence += 0.5;
                }
            }
            else if (regime == "REVERSAL")
            {
                if (a5.MssBull || a5.ChochBull)
                {
                    bull += 6.0;
                    bullEvidence += 0.7;
                }

                if (a5.MssBear || a5.ChochBear)
                {
                    bear += 6.0;
                    bearEvidence += 0.7;
                }
            }
        }
        private double CalculateSmartConflictPenalty(
            Analysis a5,
            Analysis a15,
            Analysis a30,
            Analysis h1,
            Analysis h4,
            Analysis w1)
        {
            Analysis[] all =
            {
                a5,
                a15,
                a30,
                h1,
                h4,
                w1
            };

            // Conflict is calculated from the same configured timeframe weights
            // used by the Smart Decision Engine. Higher TF disagreement receives
            // a bounded importance multiplier without becoming a second scoring engine.
            double[] baseWeights =
            {
                Math.Max(0.0, M5Weight),
                Math.Max(0.0, M15Weight),
                Math.Max(0.0, M30Weight),
                Math.Max(0.0, H1Weight),
                Math.Max(0.0, H4Weight),
                SmartWeeklyContext
                    ? Math.Max(
                        0.5,
                        Math.Min(
                            3.0,
                            Math.Max(0.5, H4Weight * 0.75)))
                    : 0.0
            };

            double[] importance =
            {
                0.65,
                0.80,
                1.00,
                1.20,
                1.40,
                1.60
            };

            double bullWeight = 0.0;
            double bearWeight = 0.0;
            double totalWeight = 0.0;

            for (int i = 0; i < all.Length; i++)
            {
                Analysis a = all[i];
                double weight = baseWeights[i];

                if (a == null || weight <= 0)
                    continue;

                double effective =
                    weight * importance[i];

                totalWeight += effective;

                if (a.Direction == 1)
                    bullWeight += effective;
                else if (a.Direction == -1)
                    bearWeight += effective;
            }

            if (bullWeight <= 0 ||
                bearWeight <= 0 ||
                totalWeight <= 0)
                return 0.0;

            double minorityShare =
                Math.Min(
                    bullWeight,
                    bearWeight) /
                totalWeight;

            // 0 = no disagreement; 22 = maximum bounded conflict pressure.
            return Clamp(
                minorityShare * 55.0,
                0.0,
                22.0);
        }

        private void CalculateSmartSoftmaxShares(
            double bull,
            double bear,
            double temperature,
            out int buyShare,
            out int sellShare)
        {
            double t = Math.Max(1.0, temperature);
            double max = Math.Max(bull, bear);
            double eb = Math.Exp((bull - max) / t);
            double es = Math.Exp((bear - max) / t);
            double total = eb + es;
            if (total <= 0)
            {
                buyShare = 50;
                sellShare = 50;
                return;
            }

            buyShare = (int)Math.Round(100.0 * eb / total, MidpointRounding.AwayFromZero);
            buyShare = (int)Clamp(buyShare, 0, 100);
            sellShare = 100 - buyShare;
        }

        private string BuildSmartReason(int direction, Analysis a5, Analysis a15, Analysis w1, int liveScore)
        {
            List<string> reasons = new List<string>();
            if (direction == 1)
            {
                if (a5.MssBull || a5.ChochBull) reasons.Add("MSS");
                if (a5.DisplacementBull) reasons.Add("DISP");
                if (a5.LiquidityBull) reasons.Add("LIQ");
                if (a5.FvgBull || a5.ObBull) reasons.Add("ZONE");
            }
            else
            {
                if (a5.MssBear || a5.ChochBear) reasons.Add("MSS");
                if (a5.DisplacementBear) reasons.Add("DISP");
                if (a5.LiquidityBear) reasons.Add("LIQ");
                if (a5.FvgBear || a5.ObBear) reasons.Add("ZONE");
            }
            if (liveScore >= PrecisionTriggerScore) reasons.Add("TRIGGER");
            if (a15 != null && a15.Direction == direction) reasons.Add("M15");
            if (w1 != null && w1.Direction == direction) reasons.Add("W1");
            if ((direction == 1 && a5.TrendBull) || (direction == -1 && a5.TrendBear)) reasons.Add("TREND");
            if ((direction == 1 && a5.RejectionBull) || (direction == -1 && a5.RejectionBear)) reasons.Add("REJECT");
            return reasons.Count == 0 ? "CONFLUENCE" : string.Join("+", reasons);
        }

        private double CalculateSmartEntryQuality(
            Bars bars,
            int index,
            int direction)
        {
            if (bars == null ||
                index < 25 ||
                index >= bars.Count)
                return 0;

            double atr = GetAtr(
                bars,
                index,
                AtrPeriod);

            if (atr <= 0)
                return 0;

            double range =
                bars.HighPrices[index] -
                bars.LowPrices[index];

            if (range <= 0)
                return 0;

            double body =
                Math.Abs(
                    bars.ClosePrices[index] -
                    bars.OpenPrices[index]);

            bool directionalBody =
                direction == 1
                    ? bars.ClosePrices[index] >
                      bars.OpenPrices[index]
                    : bars.ClosePrices[index] <
                      bars.OpenPrices[index];

            if (!directionalBody)
                return 0;

            double location =
                direction == 1
                    ? (bars.ClosePrices[index] -
                       bars.LowPrices[index]) / range
                    : (bars.HighPrices[index] -
                       bars.ClosePrices[index]) / range;

            double bodyAtr =
                body / Math.Max(
                    atr,
                    Symbol.PipSize);

            double efficiency =
                body / Math.Max(
                    range,
                    Symbol.PipSize);

            bool microBreak =
                direction == 1
                    ? bars.ClosePrices[index] >
                      bars.HighPrices[index - 1]
                    : bars.ClosePrices[index] <
                      bars.LowPrices[index - 1];

            bool healthyRange =
                range <=
                atr * Math.Max(
                    0.80,
                    MaximumTriggerRangeAtr);

            double score = 0;

            // Independent execution geometry only. Trend/RSI/ADX/structure are
            // already represented by the MTF Analysis layer.
            score += 25.0;
            score += Clamp(
                (bodyAtr -
                 Math.Max(0.02, MinimumTriggerBodyAtr)) *
                45.0,
                0,
                25);

            score += Clamp(
                (location -
                 Math.Max(0.50, MinimumCloseLocation)) *
                80.0,
                0,
                20);

            if (microBreak)
                score += 15;

            if (healthyRange)
                score += 10;

            if (efficiency >= 0.55)
                score += 5;

            return Clamp(
                score,
                0,
                100);
        }

        private bool TryBuildSmartRiskPlan(
            Bars executionBars,
            int executionIndex,
            int direction,
            double entry,
            out double sl,
            out double tp1,
            out double tp2,
            out double tp3,
            out double tp4)
        {
            sl = tp1 = tp2 = tp3 = tp4 = 0;

            if (executionBars == null ||
                direction == 0 ||
                executionIndex < 35 ||
                executionIndex >= executionBars.Count ||
                !IsFinitePositive(entry))
                return false;

            DateTime reference = GetClosedBarReferenceTime(executionBars, executionIndex);
            double atr = GetAtr(executionBars, executionIndex, AtrPeriod);
            if (reference == DateTime.MinValue || !IsFinitePositive(atr))
                return false;

            // The smart engine has a single source of truth:
            // confirmed structure + liquidity + zones + multi-TF level clusters.
            // No synthetic RR target is allowed while Smart Decision is enabled.
            List<SmartLevel> stops =
                BuildSmartStopCandidates(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    atr,
                    reference);

            SmartLevel bestStop =
                SelectBestSmartStop(
                    stops,
                    entry,
                    direction,
                    atr);

            if (bestStop == null ||
                bestStop.Score < SmartStopQuality ||
                !IsFinitePositive(bestStop.Price))
                return false;

            sl = NormalizePrice(bestStop.Price);
            double risk = Math.Abs(entry - sl);
            double minimumRisk = Math.Max(
                Symbol.PipSize * 2.0,
                atr * Math.Max(0.10, MinimumSlAtr));
            double maximumRisk = atr * Math.Max(
                0.50,
                Math.Min(MaximumStructuralStopAtr, Math.Max(0.50, MaximumSlAtr)));

            if (risk < minimumRisk || risk > maximumRisk)
                return false;

            List<SmartLevel> targets =
                BuildSmartTargetCandidates(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    atr,
                    reference);

            AddExtendedLiquidityTargets(targets, executionBars, executionIndex, direction, entry, atr, reference);

            List<double> selected =
                SelectSmartTargetSequence(
                    targets,
                    entry,
                    risk,
                    direction,
                    atr,
                    false);

            if (AllowSyntheticTargetFallback)
            {
                selected = CompleteSmartTargetLadder(
                    targets, selected, entry, risk, direction, atr);
            }
            if (selected.Count < 2)
                return false;

            tp1 = NormalizePrice(selected[0]);
            tp2 = NormalizePrice(selected[1]);
            tp3 = selected.Count > 2 ? NormalizePrice(selected[2]) : 0;
            tp4 = selected.Count > 3 ? NormalizePrice(selected[3]) : 0;

            double rr = direction == 1
                ? (tp1 - entry) / risk
                : (entry - tp1) / risk;

            double minimumRR = CalculateAdaptiveMinimumRR();
            if (rr < minimumRR)
                return false;

            int planQuality = (int)Clamp(
                (_smartEntryQuality > 0 ? _smartEntryQuality : 70) * 0.55 +
                _smartStructuralSequence * 0.25 +
                _smartEntryLocationQuality * 0.20,
                0, 100);
            double proxyEv = CalculateProxyExpectedValue(planQuality, rr);
            _smartProxyExpectedValue = proxyEv;
            if (UseProxyExpectedValueGate && proxyEv < MinimumProxyExpectedValue)
                return false;

            double maximumTargetDistance = atr * Math.Max(2.0, MaximumTargetExtensionAtr);
            double tp1Distance = Math.Abs(tp1 - entry);
            if (tp1Distance > maximumTargetDistance)
                return false;

            if (RejectTargetObstacle &&
                HasSmartTargetObstacle(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    tp1,
                    atr))
                return false;

            if (tp2 > 0 &&
                RejectTargetObstacle &&
                HasSmartTargetObstacle(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    tp2,
                    atr))
                return false;

            if (tp3 > 0 &&
                RejectTargetObstacle &&
                HasSmartTargetObstacle(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    tp3,
                    atr))
                tp3 = 0;

            if (tp4 > 0 &&
                RejectTargetObstacle &&
                HasSmartTargetObstacle(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    tp4,
                    atr))
                tp4 = 0;

            if (direction == 1)
            {
                if (!(sl < entry && entry < tp1 && tp1 < tp2))
                    return false;
                if (tp3 > 0 && tp3 <= tp2) tp3 = 0;
                if (tp4 > 0 && (tp3 <= 0 || tp4 <= tp3)) tp4 = 0;
            }
            else
            {
                if (!(sl > entry && entry > tp1 && tp1 > tp2))
                    return false;
                if (tp3 > 0 && tp3 >= tp2) tp3 = 0;
                if (tp4 > 0 && (tp3 <= 0 || tp4 >= tp3)) tp4 = 0;
            }

            return true;
        }

        private List<double> CompleteSmartTargetLadder(
            List<SmartLevel> candidates,
            List<double> selected,
            double entry,
            double risk,
            int direction,
            double atr)
        {
            List<double> result = selected == null
                ? new List<double>()
                : new List<double>(selected);

            if (candidates == null || entry <= 0 || risk <= 0 || atr <= 0)
                return result;

            double spacing = Math.Max(Symbol.PipSize * 4.0, atr * Math.Max(0.08, MinimumTpSpacingAtr));
            candidates.Sort((a, b) =>
            {
                double da = direction == 1 ? a.Price - entry : entry - a.Price;
                double db = direction == 1 ? b.Price - entry : entry - b.Price;
                return da.CompareTo(db);
            });

            // Second pass deliberately relaxes only the quality threshold;
            // structure/HTF/liquidity geometry is still mandatory.
            foreach (SmartLevel c in candidates)
            {
                if (result.Count >= 4 || c == null || c.Price <= 0 || c.Score < Math.Max(45, SmartTargetQuality - 12))
                    continue;

                double distance = direction == 1 ? c.Price - entry : entry - c.Price;
                if (distance <= 0 || distance / risk < Math.Max(1.50, SmartTargetMinimumRR))
                    continue;

                bool duplicate = false;
                foreach (double x in result)
                {
                    if (Math.Abs(x - c.Price) <= spacing * 0.50) { duplicate = true; break; }
                }
                if (duplicate) continue;

                if (result.Count > 0)
                {
                    double last = result[result.Count - 1];
                    double fromLast = direction == 1 ? c.Price - last : last - c.Price;
                    if (fromLast < spacing) continue;
                }

                result.Add(NormalizePrice(c.Price));
            }

            // Final safety fallback: only fill a missing structural ladder slot
            // with deterministic RR geometry. This is never used for TP1/TP2
            // when structural targets are available.
            double[] fallbackRr = { 2.0, 3.2, 4.8, 6.5 };
            for (int i = result.Count; i < 4; i++)
            {
                double rr = Math.Max(fallbackRr[i], SmartTargetMinimumRR + i * Math.Max(0.25, StructuralTpRrStep));
                double price = direction == 1 ? entry + risk * rr : entry - risk * rr;
                price = NormalizePrice(price);
                bool valid = true;
                foreach (double x in result)
                {
                    if (Math.Abs(x - price) < spacing * 0.50) { valid = false; break; }
                }
                if (valid) result.Add(price);
            }

            return result;
        }

        private bool TryBuildFallbackRiskPlan(
            Bars executionBars,
            int executionIndex,
            int direction,
            double entry,
            out double sl,
            out double tp1,
            out double tp2,
            out double tp3,
            out double tp4)
        {
            sl = tp1 = tp2 = tp3 = tp4 = 0;
            if (executionBars == null ||
                direction == 0 ||
                executionIndex < 30 ||
                executionIndex >= executionBars.Count ||
                !IsFinitePositive(entry))
                return false;

            double atr = GetAtr(executionBars, executionIndex, AtrPeriod);
            if (!IsFinitePositive(atr))
                return false;

            double risk = atr * Math.Max(0.10, SlAtrMultiplier);
            risk = Math.Max(risk, atr * Math.Max(0.10, StopBufferAtr));
            risk = Math.Max(risk, atr * Math.Max(0.10, MinimumSlAtr));
            risk = Math.Min(risk, atr * Math.Max(0.50, MaximumSlAtr));

            if (!IsFinitePositive(risk))
                return false;

            sl = NormalizePrice(direction == 1 ? entry - risk : entry + risk);

            double rr1 = Math.Max(1.0, Tp1RR);
            double rr2 = Math.Max(rr1 + 0.50, Math.Max(1.50, Tp2RR));
            double rr3 = Math.Max(rr2 + 0.50, Math.Max(2.00, Tp3RR));
            double rr4 = Math.Max(rr3 + 0.50, Math.Max(3.00, Tp4RR));

            tp1 = NormalizePrice(direction == 1 ? entry + risk * rr1 : entry - risk * rr1);
            tp2 = NormalizePrice(direction == 1 ? entry + risk * rr2 : entry - risk * rr2);
            tp3 = NormalizePrice(direction == 1 ? entry + risk * rr3 : entry - risk * rr3);
            tp4 = NormalizePrice(direction == 1 ? entry + risk * rr4 : entry - risk * rr4);

            return direction == 1
                ? sl < entry && entry < tp1 && tp1 < tp2
                : sl > entry && entry > tp1 && tp1 > tp2;
        }

        private void AddSmartStopMagnet(
            List<SmartLevel> list,
            double level,
            double entry,
            double buffer,
            int direction,
            Bars[] frames,
            DateTime referenceTime,
            double atr,
            int timeframePriority,
            string sourceTimeframe,
            string kind,
            double baseScore)
        {
            if (list == null ||
                level <= 0 ||
                entry <= 0 ||
                buffer <= 0 ||
                atr <= 0 ||
                direction == 0)
                return;

            double stop = direction == 1
                ? level - buffer
                : level + buffer;

            if (direction == 1 && stop >= entry)
                return;
            if (direction == -1 && stop <= entry)
                return;

            double risk = Math.Abs(entry - stop);
            double maxRisk = atr * Math.Max(
                0.75,
                MaximumStructuralStopAtr * 1.10);

            if (risk <= Symbol.PipSize || risk > maxRisk)
                return;

            int cluster = CountNearbySmartStopLevels(
                level,
                frames,
                referenceTime,
                direction,
                atr);

            double score =
                baseScore +
                cluster * (timeframePriority >= 11 ? 7.0 : 6.0);

            list.Add(new SmartLevel
            {
                Price = NormalizePrice(stop),
                Score = Clamp(score, 0, 100),
                TimeframePriority = timeframePriority,
                Hits = Math.Max(1, cluster),
                AgeBars = 1,
                SourceTimeframe = sourceTimeframe,
                Kind = kind
            });
        }

        private List<SmartLevel> BuildSmartStopCandidates(
            Bars executionBars,
            int executionIndex,
            int direction,
            double entry,
            double atr,
            DateTime referenceTime)
        {
            List<SmartLevel> list = new List<SmartLevel>();

            if (executionBars == null ||
                direction == 0 ||
                executionIndex < 35 ||
                entry <= 0 ||
                atr <= 0)
                return list;

            Bars[] frames = SmartWeeklyContext
                ? new Bars[] { executionBars, _m15, _m30, _h1, _h4, _d1, _w1 }
                : new Bars[] { executionBars, _m15, _m30, _h1, _h4, _d1 };

            int[] priority = { 5, 6, 7, 8, 9, 10, 11 };

            // One consistent execution/structure buffer is required for the
            // explicit D1/W1 invalidation anchors below. The previous version
            // referenced `buffer` here without declaring it in this method,
            // which caused CS0103. Use the same ATR-aware policy as the rest
            // of the structural-stop engine, with the configured HTF buffer
            // as the baseline and a two-pip execution floor.
            double structuralBuffer = Math.Max(
                Symbol.PipSize * 2.0,
                atr * Math.Max(0.02, HtfStopBufferAtr));

            // Previous-session/week extremes are explicit invalidation anchors.
            // They complement swing/zone invalidation and are only valid on the
            // protective side of the entry inside the configured risk envelope.
            if (_d1 != null && _d1.Count >= 20)
            {
                int d1Index = GetLastClosedIndexBefore(_d1, referenceTime);
                if (d1Index >= 5)
                {
                    AddSmartStopMagnet(
                        list, _d1.LowPrices[d1Index], entry, structuralBuffer, direction,
                        frames, referenceTime, atr,
                        10, "D1", "PREVIOUS_DAY_LOW_STOP", 80);

                    AddSmartStopMagnet(
                        list, _d1.HighPrices[d1Index], entry, structuralBuffer, direction,
                        frames, referenceTime, atr,
                        10, "D1", "PREVIOUS_DAY_HIGH_STOP", 80);
                }
            }

            if (SmartWeeklyContext && _w1 != null && _w1.Count >= 20)
            {
                int w1Index = GetLastClosedIndexBefore(_w1, referenceTime);
                if (w1Index >= 5)
                {
                    AddSmartStopMagnet(
                        list, _w1.LowPrices[w1Index], entry, structuralBuffer, direction,
                        frames, referenceTime, atr,
                        11, "W1", "PREVIOUS_WEEK_LOW_STOP", 88);

                    AddSmartStopMagnet(
                        list, _w1.HighPrices[w1Index], entry, structuralBuffer, direction,
                        frames, referenceTime, atr,
                        11, "W1", "PREVIOUS_WEEK_HIGH_STOP", 88);
                }
            }


            for (int f = 0; f < frames.Length; f++)
            {
                Bars b = frames[f];
                bool executionFrame = ReferenceEquals(b, executionBars);

                // HTF stop mode controls whether higher-timeframe structure is
                // allowed to participate. Execution-frame structure is retained
                // only when explicitly allowed as a fallback.
                if (!executionFrame && !UseHtfStructureForStop)
                    continue;

                if (executionFrame &&
                    UseHtfStructureForStop &&
                    !AllowExecutionFrameStopFallback)
                    continue;

                if (b == null || b.Count < 50)
                    continue;

                int idx = executionFrame
                    ? executionIndex
                    : GetLastClosedIndexBefore(b, referenceTime);

                if (idx < 30)
                    continue;

                double frameAtr = GetAtr(b, idx, AtrPeriod);
                if (frameAtr <= 0)
                    continue;

                double structure = direction == 1
                    ? (executionFrame
                        ? FindTightProtectiveLow(b, idx, entry)
                        : FindHtfProtectiveLow(b, idx, entry))
                    : (executionFrame
                        ? FindTightProtectiveHigh(b, idx, entry)
                        : FindHtfProtectiveHigh(b, idx, entry));

                double buffer = Math.Max(
                    Symbol.PipSize * 2.0,
                    frameAtr * (executionFrame ? StopBufferAtr : HtfStopBufferAtr));

                if (structure > 0)
                {
                    double candidate = direction == 1
                        ? structure - buffer
                        : structure + buffer;

                    if ((direction == 1 && candidate < entry) ||
                        (direction == -1 && candidate > entry))
                    {
                        double risk = Math.Abs(entry - candidate);
                        double maxRisk = atr * Math.Max(
                            0.75,
                            MaximumStructuralStopAtr * 1.10);

                        if (risk > Symbol.PipSize && risk <= maxRisk)
                        {
                            Analysis a = executionFrame ? null : GetCachedClosedAnalysis(b, idx);
                            int alignment = a == null
                                ? 0
                                : a.Direction == direction
                                    ? 18
                                    : a.Direction == 0 ? 7 : -10;

                            int cluster = CountNearbySmartStopLevels(
                                structure,
                                frames,
                                referenceTime,
                                direction,
                                atr);

                            double riskQuality =
                                26.0 -
                                Clamp(
                                    Math.Abs(risk / atr - 0.85) * 20.0,
                                    0,
                                    22);

                            double score =
                                46.0 +
                                priority[f] * 2.2 +
                                alignment +
                                cluster * 8.0 +
                                riskQuality;

                            list.Add(new SmartLevel
                            {
                                Price = NormalizePrice(candidate),
                                Score = Clamp(score, 0, 100),
                                TimeframePriority = priority[f],
                                Hits = Math.Max(1, cluster + 1),
                                AgeBars = 0,
                                SourceTimeframe = executionFrame ? "M5" : GetSmartTimeframeName(b),
                                Kind = executionFrame ? "M5_STRUCTURE" : "HTF_STRUCTURE"
                            });

                        }
                    }
                }

                // Zone invalidation is an independent structural source. It must
                // remain available even when no swing candidate exists.
                AddSmartSupportingZoneStopCandidates(
                    b,
                    idx,
                    direction,
                    entry,
                    atr,
                    buffer,
                    priority[f],
                    frames,
                    referenceTime,
                    list);

                double pool = direction == 1
                    ? FindEqualLowPool(b, idx, entry, atr)
                    : FindEqualHighPool(b, idx, entry, atr);

                if (pool > 0)
                {
                    double poolCandidate = direction == 1
                        ? pool - buffer
                        : pool + buffer;

                    double poolRisk = Math.Abs(entry - poolCandidate);
                    double maxPoolRisk = atr * Math.Max(
                        0.75,
                        MaximumStructuralStopAtr * 1.10);

                    if ((direction == 1 && poolCandidate < entry) ||
                        (direction == -1 && poolCandidate > entry))
                    {
                        if (poolRisk > Symbol.PipSize && poolRisk <= maxPoolRisk)
                        {
                            int poolCluster = CountNearbySmartStopLevels(
                                pool,
                                frames,
                                referenceTime,
                                direction,
                                atr);

                            double score =
                                56.0 +
                                priority[f] * 2.0 +
                                poolCluster * 8.0 +
                                SmartLiquidityPoolBonus;

                            list.Add(new SmartLevel
                            {
                                Price = NormalizePrice(poolCandidate),
                                Score = Clamp(score, 0, 100),
                                TimeframePriority = priority[f],
                                Hits = Math.Max(2, poolCluster + 1),
                                AgeBars = 0,
                                SourceTimeframe = executionFrame ? "M5" : GetSmartTimeframeName(b),
                                Kind = "LIQUIDITY_POOL_INVALIDATION"
                            });
                        }
                    }
                }
            }

            return ConsolidateSmartLevels(list, atr);
        }

        private void AddSmartSupportingZoneStopCandidates(
            Bars bars,
            int index,
            int direction,
            double entry,
            double atr,
            double buffer,
            int timeframePriority,
            Bars[] frames,
            DateTime referenceTime,
            List<SmartLevel> list)
        {
            if (bars == null || index < 10 || atr <= 0 || list == null)
                return;

            int start = Math.Max(
                2,
                index - Math.Max(FvgLookback, ObLookback));

            int bestFvgAge = int.MaxValue;
            double bestFvgBoundary = 0;

            int bestObAge = int.MaxValue;
            double bestObBoundary = 0;

            for (int i = index - 1; i >= start; i--)
            {
                int age = index - i;
                if (age > MaximumZoneAgeBars)
                    break;

                if (UseFvg && i >= 2)
                {
                    double gap = direction == 1
                        ? bars.LowPrices[i] - bars.HighPrices[i - 2]
                        : bars.LowPrices[i - 2] - bars.HighPrices[i];

                    if (gap >= atr * MinimumFvgAtr)
                    {
                        double zoneLow = direction == 1
                            ? bars.HighPrices[i - 2]
                            : bars.HighPrices[i];

                        double zoneHigh = direction == 1
                            ? bars.LowPrices[i]
                            : bars.LowPrices[i - 2];

                        bool invalidated = false;
                        for (int j = i + 1; j <= index; j++)
                        {
                            if ((direction == 1 && bars.ClosePrices[j] < zoneLow) ||
                                (direction == -1 && bars.ClosePrices[j] > zoneHigh))
                            {
                                invalidated = true;
                                break;
                            }
                        }

                        bool positionallyUseful = direction == 1
                            ? zoneHigh < entry
                            : zoneLow > entry;

                        if (!invalidated && positionallyUseful && age < bestFvgAge)
                        {
                            bestFvgAge = age;
                            bestFvgBoundary = direction == 1
                                ? zoneLow - buffer
                                : zoneHigh + buffer;
                        }
                    }
                }

                if (UseOrderBlock && i + 1 <= index)
                {
                    bool sourceCandle = direction == 1
                        ? bars.ClosePrices[i] < bars.OpenPrices[i]
                        : bars.ClosePrices[i] > bars.OpenPrices[i];

                    if (sourceCandle)
                    {
                        int impulse = i + 1;
                        double body = Math.Abs(
                            bars.ClosePrices[impulse] -
                            bars.OpenPrices[impulse]);

                        bool displaced = direction == 1
                            ? bars.ClosePrices[impulse] > bars.HighPrices[i]
                            : bars.ClosePrices[impulse] < bars.LowPrices[i];

                        displaced = displaced &&
                                     (!RequireObDisplacement ||
                                      body >= atr * ObDisplacementAtr);

                        double zoneLow = bars.LowPrices[i];
                        double zoneHigh = bars.HighPrices[i];

                        bool invalidated = false;
                        for (int j = impulse + 1; j <= index; j++)
                        {
                            if ((direction == 1 && bars.ClosePrices[j] < zoneLow) ||
                                (direction == -1 && bars.ClosePrices[j] > zoneHigh))
                            {
                                invalidated = true;
                                break;
                            }
                        }

                        bool positionallyUseful = direction == 1
                            ? zoneHigh < entry
                            : zoneLow > entry;

                        if (displaced &&
                            !invalidated &&
                            positionallyUseful &&
                            age < bestObAge)
                        {
                            bestObAge = age;
                            bestObBoundary = direction == 1
                                ? zoneLow - buffer
                                : zoneHigh + buffer;
                        }
                    }
                }
            }

            if (bestFvgBoundary > 0 &&
                ((direction == 1 && bestFvgBoundary < entry) ||
                 (direction == -1 && bestFvgBoundary > entry)))
            {
                int cluster = CountNearbySmartStopLevels(
                    bestFvgBoundary,
                    frames,
                    referenceTime,
                    direction,
                    atr);

                double score =
                    62.0 +
                    timeframePriority * 1.8 +
                    cluster * 6.0 +
                    SmartStopZoneBonus * 0.75 +
                    Math.Max(0, 12.0 - bestFvgAge * 0.35);

                list.Add(new SmartLevel
                {
                    Price = NormalizePrice(bestFvgBoundary),
                    Score = Clamp(score, 0, 100),
                    TimeframePriority = timeframePriority,
                    Hits = Math.Max(1, cluster),
                    AgeBars = bestFvgAge,
                    SourceTimeframe = GetSmartTimeframeName(bars),
                    Kind = "FVG_INVALIDATION"
                });
            }

            if (bestObBoundary > 0 &&
                ((direction == 1 && bestObBoundary < entry) ||
                 (direction == -1 && bestObBoundary > entry)))
            {
                int cluster = CountNearbySmartStopLevels(
                    bestObBoundary,
                    frames,
                    referenceTime,
                    direction,
                    atr);

                double score =
                    66.0 +
                    timeframePriority * 1.8 +
                    cluster * 6.5 +
                    SmartStopZoneBonus +
                    Math.Max(0, 12.0 - bestObAge * 0.35);

                list.Add(new SmartLevel
                {
                    Price = NormalizePrice(bestObBoundary),
                    Score = Clamp(score, 0, 100),
                    TimeframePriority = timeframePriority,
                    Hits = Math.Max(1, cluster),                    AgeBars = bestObAge,
                    SourceTimeframe = GetSmartTimeframeName(bars),
                    Kind = "OB_INVALIDATION"
                });
            }
        }

        private List<SmartLevel> ConsolidateSmartLevels(            List<SmartLevel> levels,
            double atr)
        {
            List<SmartLevel> result = new List<SmartLevel>();
            if (levels == null || levels.Count == 0 || atr <= 0)
                return result;

            List<SmartLevel> ordered = new List<SmartLevel>(levels);
            ordered.Sort((a, b) => a.Price.CompareTo(b.Price));

            double tolerance = Math.Max(
                Symbol.PipSize * 3.0,
                atr * Math.Max(0.02, SmartLevelClusterAtr));

            int i = 0;
            while (i < ordered.Count)
            {
                SmartLevel anchor = ordered[i];
                List<SmartLevel> group = new List<SmartLevel> { anchor };
                int j = i + 1;

                while (j < ordered.Count &&
                       Math.Abs(ordered[j].Price - anchor.Price) <= tolerance)
                {
                    group.Add(ordered[j]);
                    j++;
                }

                SmartLevel best = group[0];
                foreach (SmartLevel candidate in group)
                {
                    if (candidate.Score > best.Score ||
                        (Math.Abs(candidate.Score - best.Score) < 0.0001 &&
                         candidate.TimeframePriority > best.TimeframePriority))
                    {
                        best = candidate;
                    }
                }

                int distinctFrames = 0;
                int maxHits = 0;
                List<string> seenFrames = new List<string>();

                foreach (SmartLevel candidate in group)
                {
                    maxHits = Math.Max(maxHits, candidate.Hits);
                    if (!string.IsNullOrWhiteSpace(candidate.SourceTimeframe) &&
                        !seenFrames.Contains(candidate.SourceTimeframe))
                    {
                        seenFrames.Add(candidate.SourceTimeframe);
                        distinctFrames++;
                    }
                }

                double mergedScore =
                    best.Score +
                    Math.Min(18.0, Math.Max(0, group.Count - 1) * 3.5) +
                    Math.Min(12.0, Math.Max(0, distinctFrames - 1) * 4.0) +
                    Math.Min(10.0, Math.Max(0, maxHits - best.Hits) * 2.5);

                result.Add(new SmartLevel
                {
                    Price = NormalizePrice(best.Price),
                    Score = Clamp(mergedScore, 0, 100),
                    TimeframePriority = best.TimeframePriority,
                    Hits = Math.Max(best.Hits, distinctFrames),
                    AgeBars = best.AgeBars,
                    SourceTimeframe = string.Join("/", seenFrames.ToArray()),
                    Kind = best.Kind
                });

                i = j;
            }

            return result;
        }

        private string GetSmartTimeframeName(Bars bars)
        {
            if (ReferenceEquals(bars, _m15)) return "M15";
            if (ReferenceEquals(bars, _m30)) return "M30";
            if (ReferenceEquals(bars, _h1)) return "H1";
            if (ReferenceEquals(bars, _h4)) return "H4";
            if (ReferenceEquals(bars, _d1)) return "D1";
            if (ReferenceEquals(bars, _w1)) return "W1";
            if (ReferenceEquals(bars, _m5)) return "M5";
            if (ReferenceEquals(bars, _m1)) return "M1";
            return "TF";
        }

        private int CountNearbySmartStopLevels(
            double price,
            Bars[] frames,
            DateTime referenceTime,
            int direction,
            double atr)
        {
            if (frames == null || price <= 0 || atr <= 0)
                return 0;

            double tolerance = Math.Max(Symbol.PipSize * 2.0, atr * Math.Max(0.02, SmartLevelClusterAtr));
            int hits = 0;
            foreach (Bars b in frames)
            {
                if (b == null || b.Count < 40)
                    continue;

                int idx = GetLastClosedIndexBefore(b, referenceTime);
                if (idx < 25)
                    continue;

                double nearest = 0;
                if (direction == 1)
                {
                    double low = FindNearestSwingBelow(b, idx, price + tolerance);
                    if (low > 0) nearest = low;
                }
                else
                {
                    double high = FindNearestSwingAbove(b, idx, price - tolerance);
                    if (high > 0) nearest = high;
                }

                if (nearest > 0 && Math.Abs(nearest - price) <= tolerance)
                    hits++;
            }
            return Math.Min(6, hits);
        }

        private SmartLevel SelectBestSmartStop(
            List<SmartLevel> levels,
            double entry,
            int direction,
            double atr)
        {
            SmartLevel best = null;
            double bestUtility = double.MinValue;

            if (levels == null ||
                entry <= 0 ||
                atr <= 0)
                return null;

            foreach (SmartLevel x in levels)
            {
                if (x == null || x.Price <= 0)
                    continue;

                double risk =
                    Math.Abs(entry - x.Price);

                double riskAtr =
                    risk / Math.Max(atr, Symbol.PipSize);

                double maxRisk =
                    atr *
                    Math.Max(
                        0.75,
                        MaximumStructuralStopAtr * 1.10);

                if (risk <= Symbol.PipSize ||
                    risk > maxRisk)
                    continue;

                if (direction == 1 && x.Price >= entry)
                    continue;

                if (direction == -1 && x.Price <= entry)
                    continue;

                // A protective stop should be structural first, but not needlessly
                // remote. Reward strong invalidation levels while mildly preferring
                // a risk band around 0.7-1.4 ATR.
                double riskBand =
                    18.0 -
                    Clamp(
                        Math.Abs(riskAtr - 1.0) * 12.0,
                        0,
                        14);

                double proximityBonus =
                    10.0 *
                    Math.Exp(-Math.Max(0, riskAtr - 0.80) * 0.75);

                double clusterBonus =
                    Math.Min(14.0, x.Hits * 3.5);

                double timeframeBonus =
                    Math.Min(11.0, x.TimeframePriority * 0.85);

                double kindBonus =
                    x.Kind == "PREVIOUS_WEEK_LOW_STOP" ||
                    x.Kind == "PREVIOUS_WEEK_HIGH_STOP" ? 14.0 :
                    x.Kind == "PREVIOUS_DAY_LOW_STOP" ||
                    x.Kind == "PREVIOUS_DAY_HIGH_STOP" ? 11.0 :
                    x.Kind == "LIQUIDITY_POOL_INVALIDATION" ? 12.0 :
                    x.Kind == "OB_INVALIDATION" ? 11.0 :
                    x.Kind == "FVG_INVALIDATION" ? 9.0 :
                    x.Kind == "HTF_STRUCTURE" ? 7.0 :
                    x.Kind == "STRUCTURAL_SWING_LOCK" ? 10.0 :
                    4.0;

                double utility =
                    x.Score * 0.72 +
                    riskBand +
                    proximityBonus +
                    clusterBonus +
                    timeframeBonus +
                    kindBonus;

                if (utility > bestUtility)
                {
                    bestUtility = utility;
                    best = x;
                }
            }

            return best;
        }

        private void AddSmartTargetMagnet(
            List<SmartLevel> list,
            double level,
            double referencePrice,
            double clearance,
            int direction,
            Bars[] frames,
            DateTime referenceTime,
            double atr,
            int timeframePriority,
            string sourceTimeframe,
            string kind,
            double baseScore)
        {
            if (list == null ||
                level <= 0 ||
                referencePrice <= 0 ||
                clearance <= 0 ||
                atr <= 0 ||
                direction == 0 ||
                list.Count >= SmartTargetMaxCandidates)
                return;

            bool directionallyValid = direction == 1
                ? level > referencePrice + clearance
                : level < referencePrice - clearance;

            if (!directionallyValid)
                return;

            int cluster = CountNearbySmartLevels(
                level,
                frames,
                referenceTime,
                direction,
                atr);

            double score =
                baseScore +
                cluster * (timeframePriority >= 11 ? 7.0 : 6.0);

            list.Add(new SmartLevel
            {
                Price = NormalizePrice(level),
                Score = Clamp(score, 0, 100),
                TimeframePriority = timeframePriority,
                Hits = Math.Max(1, cluster),
                AgeBars = 1,
                SourceTimeframe = sourceTimeframe,
                Kind = kind
            });
        }

        private List<SmartLevel> BuildSmartTargetCandidates(
            Bars executionBars,
            int executionIndex,
            int direction,
            double referencePrice,
            double atr)
        {
            DateTime reference = GetClosedBarReferenceTime(
                executionBars,
                executionIndex);

            return BuildSmartTargetCandidates(
                executionBars,
                executionIndex,
                direction,
                referencePrice,
                atr,
                reference);
        }

        private List<SmartLevel> BuildSmartTargetCandidates(
            Bars executionBars,
            int executionIndex,
            int direction,
            double referencePrice,
            double atr,
            DateTime referenceTime)
        {
            List<SmartLevel> list = new List<SmartLevel>();

            if (executionBars == null ||
                direction == 0 ||
                executionIndex < 30 ||
                referencePrice <= 0 ||
                atr <= 0)
                return list;

            Bars[] frames = UseHigherTfLiquidityTargets
                ? (UseMultiTfLevelMap
                    ? (SmartWeeklyContext
                        ? new Bars[] { executionBars, _m15, _m30, _h1, _h4, _d1, _w1 }
                        : new Bars[] { executionBars, _m15, _m30, _h1, _h4, _d1 })
                    : new Bars[] { executionBars, _m15, _h1 })
                : new Bars[] { executionBars, _m15, _m30 };

            int[] priority = { 5, 6, 7, 8, 9, 10, 11 };
            double clearance = Math.Max(
                Symbol.PipSize * 2.0,
                atr * Math.Max(0.03, TargetClearanceAtr));

            // Session-independent higher-timeframe magnets. The source candle must
            // already be closed, and the helper keeps side/clearance/cluster logic
            // identical across previous-day/week high/low/open/close levels.
            if (UseHigherTfLiquidityTargets && _d1 != null && _d1.Count >= 20)
            {
                int d1Index = GetLastClosedIndexBefore(_d1, referenceTime);
                if (d1Index >= 5)
                {
                    AddSmartTargetMagnet(
                        list, _d1.HighPrices[d1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        10, "D1", "PREVIOUS_DAY_HIGH", 78);

                    AddSmartTargetMagnet(
                        list, _d1.LowPrices[d1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        10, "D1", "PREVIOUS_DAY_LOW", 78);

                    AddSmartTargetMagnet(
                        list, _d1.OpenPrices[d1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        10, "D1", "PREVIOUS_DAY_OPEN", 71);

                    AddSmartTargetMagnet(
                        list, _d1.ClosePrices[d1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        10, "D1", "PREVIOUS_DAY_CLOSE", 73);
                }
            }

            if (UseHigherTfLiquidityTargets &&
                SmartWeeklyContext &&
                _w1 != null &&
                _w1.Count >= 20)
            {
                int w1Index = GetLastClosedIndexBefore(_w1, referenceTime);
                if (w1Index >= 5)
                {
                    AddSmartTargetMagnet(
                        list, _w1.HighPrices[w1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        11, "W1", "PREVIOUS_WEEK_HIGH", 84);

                    AddSmartTargetMagnet(
                        list, _w1.LowPrices[w1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        11, "W1", "PREVIOUS_WEEK_LOW", 84);

                    AddSmartTargetMagnet(
                        list, _w1.OpenPrices[w1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        11, "W1", "PREVIOUS_WEEK_OPEN", 73);

                    AddSmartTargetMagnet(
                        list, _w1.ClosePrices[w1Index], referencePrice, clearance,
                        direction, frames, referenceTime, atr,
                        11, "W1", "PREVIOUS_WEEK_CLOSE", 76);
                }
            }

            for (int f = 0;
                 f < frames.Length && list.Count < SmartTargetMaxCandidates;
                 f++)
            {
                Bars b = frames[f];
                if (b == null || b.Count < 50)
                    continue;

                int idx = ReferenceEquals(b, executionBars)
                    ? executionIndex
                    : GetLastClosedIndexBefore(b, referenceTime);

                if (idx < 30)
                    continue;

                int cursorLoops = 0;
                double cursor = referencePrice;

                while (cursorLoops++ < 10 &&
                       list.Count < SmartTargetMaxCandidates)
                {
                    double level = direction == 1
                        ? FindNearestSwingAbove(b, idx, cursor + clearance)
                        : FindNearestSwingBelow(b, idx, cursor - clearance);

                    if (level <= 0)
                        break;

                    double distance = direction == 1
                        ? level - referencePrice
                        : referencePrice - level;

                    if (distance <= clearance)
                        break;

                    int cluster = CountNearbySmartLevels(
                        level,
                        frames,
                        referenceTime,
                        direction,
                        atr);

                    double distanceAtr =
                        distance / Math.Max(atr, Symbol.PipSize);

                    // A level that has already been broken repeatedly is less useful
                    // as a first target. Keep range extremes as secondary magnets.
                    double rrReference = _signalInitialRisk > 0
                        ? distance / _signalInitialRisk
                        : distanceAtr;

                    double rrQuality =
                        Clamp(rrReference * 7.0, 0, 22);

                    double proximityQuality =
                        Clamp(24.0 - distanceAtr * 3.0, 0, 24);

                    double freshnessQuality =
                        Clamp(12.0 - cursorLoops * 0.8, 2, 12);

                    double score =
                        34.0 +
                        priority[f] * 2.0 +
                        cluster * 11.0 +
                        rrQuality +
                        proximityQuality +
                        freshnessQuality;

                    list.Add(new SmartLevel
                    {
                        Price = NormalizePrice(level),
                        Score = Clamp(score, 0, 100),
                        TimeframePriority = priority[f],
                        Hits = Math.Max(1, cluster),
                        AgeBars = cursorLoops,
                        SourceTimeframe = GetSmartTimeframeName(b),
                        Kind = cluster >= 2 ? "MTF_LIQUIDITY_CLUSTER" : "STRUCTURAL_SWING"
                    });

                    cursor = direction == 1
                        ? level + clearance
                        : level - clearance;
                }

                if (UseLiquidityForecast)
                {
                    double liquidityPool = direction == 1
                        ? FindEqualHighPool(b, idx, referencePrice, atr)
                        : FindEqualLowPool(b, idx, referencePrice, atr);

                    bool validPool = direction == 1
                        ? liquidityPool > referencePrice + clearance
                        : liquidityPool < referencePrice - clearance;

                    if (validPool)
                    {
                        int poolCluster = CountNearbySmartLevels(
                            liquidityPool,
                            frames,
                            referenceTime,
                            direction,
                            atr);

                        double poolScore =
                            64.0 +
                            priority[f] * 2.0 +
                            poolCluster * 9.0 +
                            SmartLiquidityPoolBonus +
                            8.0;

                        list.Add(new SmartLevel
                        {
                            Price = NormalizePrice(liquidityPool),
                            Score = Clamp(poolScore, 0, 100),
                            TimeframePriority = priority[f],
                            Hits = Math.Max(2, poolCluster + 1),
                            AgeBars = 0,
                            SourceTimeframe = GetSmartTimeframeName(b),
                            Kind = "LIQUIDITY_FORECAST"
                        });
                    }
                }

                AddSmartOpposingZoneCandidates(
                    b,
                    idx,
                    direction,
                    referencePrice,
                    atr,
                    clearance,
                    priority[f],
                    frames,
                    referenceTime,
                    list);
            }

            // The level map is a clustered map, not a raw list of every swing/zone.
            return ConsolidateSmartLevels(list, atr);
        }

        private void AddSmartOpposingZoneCandidates(
            Bars bars,
            int index,
            int direction,
            double referencePrice,
            double atr,
            double clearance,
            int timeframePriority,
            Bars[] frames,
            DateTime referenceTime,
            List<SmartLevel> list)
        {
            if (bars == null || index < 10 || atr <= 0 || list == null)
                return;

            int start = Math.Max(
                2,
                index - Math.Max(FvgLookback, ObLookback));

            int bestFvgAge = int.MaxValue;
            Zone bestFvg = null;

            int bestObAge = int.MaxValue;
            Zone bestOb = null;

            for (int i = index - 1; i >= start; i--)
            {
                int age = index - i;
                if (age > MaximumZoneAgeBars)
                    break;

                if (UseFvg && i >= 2)
                {
                    double gap = direction == 1
                        ? bars.LowPrices[i - 2] - bars.HighPrices[i]
                        : bars.LowPrices[i] - bars.HighPrices[i - 2];

                    if (gap >= atr * MinimumFvgAtr)
                    {
                        double low = direction == 1
                            ? bars.HighPrices[i]
                            : bars.HighPrices[i - 2];

                        double high = direction == 1
                            ? bars.LowPrices[i - 2]
                            : bars.LowPrices[i];

                        bool invalid = false;
                        for (int j = i + 1; j <= index; j++)
                        {
                            if ((direction == 1 && bars.ClosePrices[j] > high) ||
                                (direction == -1 && bars.ClosePrices[j] < low))
                            {
                                invalid = true;
                                break;
                            }
                        }

                        bool useful = direction == 1
                            ? low > referencePrice + clearance
                            : high < referencePrice - clearance;

                        if (!invalid &&
                            useful &&
                            age < bestFvgAge)
                        {
                            bestFvgAge = age;
                            bestFvg = new Zone
                            {
                                Low = low,
                                High = high
                            };
                        }
                    }
                }

                if (UseOrderBlock && i + 1 <= index)
                {
                    bool sourceCandle = direction == 1
                        ? bars.ClosePrices[i] > bars.OpenPrices[i]
                        : bars.ClosePrices[i] < bars.OpenPrices[i];

                    if (!sourceCandle)
                        continue;

                    int impulse = i + 1;
                    double body = Math.Abs(
                        bars.ClosePrices[impulse] -
                        bars.OpenPrices[impulse]);

                    bool displaced = direction == 1
                        ? bars.ClosePrices[impulse] < bars.LowPrices[i]
                        : bars.ClosePrices[impulse] > bars.HighPrices[i];

                    if (!displaced ||
                        (RequireObDisplacement &&
                         body < atr * ObDisplacementAtr))
                        continue;

                    double low = bars.LowPrices[i];
                    double high = bars.HighPrices[i];

                    bool invalid = false;
                    for (int j = impulse + 1; j <= index; j++)
                    {
                        if ((direction == 1 && bars.ClosePrices[j] > high) ||
                            (direction == -1 && bars.ClosePrices[j] < low))
                        {
                            invalid = true;
                            break;
                        }
                    }

                    bool useful = direction == 1
                        ? low > referencePrice + clearance
                        : high < referencePrice - clearance;

                    if (!invalid &&
                        useful &&
                        age < bestObAge)
                    {
                        bestObAge = age;
                        bestOb = new Zone
                        {
                            Low = low,
                            High = high
                        };
                    }
                }
            }

            if (bestFvg != null)
            {
                double[] boundaries =
                {
                    bestFvg.Low,
                    (bestFvg.Low + bestFvg.High) / 2.0,
                    bestFvg.High
                };

                foreach (double level in boundaries)
                {
                    double distance = direction == 1
                        ? level - referencePrice
                        : referencePrice - level;

                    if (distance <= clearance)
                        continue;

                    int cluster = CountNearbySmartLevels(
                        level,
                        frames,
                        referenceTime,
                        direction,
                        atr);

                    double score =
                        58.0 +
                        timeframePriority * 1.8 +
                        cluster * 8.0 +
                        Math.Max(0, 15.0 - bestFvgAge * 0.40);

                    list.Add(new SmartLevel
                    {
                        Price = NormalizePrice(level),
                        Score = Clamp(score, 0, 100),
                        TimeframePriority = timeframePriority,
                        Hits = Math.Max(1, cluster),
                        AgeBars = bestFvgAge,
                        SourceTimeframe = GetSmartTimeframeName(bars),
                        Kind = "OPPOSING_FVG"
                    });
                }
            }

            if (bestOb != null)
            {
                double[] boundaries =
                {
                    bestOb.Low,
                    (bestOb.Low + bestOb.High) / 2.0,
                    bestOb.High
                };

                foreach (double level in boundaries)
                {
                    double distance = direction == 1
                        ? level - referencePrice
                        : referencePrice - level;

                    if (distance <= clearance)
                        continue;

                    int cluster = CountNearbySmartLevels(
                        level,
                        frames,
                        referenceTime,
                        direction,
                        atr);

                    double score =
                        64.0 +
                        timeframePriority * 1.8 +
                        cluster * 8.5 +
                        Math.Max(0, 15.0 - bestObAge * 0.40);

                    list.Add(new SmartLevel
                    {
                        Price = NormalizePrice(level),
                        Score = Clamp(score, 0, 100),
                        TimeframePriority = timeframePriority,
                        Hits = Math.Max(1, cluster),
                        AgeBars = bestObAge,
                        SourceTimeframe = GetSmartTimeframeName(bars),
                        Kind = "OPPOSING_OB"
                    });
                }
            }
        }

        private List<double> SelectSmartTargetSequence(
            List<SmartLevel> candidates,
            double entry,
            double risk,
            int direction,
            double atr,
            bool liveUpdate)
        {
            List<double> selected = new List<double>();
            if (candidates == null ||
                risk <= 0 ||
                atr <= 0 ||
                entry <= 0 ||
                direction == 0)
                return selected;

            List<SmartLevel> usable = new List<SmartLevel>();

            foreach (SmartLevel c in candidates)
            {
                if (c == null ||
                    c.Price <= 0 ||
                    c.Score < SmartTargetQuality)
                    continue;

                if (RequireHtfTargets &&
                    c.TimeframePriority < 8)
                    continue;

                double distance = direction == 1
                    ? c.Price - entry
                    : entry - c.Price;

                if (distance <= Math.Max(Symbol.PipSize * 2.0, atr * 0.03))
                    continue;

                if (liveUpdate)
                {
                    double liveClearance = Math.Max(
                        Symbol.PipSize * 2.0,
                        atr * 0.04);

                    if (direction == 1 &&
                        c.Price <= Symbol.Bid + liveClearance)
                        continue;

                    if (direction == -1 &&
                        c.Price >= Symbol.Ask - liveClearance)
                        continue;
                }

                usable.Add(c);
            }

            if (usable.Count == 0)
                return selected;

            double spacing = Math.Max(
                Symbol.PipSize * 4.0,
                atr * Math.Max(0.08, MinimumTpSpacingAtr));

            double minimumTp1Rr = Math.Max(
                SmartTargetMinimumRR,
                UseRRFilter ? MinimumTradeRR : 0.75);

            double last = entry;

            for (int slot = 0; slot < 4; slot++)
            {
                SmartLevel best = null;
                double bestUtility = double.MinValue;

                // First choose the closest quality band. This prevents a distant
                // W1/HTF level from becoming TP1 merely because its raw score is high.
                double nearestDistance = double.MaxValue;
                foreach (SmartLevel c in usable)
                {
                    double distance = direction == 1
                        ? c.Price - entry
                        : entry - c.Price;

                    double fromLast = direction == 1
                        ? c.Price - last
                        : last - c.Price;

                    if (distance <= 0 || fromLast < spacing)
                        continue;

                    double rr = distance / risk;
                    double minimumSlotRR =
                        slot == 0
                            ? minimumTp1Rr
                            : Math.Max(
                                RequireHtfTargets
                                    ? Math.Max(1.50, MinimumHtfTargetRR)
                                    : 1.50,
                                minimumTp1Rr + slot * Math.Max(0.10, StructuralTpRrStep));

                    if (rr < minimumSlotRR)
                        continue;

                    nearestDistance = Math.Min(nearestDistance, distance);
                }

                if (nearestDistance == double.MaxValue)
                    break;

                double qualityBand = nearestDistance + atr * 1.35;

                foreach (SmartLevel c in usable)
                {
                    double distance = direction == 1
                        ? c.Price - entry
                        : entry - c.Price;

                    double fromLast = direction == 1
                        ? c.Price - last
                        : last - c.Price;

                    if (distance <= 0 ||
                        fromLast < spacing)
                        continue;

                    double rr = distance / risk;
                    double minimumSlotRR =
                        slot == 0
                            ? minimumTp1Rr
                            : Math.Max(
                                RequireHtfTargets
                                    ? Math.Max(1.50, MinimumHtfTargetRR)
                                    : 1.50,
                                minimumTp1Rr + slot * Math.Max(0.10, StructuralTpRrStep));

                    if (rr < minimumSlotRR)
                        continue;

                    // Do not skip the closest strong level for a much farther one.
                    if (slot == 0 && distance > qualityBand)
                        continue;

                    double distanceAtr =
                        distance / Math.Max(atr, Symbol.PipSize);

                    double nearestScore =
                        34.0 * Math.Exp(
                            -distanceAtr *
                            Math.Max(0.20, SmartTargetNearestBias));

                    double typeBonus =
                        c.Kind == "OPPOSING_OB" ? 20.0 :
                        c.Kind == "OPPOSING_FVG" ? 18.0 :
                        c.Kind == "LIQUIDITY_POOL" ? 20.0 :
                        c.Kind == "PREVIOUS_DAY_HIGH" ||
                        c.Kind == "PREVIOUS_DAY_LOW" ? 18.0 :
                        c.Kind == "PREVIOUS_WEEK_HIGH" ||
                        c.Kind == "PREVIOUS_WEEK_LOW" ? 22.0 :
                        c.Kind == "LIQUIDITY_FORECAST" ? 21.0 :
                        c.Kind == "PREVIOUS_DAY_OPEN" ||
                        c.Kind == "PREVIOUS_DAY_CLOSE" ? 15.0 :
                        c.Kind == "PREVIOUS_WEEK_OPEN" ||
                        c.Kind == "PREVIOUS_WEEK_CLOSE" ? 18.0 :
                        c.Kind == "MTF_LIQUIDITY_CLUSTER" ? 17.0 :
                        8.0;

                    double clusterBonus =
                        Math.Min(18.0, c.Hits * 8.0);

                    double rrBonus =
                        slot == 0
                            ? Math.Min(10.0, rr * 2.0)
                            : Math.Min(16.0, rr * 2.5);

                    double freshnessBonus =
                        Math.Max(
                            0,
                            8.0 - c.AgeBars * 0.35);

                    bool alreadySelected = false;
                    foreach (double existing in selected)
                    {
                        if (Math.Abs(existing - NormalizePrice(c.Price)) <= spacing * 0.50)
                        {
                            alreadySelected = true;
                            break;
                        }
                    }

                    if (alreadySelected)
                        continue;

                    bool pathObstacle =
                        _m5 != null &&
                        HasSmartTargetObstacle(_m5, Math.Max(1, _m5.Count - 1), direction, entry, c.Price, atr);

                    if (slot == 0 && RequireObstacleFreeTp1 && pathObstacle)
                        continue;

                    double obstaclePenalty = pathObstacle ? Math.Min(28.0, 12.0 + TargetObstacleBufferAtr * 40.0) : 0.0;

                    double utility =
                        c.Score * 0.68 +
                        nearestScore +
                        typeBonus +
                        clusterBonus +
                        rrBonus +
                        freshnessBonus -
                        obstaclePenalty;

                    if (slot > 0)
                        utility += Math.Min(8.0, rr * 1.5);

                    if (utility > bestUtility)
                    {
                        bestUtility = utility;
                        best = c;
                    }
                }

                if (best == null)
                    break;

                double chosen = NormalizePrice(best.Price);
                bool duplicate = false;

                foreach (double existing in selected)
                {
                    if (Math.Abs(existing - chosen) <= spacing * 0.50)
                    {
                        duplicate = true;
                        break;
                    }
                }

                // A duplicate/clustered level must not terminate the entire
                // target ladder. Continue searching for the next structural
                // level so TP2/TP3/TP4 can still be populated.
                if (duplicate)
                {
                    usable.Remove(best);
                    continue;
                }

                selected.Add(chosen);
                last = chosen;
            }

            return selected;
        }

        private bool HasSmartTargetObstacle(
            Bars executionBars,
            int executionIndex,
            int direction,
            double entry,
            double target,
            double atr)
        {
            if (executionBars == null ||
                executionIndex < 20 ||                direction == 0 ||
                entry <= 0 ||
                target <= 0 ||
                atr <= 0)
                return false;

            double clearance = Math.Max(
                Symbol.PipSize * 2.0,
                atr * Math.Max(0.03, TargetClearanceAtr));

            List<SmartLevel> levels =
                BuildSmartTargetCandidates(
                    executionBars,
                    executionIndex,
                    direction,
                    entry,
                    atr);

            foreach (SmartLevel level in levels)
            {
                if (level == null)
                    continue;

                double distance = direction == 1
                    ? level.Price - entry
                    : entry - level.Price;

                double targetDistance = direction == 1
                    ? target - entry
                    : entry - target;

                if (distance <= 0 ||
                    distance >= targetDistance - clearance)
                    continue;

                // Raw structural swings are target candidates, not automatic
                // obstacles. Only opposing zones/liquidity magnets can veto a TP.
                bool structuralObstacle =
                    level.Kind == "OPPOSING_FVG" ||
                    level.Kind == "OPPOSING_OB" ||
                    level.Kind == "LIQUIDITY_FORECAST" ||
                    level.Kind == "LIQUIDITY_POOL" ||
                    level.Kind == "PREVIOUS_DAY_HIGH" ||
                    level.Kind == "PREVIOUS_DAY_LOW" ||
                    level.Kind == "PREVIOUS_WEEK_HIGH" ||
                    level.Kind == "PREVIOUS_WEEK_LOW";

                if (structuralObstacle &&
                    level.Score >= SmartTargetQuality + 8)
                    return true;
            }

            return false;
        }

        private int CountNearbySmartLevels(double price, Bars[] frames, DateTime referenceTime, int direction, double atr)
        {
            if (frames == null || price <= 0 || atr <= 0) return 0;
            double tolerance = Math.Max(Symbol.PipSize * 2.0, atr * Math.Max(0.02, SmartLevelClusterAtr));
            int hits = 0;
            foreach (Bars b in frames)
            {
                if (b == null || b.Count < 40) continue;
                int idx = GetLastClosedIndexBefore(b, referenceTime);
                if (idx < 25) continue;
                double level = direction == 1 ? FindNearestSwingAbove(b, idx, price - tolerance) : FindNearestSwingBelow(b, idx, price + tolerance);
                if (level > 0 && Math.Abs(level - price) <= tolerance)
                    hits++;
            }
            return Math.Min(6, hits);
        }

        private double FindEqualHighPool(Bars bars, int index, double entry, double atr)
        {
            if (bars == null || index < 20 || atr <= 0)
                return 0;
            double tolerance = Math.Max(Symbol.PipSize * 2.0, atr * 0.08);
            int start = Math.Max(SwingStrength, index - Math.Max(LiquidityLookback, 80));
            int last = Math.Max(start, index - SwingStrength);
            double best = 0;
            int bestHits = 0;
            for (int i = start; i <= last; i++)
            {
                double h = bars.HighPrices[i];
                if (h <= entry) continue;
                int hits = 0;
                for (int j = start; j <= last; j++)
                    if (Math.Abs(bars.HighPrices[j] - h) <= tolerance) hits++;
                if (hits >= 2 && (hits > bestHits || (hits == bestHits && (best == 0 || h < best))))
                { best = h; bestHits = hits; }
            }
            return best;
        }

        private double FindEqualLowPool(Bars bars, int index, double entry, double atr)
        {
            if (bars == null || index < 20 || atr <= 0)
                return 0;
            double tolerance = Math.Max(Symbol.PipSize * 2.0, atr * 0.08);
            int start = Math.Max(SwingStrength, index - Math.Max(LiquidityLookback, 80));
            int last = Math.Max(start, index - SwingStrength);
            double best = 0;
            int bestHits = 0;
            for (int i = start; i <= last; i++)
            {
                double l = bars.LowPrices[i];
                if (l >= entry) continue;
                int hits = 0;
                for (int j = start; j <= last; j++)
                    if (Math.Abs(bars.LowPrices[j] - l) <= tolerance) hits++;
                if (hits >= 2 && (hits > bestHits || (hits == bestHits && (best == 0 || l > best))))
                { best = l; bestHits = hits; }
            }
            return best;
        }

        private double FindSmartStructuralStopLevel(Bars bars, int index, double market, double atr)
        {
            if (!EnableSmartDecisionEngine ||
                bars == null ||
                index < 30 ||
                atr <= 0 ||
                _signalDirection == 0)
                return 0;

            int liveBar = _m5 != null ? Math.Max(1, _m5.Count - 1) : index;
            double recalcDistance = Math.Max(Symbol.PipSize * 4.0, atr * 0.12);

            if (_lastSmartStructuralStopCalcM5Bar == liveBar &&
                Math.Abs(market - _lastSmartStructuralStopCalcPrice) < recalcDistance &&
                _cachedSmartStructuralStop > 0)
            {
                if ((_signalDirection == 1 && _cachedSmartStructuralStop > _signalSl) ||
                    (_signalDirection == -1 && _cachedSmartStructuralStop < _signalSl))
                    return _cachedSmartStructuralStop;
            }

            DateTime reference = GetClosedBarReferenceTime(bars, index);
            List<SmartLevel> candidates =
                BuildSmartStopCandidates(
                    bars,
                    index,
                    _signalDirection,
                    _signalEntry,
                    atr,
                    reference);

            if (UseSwingStructureInTrail)
            {
                double swing = _signalDirection == 1
                    ? FindNearestStructuralSwingBelow(bars, index, market)
                    : FindNearestStructuralSwingAbove(bars, index, market);

                if (swing > 0)
                {
                    double microBuffer = Math.Max(
                        Symbol.PipSize * 2.0,
                        atr * 0.02);

                    double swingStop = _signalDirection == 1
                        ? swing - microBuffer
                        : swing + microBuffer;

                    if ((_signalDirection == 1 && swingStop > _signalSl && swingStop < market) ||
                        (_signalDirection == -1 && swingStop < _signalSl && swingStop > market))
                    {
                        candidates.Add(new SmartLevel
                        {
                            Price = NormalizePrice(swingStop),
                            Score = 74,
                            TimeframePriority = 5,
                            Hits = 2,
                            AgeBars = 0,
                            SourceTimeframe = "M5",
                            Kind = "STRUCTURAL_SWING_LOCK"
                        });
                    }
                }
            }

            candidates = ConsolidateSmartLevels(candidates, atr);

            SmartLevel best = null;
            double bestUtility = double.MinValue;

            foreach (SmartLevel c in candidates)
            {
                if (c == null ||
                    c.Price <= 0 ||
                    c.Score < SmartStopQuality)
                    continue;

                if (_signalDirection == 1)
                {
                    if (c.Price <= _signalSl || c.Price >= market)
                        continue;
                }
                else
                {
                    if (c.Price >= _signalSl || c.Price <= market)
                        continue;
                }

                double distanceAtr =
                    Math.Abs(market - c.Price) /
                    Math.Max(atr, Symbol.PipSize);

                double proximity =
                    22.0 *
                    Math.Exp(-distanceAtr * 0.85);

                double clusterBonus =
                    Math.Min(12.0, c.Hits * 3.0);

                double timeframeBonus =
                    Math.Min(10.0, c.TimeframePriority * 0.8);

                double utility =
                    c.Score * 0.75 +
                    proximity +
                    clusterBonus +
                    timeframeBonus;

                if (utility > bestUtility)
                {
                    bestUtility = utility;
                    best = c;
                }
            }

            if (best == null)
            {
                _lastSmartStructuralStopCalcM5Bar = liveBar;
                _lastSmartStructuralStopCalcPrice = market;
                _cachedSmartStructuralStop = 0;
                return 0;
            }

            // Candidate prices already contain a structure-aware invalidation
            // buffer. Add only a tiny execution-side buffer here.
            double buffer = Math.Max(
                Symbol.PipSize * 2.0,
                atr * 0.02);

            double stop = _signalDirection == 1
                ? best.Price - buffer
                : best.Price + buffer;

            double spreadBuffer =
                Math.Max(
                    Symbol.PipSize * 2.0,
                    Symbol.Ask - Symbol.Bid);

            if (_signalDirection == 1)
                stop = Math.Min(stop, market - spreadBuffer);
            else
                stop = Math.Max(stop, market + spreadBuffer);

            bool valid = _signalDirection == 1
                ? stop > _signalSl && stop < market
                : stop < _signalSl && stop > market;

            _lastSmartStructuralStopCalcM5Bar = liveBar;
            _lastSmartStructuralStopCalcPrice = market;

            if (!valid)
            {
                _cachedSmartStructuralStop = 0;
                return 0;
            }

            _cachedSmartStructuralStop = NormalizePrice(stop);
            return _cachedSmartStructuralStop;
        }

        private double CalculateSmartExitPressure(double market, double currentRR)
        {
            double pressure = 0;
            if (currentRR <= -0.75) pressure += 38;
            else if (currentRR <= -0.35) pressure += 24;
            else if (currentRR < 0) pressure += 12;

            if (_liveReactionDirection != 0 && _liveReactionDirection != _signalDirection)
            {
                pressure += _liveReactionConfidence >= LiveReactionStrongThreshold ? 28 : 16;
            }

            int i = -1;
            Analysis a = null;
            Analysis a15 = null;

            if (_m5 != null && _m5.Count >= 50)
            {
                DateTime referenceTime = _m5.OpenTimes[Math.Max(1, _m5.Count - 1)];
                i = GetLastClosedIndexBefore(_m5, referenceTime);
                if (i >= 1)
                    a = GetCachedClosedAnalysis(_m5, i);

                if (_m15 != null && _m15.Count >= 50)
                {
                    int i15 = GetLastClosedIndexBefore(_m15, referenceTime);
                    if (i15 >= 1)
                        a15 = GetCachedClosedAnalysis(_m15, i15);
                }

                if (a != null)
                {
                    bool oppositeStructure = _signalDirection == 1
                        ? (a.MssBear || a.ChochBear || a.LiquidityBear)
                        : (a.MssBull || a.ChochBull || a.LiquidityBull);
                    if (oppositeStructure) pressure += 18;

                    if (a.Choppy) pressure += 8;
                }

                if (a15 != null)
                {
                    bool opposite15 = a15.Direction == -_signalDirection;
                    if (opposite15) pressure += 12;
                }

                if (i >= Math.Max(RsiPeriod, AdxPeriod * 2))
                {
                    double rsi = GetRsi(_m5, i, RsiPeriod);
                    if ((_signalDirection == 1 && rsi >= 73) || (_signalDirection == -1 && rsi <= 27))
                        pressure += 8;

                    double adxNow = GetAdx(_m5, i, AdxPeriod);
                    double adxPast = GetAdx(_m5, Math.Max(AdxPeriod * 2, i - 4), AdxPeriod);
                    if (adxPast > 0 && adxNow < adxPast * 0.82)
                        pressure += 7;
                }
            }

            if (_signalTp1 > 0 && _signalInitialRisk > 0)
            {
                double targetDistance = _signalDirection == 1 ? _signalTp1 - market : market - _signalTp1;
                double exitAtr = i >= 1
                    ? GetAtr(_m5, i, AtrPeriod)
                    : 0;

                if (targetDistance > 0 &&
                    exitAtr > 0 &&
                    targetDistance <= Math.Max(Symbol.PipSize * 2.0, exitAtr * 0.20))
                    pressure += 6;
            }

            return Clamp(pressure, 0, 100);
        }

        private int CalculateStructuralSequenceQuality(Bars bars, int index, int direction)
        {
            if (bars == null || direction == 0 || index < 30 || index >= bars.Count)
                return 0;

            int sweepIndex = -1;
            int structureIndex = -1;
            int displacementIndex = -1;
            int lookback = Math.Max(3, MaximumSetupAgeBars);

            for (int i = index; i >= Math.Max(5, index - lookback); i--)
            {
                bool sweep = direction == 1
                    ? HasBullLiquiditySweep(bars, i)
                    : HasBearLiquiditySweep(bars, i);
                bool structure = direction == 1
                    ? (HasBullMss(bars, i) || HasBullChoch(bars, i))
                    : (HasBearMss(bars, i) || HasBearChoch(bars, i));
                bool displacement = direction == 1
                    ? HasBullDisplacement(bars, i)
                    : HasBearDisplacement(bars, i);

                if (displacement && displacementIndex < 0)
                    displacementIndex = i;
                if (structure && structureIndex < 0)
                    structureIndex = i;
                if (sweep && sweepIndex < 0)
                    sweepIndex = i;
            }

            int score = 0;
            if (sweepIndex >= 0) score += 25;
            if (structureIndex >= 0) score += 25;
            if (displacementIndex >= 0) score += 25;

            // The sequence must be chronological: liquidity event -> structural
            // confirmation -> displacement. Same-bar confluence is allowed.
            if (sweepIndex >= 0 && structureIndex >= 0 && sweepIndex <= structureIndex)
                score += 8;
            if (structureIndex >= 0 && displacementIndex >= 0 && structureIndex <= displacementIndex)
                score += 8;

            // Freshness matters. A setup that required too many bars to confirm is
            // materially less actionable than a fresh one.
            int newest = Math.Max(sweepIndex, Math.Max(structureIndex, displacementIndex));
            if (newest >= 0)
            {
                int age = index - newest;
                if (age <= 1) score += 9;
                else if (age <= 3) score += 6;
                else if (age <= MaximumSetupAgeBars) score += 2;
            }

            bool zone = direction == 1
                ? HasBullFvg(bars, index) || HasBullOb(bars, index)
                : HasBearFvg(bars, index) || HasBearOb(bars, index);
            if (zone) score += 10;

            bool retest = direction == 1
                ? IsPriceNearRecentBullishZone(bars, index, atrOverride: 0)
                : IsPriceNearRecentBearishZone(bars, index, atrOverride: 0);
            if (retest) score += 10;

            return (int)Clamp(score, 0, 100);
        }

        private bool IsPriceNearRecentBullishZone(Bars bars, int index, double atrOverride)
        {
            if (bars == null || index < 10 || index >= bars.Count) return false;
            double atr = atrOverride > 0 ? atrOverride : GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            int start = Math.Max(2, index - Math.Max(FvgLookback, ObLookback));
            double price = Symbol.Ask > 0 ? Symbol.Ask : bars.ClosePrices[index];
            double tolerance = atr * Math.Max(0.05, EntryZoneProximityAtr);
            for (int i = index - 1; i >= start; i--)
            {
                if (UseFvg && i >= 2)
                {
                    double gap = bars.LowPrices[i] - bars.HighPrices[i - 2];
                    if (gap >= atr * MinimumFvgAtr)
                    {
                        double low = bars.HighPrices[i - 2], high = bars.LowPrices[i];
                        bool invalid = false;
                        for (int j = i + 1; j <= index; j++)
                            if (bars.ClosePrices[j] < low) { invalid = true; break; }
                        if (!invalid && price >= low - tolerance && price <= high + tolerance) return true;
                    }
                }
                if (UseOrderBlock && i + 1 <= index)
                {
                    bool source = bars.ClosePrices[i] < bars.OpenPrices[i];
                    bool displaced = bars.ClosePrices[i + 1] > bars.HighPrices[i];
                    double body = Math.Abs(bars.ClosePrices[i + 1] - bars.OpenPrices[i + 1]);
                    if (source && displaced && (!RequireObDisplacement || body >= atr * ObDisplacementAtr))
                    {
                        double low = bars.LowPrices[i], high = bars.HighPrices[i];
                        bool invalid = false;
                        for (int j = i + 1; j <= index; j++)
                            if (bars.ClosePrices[j] < low) { invalid = true; break; }
                        if (!invalid && price >= low - tolerance && price <= high + tolerance) return true;
                    }
                }
            }
            return false;
        }

        private bool IsPriceNearRecentBearishZone(Bars bars, int index, double atrOverride)
        {
            if (bars == null || index < 10 || index >= bars.Count) return false;
            double atr = atrOverride > 0 ? atrOverride : GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return false;
            int start = Math.Max(2, index - Math.Max(FvgLookback, ObLookback));
            double price = Symbol.Bid > 0 ? Symbol.Bid : bars.ClosePrices[index];
            double tolerance = atr * Math.Max(0.05, EntryZoneProximityAtr);
            for (int i = index - 1; i >= start; i--)
            {
                if (UseFvg && i >= 2)
                {
                    double gap = bars.LowPrices[i - 2] - bars.HighPrices[i];
                    if (gap >= atr * MinimumFvgAtr)
                    {
                        double low = bars.HighPrices[i], high = bars.LowPrices[i - 2];
                        bool invalid = false;
                        for (int j = i + 1; j <= index; j++)
                            if (bars.ClosePrices[j] > high) { invalid = true; break; }
                        if (!invalid && price >= low - tolerance && price <= high + tolerance) return true;
                    }
                }
                if (UseOrderBlock && i + 1 <= index)
                {
                    bool source = bars.ClosePrices[i] > bars.OpenPrices[i];
                    bool displaced = bars.ClosePrices[i + 1] < bars.LowPrices[i];
                    double body = Math.Abs(bars.ClosePrices[i + 1] - bars.OpenPrices[i + 1]);
                    if (source && displaced && (!RequireObDisplacement || body >= atr * ObDisplacementAtr))
                    {
                        double low = bars.LowPrices[i], high = bars.HighPrices[i];
                        bool invalid = false;
                        for (int j = i + 1; j <= index; j++)
                            if (bars.ClosePrices[j] > high) { invalid = true; break; }
                        if (!invalid && price >= low - tolerance && price <= high + tolerance) return true;
                    }
                }
            }
            return false;
        }

        private int CalculateEntryLocationQuality(Bars bars, int index, int direction)
        {
            if (bars == null || direction == 0 || index < 25 || index >= bars.Count) return 0;
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0) return 0;
            double price = direction == 1 ? Symbol.Ask : Symbol.Bid;
            if (price <= 0) price = bars.ClosePrices[index];
            int score = 0;
            bool zone = direction == 1
                ? IsPriceNearRecentBullishZone(bars, index, atr)
                : IsPriceNearRecentBearishZone(bars, index, atr);
            if (zone) score += 45;

            double high = HighestHigh(bars, Math.Max(0, index - StructureLookback), index);
            double low = LowestLow(bars, Math.Max(0, index - StructureLookback), index);
            double range = high - low;
            if (range > atr)
            {
                double position = (price - low) / range;
                bool locationAligned = direction == 1
                    ? position <= 0.50
                    : position >= 0.50;
                if (UsePremiumDiscount && locationAligned) score += 25;
                else if (!UsePremiumDiscount) score += 15;
            }

            double extension = Math.Abs(price - bars.ClosePrices[index]) / Math.Max(atr, Symbol.PipSize);
            if (extension <= MaximumEntryExtensionAtr * 0.50) score += 20;
            else if (extension <= MaximumEntryExtensionAtr) score += 10;

            bool microBreak = direction == 1
                ? price > bars.HighPrices[Math.Max(0, index - 1)]
                : price < bars.LowPrices[Math.Max(0, index - 1)];
            if (microBreak) score += 10;
            return (int)Clamp(score, 0, 100);
        }

        private double CalculateProxyExpectedValue(int quality, double rr)
        {
            if (quality <= 0 || rr <= 0)
                return -1.0;

            double probability = 0.42 + Clamp(quality, 0, 100) * 0.0042;
            probability = Clamp(probability, 0.42, 0.84);

            // Once enough closed outcomes exist for the current direction/regime,
            // replace the synthetic prior with a conservatively shrunk empirical
            // estimate. Until then, keep the prior so the first signals are not
            // overfit to a tiny sample.
            if (UseEmpiricalCalibration &&
                EnableOutcomeTelemetry &&
                _signalDirection != 0)
            {
                int samples;
                double empirical = GetEmpiricalWinRate(
                    _signalDirection,
                    _smartRegime,
                    out samples);

                if (samples >= Math.Max(5, CalibrationDirectionalMinimumSamples))
                    probability = Clamp(empirical, 0.35, 0.80);
            }

            return probability * rr - (1.0 - probability);
        }

        private double CalculateAdaptiveMinimumRR()
        {
            double baseRR = Math.Max(SmartTargetMinimumRR, UseRRFilter ? MinimumTradeRR : 0.0);
            if (!AdaptiveStructuralRR) return baseRR;
            if (_smartRegimeQuality >= 82) return baseRR;
            if (_smartRegimeQuality >= 70) return baseRR + 0.15;
            if (_smartRegimeQuality >= 60) return baseRR + 0.30;
            return baseRR + 0.50;
        }

        private bool HasSmartEntryQuality(int index, int direction)
        {
            return HasSmartEntryQuality(Bars, index, direction);
        }

        private bool HasSmartEntryQuality(
            Bars bars,
            int index,
            int direction)
        {
            if (bars == null ||
                index < 25 ||
                index >= bars.Count ||
                direction == 0)
                return false;

            // Use the same independent execution-geometry model as Smart Decision.
            // This prevents the entry gate from rebuilding Trend/RSI/ADX evidence
            // that has already been counted in the MTF Analysis layer.
            double quality =
                CalculateSmartEntryQuality(
                    bars,
                    index,
                    direction);

            _smartStructuralSequence = CalculateStructuralSequenceQuality(bars, index, direction);
            _smartEntryLocationQuality = CalculateEntryLocationQuality(bars, index, direction);
            _smartEntryGateReason = "";

            if (quality < SmartQualityThreshold)
            {
                _smartEntryGateReason = "EXECUTION_QUALITY";
                return false;
            }

            bool strongDirectOverride = AllowDirectDisplacementOverride &&
                _smartStructuralSequence >= DirectDisplacementOverrideScore &&
                quality >= Math.Max(85, SmartQualityThreshold + 10) &&
                (direction == 1 ? HasBullDisplacement(bars, index) : HasBearDisplacement(bars, index));

            if (UseStructuralSequenceGate &&
                _smartStructuralSequence < MinimumStructuralSequence &&
                !strongDirectOverride)
            {
                _smartEntryGateReason = "STRUCTURAL_SEQUENCE";
                return false;
            }

            if (RequireEntryLocationConfluence &&
                _smartEntryLocationQuality < MinimumEntryLocationQuality &&
                !strongDirectOverride)
            {
                _smartEntryGateReason = "ENTRY_LOCATION";
                return false;
            }

            if (AvoidRsiExhaustion)
            {
                double rsi = GetRsi(bars, index, RsiPeriod);
                bool exhausted = direction == 1
                    ? rsi >= 75
                    : rsi <= 25;

                if (exhausted)
                    return false;
            }

            // EMA slope is an execution-timing gate, not another scoring family.
            if (UseEmaSlopeConfirmation)
            {
                double fast = GetEma(bars, index, FastEma);
                double fastPast = GetEma(
                    bars,
                    Math.Max(0, index - 3),
                    FastEma);

                bool slopeAligned = direction == 1
                    ? fast > fastPast
                    : fast < fastPast;

                if (!slopeAligned)
                    return false;
            }

            return true;
        }

