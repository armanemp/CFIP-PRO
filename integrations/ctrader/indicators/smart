        private int GetSmartEdge()
        {
            return _smartDecision == null
                ? 0
                : Math.Abs(_smartDecision.BuyShare - _smartDecision.SellShare);
        }

        private void EvaluateEngine(int chartIndex)
        {
            // The engine runs on the M5 clock, not the host chart clock. This
            // prevents an M15/H1 attachment from missing intermediate M5
            // triggers or freezing early setup decisions for an entire HTF bar.
            int m5LiveIndex = Math.Max(1, _m5.Count - 1);
            DateTime referenceTime = _m5.OpenTimes[m5LiveIndex];

            int m5Index =
                GetLastClosedIndexBefore(_m5, referenceTime);

            int m15Index =
                GetLastClosedIndexBefore(_m15, referenceTime);

            int m30Index =
                GetLastClosedIndexBefore(_m30, referenceTime);

            int h1Index =
                GetLastClosedIndexBefore(_h1, referenceTime);

            int h4Index =
                GetLastClosedIndexBefore(_h4, referenceTime);

            if (m5Index < 50 ||
                m15Index < 50)
            {
                DrawStatus(
                    "CFIP MTF INTELLIGENCE\n" +
                    "WAITING FOR M5 / M15 DATA");

                return;
            }

            Analysis m5 =
                GetCachedClosedAnalysis(_m5, m5Index);

            Analysis m15 =
                GetCachedClosedAnalysis(_m15, m15Index);

            Analysis m30 =
                GetCachedClosedAnalysis(_m30, m30Index);

            Analysis h1 =
                GetCachedClosedAnalysis(_h1, h1Index);

            Analysis h4 =
                GetCachedClosedAnalysis(_h4, h4Index);

            if (m5 == null || m15 == null)
                return;

            if (!_directionalBiasBootstrapped)
            {
                BootstrapDirectionalBias(m5, m15, m5Index, m5LiveIndex);
                _directionalBiasBootstrapped = true;
            }
            else
            {
                UpdateDirectionalBias(m5, m15, m5LiveIndex);
            }

            bool sessionOk = IsSessionAllowed(referenceTime);
            bool spreadOk = IsSpreadAllowed(_m5, Math.Max(1, m5Index));
            bool fridayOk = IsFridayAllowed(referenceTime);
            bool newsBlocked = IsNewsEventBlocked(
                referenceTime,
                _m5,
                Math.Max(1, m5Index),
                out string newsRestrictionReason);
            bool regimeBlocked = IsRegimeNoTradeBlocked(out string regimeRestrictionReason);
            bool newsOk = !newsBlocked;
            bool regimeOk = !regimeBlocked;

            // Dedicated restriction alerts: every independent gate gets an explicit reason.
            // News/event restrictions always have highest priority.
            List<string> restrictions = new List<string>();
            if (!sessionOk && AlertOnSessionBlock) restrictions.Add("SESSION CLOSED");
            if (!spreadOk && AlertOnSpreadBlock) restrictions.Add("SPREAD TOO WIDE");
            if (!fridayOk && AlertOnFridayBlock) restrictions.Add("FRIDAY CUTOFF");
            if (regimeBlocked && AlertOnRegimeNoTrade) restrictions.Add(regimeRestrictionReason);

            bool cooldownBlocked = !IsCooldownAllowed(m5LiveIndex);
            if (cooldownBlocked && AlertOnCooldownBlock) restrictions.Add("COOLDOWN ACTIVE");

            // Backward-compatible master switch: if the user enables the generic
            // restriction alert but disables every specialized reason, still emit
            // one useful generic block notification.
            bool anyRestriction = !sessionOk || !spreadOk || !fridayOk || regimeBlocked || cooldownBlocked;
            if (AlertOnEntryRestriction && restrictions.Count == 0 && anyRestriction)
                restrictions.Add("ENTRY RESTRICTION ACTIVE");

            if (!AlertOnEntryRestriction && !ShowEntryRestrictionPopup)
                restrictions.Clear();

            string restrictionSignature =
                (newsBlocked ? "NEWS:" + newsRestrictionReason + "|" : "") +
                string.Join("|", restrictions);

            if (newsBlocked && AlertOnNewsEventGuard)
            {
                if (_lastRestrictionAlertM5Bar != m5LiveIndex ||
                    _lastRestrictionSignature != restrictionSignature)
                {
                    _lastRestrictionAlertBar = m5LiveIndex;
                    _lastRestrictionAlertM5Bar = m5LiveIndex;
                    _lastRestrictionSignature = restrictionSignature;
                    QueueRestrictionDecisionAlert(
                        "NEWS / EVENT GUARD | ENTRY BLOCKED | " + SymbolName +
                        " | " + newsRestrictionReason +
                        " | M5 " + referenceTime.ToString("HH:mm"),
                        0,
                        m5LiveIndex);
                }
            }
            else if (restrictions.Count > 0)
            {
                if (_lastRestrictionAlertM5Bar != m5LiveIndex ||
                    _lastRestrictionSignature != restrictionSignature)
                {
                    _lastRestrictionAlertBar = m5LiveIndex;
                    _lastRestrictionAlertM5Bar = m5LiveIndex;
                    _lastRestrictionSignature = restrictionSignature;
                    QueueRestrictionDecisionAlert(
                        "ENTRY RESTRICTION | NEW ENTRY BLOCKED | " + SymbolName +
                        " | " + string.Join(" + ", restrictions),
                        0,
                        m5LiveIndex);
                }
            }

            // Context alerts are emitted once per closed M5 decision bar.
            if (_lastContextAlertBar != m5LiveIndex)
            {
                SendContextAlerts(m5, m15, chartIndex, m5LiveIndex);
                _lastContextAlertBar = m5LiveIndex;
            }

            // ========================================================
            // EARLY PREDICTION / SETUP
            // ========================================================

            if (EnableEarlyPrediction)
            {
                // Early levels are an M5 snapshot. Recalculate only when a new M5
                // decision bar appears; otherwise Ask/Bid ticks would
                // continuously move Entry/SL/TP and make the setup unstable.
                if (_predictionBar != m5LiveIndex)
                {
                    EvaluateEarlyPrediction(
                        chartIndex,
                        m5LiveIndex,
                        m5Index,
                        m5,
                        m15,
                        m30,
                        h1,
                        h4);

                    if (_predictionDirection != 0 &&
                        _predictionConfidence >= MinimumEarlyConfidence &&
                        _lastPredictionAlertBar != m5LiveIndex &&
                        AlertOnEarlySetup)
                    {
                        QueueEarlyDecisionAlert(
                            (_predictionDirection == 1 ? "EARLY BUY SETUP" : "EARLY SELL SETUP") +
                            " | Q " + _predictionConfidence + " | WATCH ONLY",
                            _predictionDirection,
                            m5LiveIndex);
                        _lastPredictionAlertBar = m5LiveIndex;
                    }
                }
            }
            else
            {
                ClearEarlyObjects();
                _predictionDirection = 0;
            }

            // ========================================================
            // LIVE TRIGGER
            // ========================================================

            // Confirmed execution is always driven by the closed M5 structure.
            // The chart may be used for context, but the trigger engine itself
            // never falls back to M15/H1 execution timing.
            int triggerIndex = UseM5Trigger ? m5Index : m15Index;
            Bars triggerBars = UseM5Trigger ? _m5 : _m15;
            int bullLive = triggerBars != null && triggerIndex >= 20
                ? LiveBullTriggerScore(triggerBars, triggerIndex)
                : 0;

            int bearLive = triggerBars != null && triggerIndex >= 20
                ? LiveBearTriggerScore(triggerBars, triggerIndex)
                : 0;

            bool coreBull;
            bool coreBear;

            bool m5BullStable = !RequireStableM5Direction ||
                HasStableSimpleDirection(_m5, m5Index, 1, StableM5Bars);
            bool m5BearStable = !RequireStableM5Direction ||
                HasStableSimpleDirection(_m5, m5Index, -1, StableM5Bars);
            bool m15BullStable = !RequireStableM15Direction ||
                HasStableSimpleDirection(_m15, m15Index, 1, StableM15Bars);
            bool m15BearStable = !RequireStableM15Direction ||
                HasStableSimpleDirection(_m15, m15Index, -1, StableM15Bars);

            if (RequireCoreAgreement)
            {
                bool m5BullComponent =
                    !UseM5Trigger ||
                    (m5.Direction == 1 && m5BullStable) ||
                    (AllowStrongM5TriggerOverride && bullLive >= PrecisionTriggerScore && m5.Direction == 0);
                bool m5BearComponent =
                    !UseM5Trigger ||
                    (m5.Direction == -1 && m5BearStable) ||
                    (AllowStrongM5TriggerOverride && bearLive >= PrecisionTriggerScore && m5.Direction == 0);

                coreBull =
                    m5BullComponent &&
                    (m15.Direction == 1 ||
                     (AllowM15NeutralPullback && m15.Direction == 0 && m15BullStable));

                coreBear =
                    m5BearComponent &&
                    (m15.Direction == -1 ||
                     (AllowM15NeutralPullback && m15.Direction == 0 && m15BearStable));
            }
            else
            {
                coreBull =
                    !UseM5Trigger ||
                    (m5.Direction == 1 && m5BullStable) ||
                    (AllowStrongM5TriggerOverride && bullLive >= PrecisionTriggerScore && m5.Direction == 0);
                coreBear =
                    !UseM5Trigger ||
                    (m5.Direction == -1 && m5BearStable) ||
                    (AllowStrongM5TriggerOverride && bearLive >= PrecisionTriggerScore && m5.Direction == 0);
            }

            int bullScore = 0;
            int bearScore = 0;

            if (EnableSmartDecisionEngine &&
                _smartDecision != null)
            {
                // Smart Decision is the single authoritative scoring layer.
                // The main engine only consumes it; it does not rebuild the same
                // evidence again from Analysis flags.
                bullScore = Math.Max(
                    0,
                    (int)Math.Round(_smartDecision.BuyScore));

                bearScore = Math.Max(
                    0,
                    (int)Math.Round(_smartDecision.SellScore));
            }
            else
            {
                // Compatibility path: retained only when the Smart Decision
                // Engine is explicitly disabled.
                if (m5.Direction == 1)
                    bullScore += M5Weight;

                if (m15.Direction == 1)
                    bullScore += M15Weight;

                if (m5.Direction == -1)
                    bearScore += M5Weight;

                if (m15.Direction == -1)
                    bearScore += M15Weight;

                if (bullLive >= LiveTriggerScore)
                    bullScore += 3;

                if (bearLive >= LiveTriggerScore)
                    bearScore += 3;

                if (UseM1Trigger && _m1 != null)
                {
                    int m1Index =
                        GetLastClosedIndexBefore(
                            _m1,
                            referenceTime);

                    if (m1Index >= 50)
                    {
                        Analysis m1 =
                            GetCachedClosedAnalysis(
                                _m1,
                                m1Index);

                        if (m1 != null)
                        {
                            if (m1.Direction == 1)
                                bullScore += 2;

                            if (m1.Direction == -1)
                                bearScore += 2;

                            if (m1.Choppy)
                            {
                                bullScore -= 1;
                                bearScore -= 1;
                            }
                        }
                    }
                }

                if (Bars.TimeFrame == TimeFrame.Minute15 &&
                    UseM5Trigger)
                {
                    if (m5.Direction == 1)
                        bullScore += 2;

                    if (m5.Direction == -1)
                        bearScore += 2;
                }

                if (m30 != null)
                {
                    if (m30.Direction == 1)
                        bullScore += M30Weight;

                    if (m30.Direction == -1)
                        bearScore += M30Weight;
                }

                if (h1 != null)
                {
                    if (h1.Direction == 1)
                        bullScore += H1Weight;

                    if (h1.Direction == -1)
                        bearScore += H1Weight;
                }

                if (h4 != null)
                {
                    if (h4.Direction == 1)
                        bullScore += H4Weight;

                    if (h4.Direction == -1)
                        bearScore += H4Weight;
                }
            }

            // ========================================================
            // CONFIDENCE
            // ========================================================

            int bullConfidence =
                EnableSmartDecisionEngine &&
                _smartDecision != null
                    ? CalculateSmartDirectionalConfidence(1)
                    : CalculateConfidence(
                        1,
                        bullLive,
                        m5,
                        m15,
                        m30,
                        h1,
                        h4);

            int bearConfidence =
                EnableSmartDecisionEngine &&
                _smartDecision != null
                    ? CalculateSmartDirectionalConfidence(-1)
                    : CalculateConfidence(
                        -1,
                        bearLive,
                        m5,
                        m15,
                        m30,
                        h1,
                        h4);

            // Quality confidence is directional quality and is intentionally
            // independent. The user-facing BUY/SELL shares are mutually exclusive
            // and always total exactly 100%.
            int buyShare;
            int sellShare;

            if (EnableSmartDecisionEngine &&
                _smartDecision != null)
            {
                buyShare = _smartBuyShare;
                sellShare = _smartSellShare;
            }
            else
            {
                CalculateDirectionalShares(
                    bullScore,
                    bearScore,
                    out buyShare,
                    out sellShare);
            }

            int edge = Math.Abs(buyShare - sellShare);

            // ========================================================
            // HIGHER TF CONFLICT
            // ========================================================

            bool bullHigherConflict =
                h1 != null &&
                h4 != null &&
                h1.Direction == -1 &&
                h4.Direction == -1;

            bool bearHigherConflict =
                h1 != null &&
                h4 != null &&
                h1.Direction == 1 &&
                h4.Direction == 1;

            // ========================================================
            // CHOP FILTER
            // ========================================================

            bool severeBullChop =
                m5.Choppy &&
                m15.Choppy &&
                bullLive < 3;

            bool severeBearChop =
                m5.Choppy &&
                m15.Choppy &&
                bearLive < 3;

            bool smartBullQuality =
                !UseSmartEntryQualityFilter ||
                HasSmartEntryQuality(_m5, m5Index, 1) ||
                (bullLive >= PrecisionTriggerScore &&
                 (m5.MssBull || m5.ChochBull || m5.DisplacementBull || m5.LiquidityBull));

            bool smartBearQuality =
                !UseSmartEntryQualityFilter ||
                HasSmartEntryQuality(_m5, m5Index, -1) ||
                (bearLive >= PrecisionTriggerScore &&
                 (m5.MssBear || m5.ChochBear || m5.DisplacementBear || m5.LiquidityBear));

            // ========================================================
            // CONFIRMED SIGNAL CANDIDATES
            // ========================================================

            bool cooldownOk = IsCooldownAllowed(m5LiveIndex);
            bool activeOk = (!BlockNewSignalWhileActive || !_signalActive) &&
                            (!BlockSameBarReentryAfterExit || _lastExitM5Bar != m5LiveIndex);

            bool bullDirectionOk = CanAcceptConfirmedDirection(
                1,
                m5LiveIndex,
                m5,
                m15,
                m30,
                h1,
                h4);

            bool bearDirectionOk = CanAcceptConfirmedDirection(
                -1,
                m5LiveIndex,
                m5,
                m15,
                m30,
                h1,
                h4);
            bool bullHigherAgreement = !RequireHigherTfAgreement ||
                ((m30 == null || m30.Direction >= 0) && (h1 == null || h1.Direction >= 0) && (h4 == null || h4.Direction >= 0));
            bool bearHigherAgreement = !RequireHigherTfAgreement ||
                ((m30 == null || m30.Direction <= 0) && (h1 == null || h1.Direction <= 0) && (h4 == null || h4.Direction <= 0));

            bool bullM5Zone = m5.FvgBull || m5.ObBull || m5.LiquidityBull;
            bool bearM5Zone = m5.FvgBear || m5.ObBear || m5.LiquidityBear;
            bool bullM15Zone = m15.FvgBull || m15.ObBull || m15.LiquidityBull;
            bool bearM15Zone = m15.FvgBear || m15.ObBear || m15.LiquidityBear;

            bool bullStrongOverride =
                AllowStrongM5TriggerOverride &&
                UseM5Trigger &&
                bullLive >= PrecisionTriggerScore &&
                (m5.MssBull || m5.ChochBull || m5.DisplacementBull || m5.LiquidityBull) &&
                m15.Direction >= 0;

            bool bearStrongOverride =
                AllowStrongM5TriggerOverride &&
                UseM5Trigger &&
                bearLive >= PrecisionTriggerScore &&
                (m5.MssBear || m5.ChochBear || m5.DisplacementBear || m5.LiquidityBear) &&
                m15.Direction <= 0;

            if (_cachedRetestM5Index != m5Index)
            {
                _cachedBullRetestQuality =
                    CalculateRetestQuality(
                        _m5,
                        m5Index,
                        1);

                _cachedBearRetestQuality =
                    CalculateRetestQuality(
                        _m5,
                        m5Index,
                        -1);

                _cachedRetestM5Index = m5Index;
            }

            int bullRetestQuality =
                _cachedBullRetestQuality;

            int bearRetestQuality =
                _cachedBearRetestQuality;

            _smartRetestQuality =
                Math.Max(
                    bullRetestQuality,
                    bearRetestQuality);

            bool bullRetestGate = !UseRetestQualityGate || bullRetestQuality >= MinimumRetestQuality || bullStrongOverride;
            bool bearRetestGate = !UseRetestQualityGate || bearRetestQuality >= MinimumRetestQuality || bearStrongOverride;

            bool bullZoneConfluence = !UseZoneConfluence ||
                ((bullM5Zone && bullM15Zone) ||
                 (bullM5Zone && bullLive >= PrecisionTriggerScore) ||
                 ((m5.MssBull || m5.ChochBull || m5.DisplacementBull) && bullLive >= LiveTriggerScore) ||
                 bullStrongOverride);
            bool bearZoneConfluence = !UseZoneConfluence ||
                ((bearM5Zone && bearM15Zone) ||
                 (bearM5Zone && bearLive >= PrecisionTriggerScore) ||
                 ((m5.MssBear || m5.ChochBear || m5.DisplacementBear) && bearLive >= LiveTriggerScore) ||
                 bearStrongOverride);

            bool bullStructuralConfirmation =
                !RequireStructuralConfirmation ||
                CountStructuralConfirmations(m5, m15, 1) >= Math.Max(1, MinimumStructuralConfirmations) ||
                bullStrongOverride;

            bool bearStructuralConfirmation =
                !RequireStructuralConfirmation ||
                CountStructuralConfirmations(m5, m15, -1) >= Math.Max(1, MinimumStructuralConfirmations) ||
                bearStrongOverride;

            // M5 is the execution/trigger authority even when the indicator
            // is attached to M15 or a higher context chart.
            bool triggerFrameOk =
                !M5OnlyConfirmedTrigger ||
                !UseM5Trigger ||
                (_m5 != null && m5Index >= 20);

            bool freshBullTrigger =
                !RequireFreshM5Trigger ||
                !UseM5Trigger ||
                HasFreshM5Trigger(_m5, m5Index, 1) ||
                bullStrongOverride;

            bool freshBearTrigger =
                !RequireFreshM5Trigger ||
                !UseM5Trigger ||
                HasFreshM5Trigger(_m5, m5Index, -1) ||
                bearStrongOverride;

            bool bullEntryReady = !UsePrecisionExecutionModel ||
                EntryTriggerReached(_m5, m5Index, 1);
            bool bearEntryReady = !UsePrecisionExecutionModel ||
                EntryTriggerReached(_m5, m5Index, -1);

            bool stableBull =
                (!UseM5Trigger || m5BullStable ||
                 (AllowStrongM5TriggerOverride && bullLive >= PrecisionTriggerScore && (m5.Direction == 0 || m5.Direction == 1))) &&
                (!RequireCoreAgreement || m15BullStable ||
                 (AllowStrongM5TriggerOverride && bullLive >= PrecisionTriggerScore && m15.Direction >= 0));
            bool stableBear =
                (!UseM5Trigger || m5BearStable ||
                 (AllowStrongM5TriggerOverride && bearLive >= PrecisionTriggerScore && (m5.Direction == 0 || m5.Direction == -1))) &&
                (!RequireCoreAgreement || m15BearStable ||
                 (AllowStrongM5TriggerOverride && bearLive >= PrecisionTriggerScore && m15.Direction <= 0));

            bool bullScoreOk = bullScore >= bearScore + 2 ||
                               (bullStrongOverride && bullScore >= bearScore);
            bool bearScoreOk = bearScore >= bullScore + 2 ||
                               (bearStrongOverride && bearScore >= bullScore);
            int calibratedBullMinimum = GetCalibratedMinimumConfidence(MinimumConfidence, 1);
            int calibratedBearMinimum = GetCalibratedMinimumConfidence(MinimumConfidence, -1);
            bool bullConfidenceOk = bullConfidence >= calibratedBullMinimum ||
                                    (bullStrongOverride && bullConfidence >= Math.Max(50, calibratedBullMinimum - 10));
            bool bearConfidenceOk = bearConfidence >= calibratedBearMinimum ||
                                    (bearStrongOverride && bearConfidence >= Math.Max(50, calibratedBearMinimum - 10));
            if (EnableSmartDecisionEngine)
            {
                bullConfidenceOk = bullConfidenceOk ||
                                   (_smartDirection == 1 && _smartQuality >= Math.Min(95, MinimumSmartQuality + 8) && _smartBuyShare >= MinimumSmartDirectionShare + 3);
                bearConfidenceOk = bearConfidenceOk ||
                                   (_smartDirection == -1 && _smartQuality >= Math.Min(95, MinimumSmartQuality + 8) && _smartSellShare >= MinimumSmartDirectionShare + 3);
            }
            GetAdaptiveSmartThresholds(
                _smartRegime,
                out int engineSmartQuality,
                out int engineSmartShare,
                out int engineSmartEdge);

            bool bullSmartStrong =
                AllowSmartSoftGate &&
                _smartDecision != null &&
                _smartDirection == 1 &&
                _smartQuality >= Math.Max(SmartStrongSetupQuality, engineSmartQuality + 8) &&
                _smartBuyShare >= engineSmartShare &&
                GetSmartEdge() >= Math.Max(SmartStrongSetupEdge, engineSmartEdge);

            bool bearSmartStrong =
                AllowSmartSoftGate &&
                _smartDecision != null &&
                _smartDirection == -1 &&
                _smartQuality >= Math.Max(SmartStrongSetupQuality, engineSmartQuality + 8) &&
                _smartSellShare >= engineSmartShare &&
                GetSmartEdge() >= Math.Max(SmartStrongSetupEdge, engineSmartEdge);

            bool bullEdgeOk = edge >= engineSmartEdge ||
                              (bullStrongOverride && edge >= Math.Max(5, engineSmartEdge - 5)) ||
                              bullSmartStrong;
            bool bearEdgeOk = edge >= engineSmartEdge ||
                              (bearStrongOverride && edge >= Math.Max(5, engineSmartEdge - 5)) ||
                              bearSmartStrong;
            bool bullBiasReady = IsDirectionalBiasReady(1, m5, m15) ||
                                 (bullStrongOverride &&
                                  (m5.MssBull || m5.ChochBull || m5.DisplacementBull || m5.LiquidityBull));
            bool bearBiasReady = IsDirectionalBiasReady(-1, m5, m15) ||
                                 (bearStrongOverride &&
                                  (m5.MssBear || m5.ChochBear || m5.DisplacementBear || m5.LiquidityBear));

            bool smartBullGate = !EnableSmartDecisionEngine ||
                (_smartDecision != null &&
                 _smartBuyShare >= engineSmartShare &&
                 _smartQuality >= engineSmartQuality &&
                 _smartDirection == 1) ||
                bullStrongOverride ||
                bullSmartStrong;

            bool smartBearGate = !EnableSmartDecisionEngine ||
                (_smartDecision != null &&
                 _smartSellShare >= engineSmartShare &&
                 _smartQuality >= engineSmartQuality &&
                 _smartDirection == -1) ||
                bearStrongOverride ||
                bearSmartStrong;

            bool bullCandidate =
                triggerFrameOk &&
                freshBullTrigger &&
                stableBull &&
                coreBull &&
                !bullHigherConflict &&
                !severeBullChop &&
                smartBullQuality &&
                smartBullGate &&
                bullLive >= LiveTriggerScore &&
                (!UseM5Trigger || m5.Direction == 1 || (AllowStrongM5TriggerOverride && bullLive >= PrecisionTriggerScore && m15.Direction >= 0)) &&
                bullScoreOk &&
                bullConfidenceOk &&
                bullEdgeOk &&
                bullHigherAgreement && bullZoneConfluence &&
                bullStructuralConfirmation &&
                sessionOk && spreadOk && fridayOk && newsOk && regimeOk &&
                cooldownOk && activeOk && bullDirectionOk &&
                bullEntryReady &&
                bullBiasReady &&
                bullRetestGate;

            bool bearCandidate =
                triggerFrameOk &&
                freshBearTrigger &&
                stableBear &&
                coreBear &&
                !bearHigherConflict &&
                !severeBearChop &&
                smartBearQuality &&
                smartBearGate &&
                bearLive >= LiveTriggerScore &&
                (!UseM5Trigger || m5.Direction == -1 || (AllowStrongM5TriggerOverride && bearLive >= PrecisionTriggerScore && m15.Direction <= 0)) &&
                bearScoreOk &&
                bearConfidenceOk &&
                bearEdgeOk &&
                bearHigherAgreement && bearZoneConfluence &&
                bearStructuralConfirmation &&
                sessionOk && spreadOk && fridayOk && newsOk && regimeOk &&
                cooldownOk && activeOk && bearDirectionOk &&
                bearEntryReady &&
                bearBiasReady &&
                bearRetestGate;

            // Simultaneous BUY and SELL candidates are ambiguous. Do not force
            // a direction simply because one branch is evaluated first.
            if (bullCandidate && bearCandidate)
            {
                bullCandidate = false;
                bearCandidate = false;
            }

            // ========================================================
            // RISK / REWARD VALIDATION
            // ========================================================

            bool bullRiskValid = false;
            bool bearRiskValid = false;

            if (bullCandidate)
            {
                bullRiskValid =
                    ValidateTradeRiskReward(
                        _m5,
                        m5Index,
                        1,
                        Symbol.Ask,
                        out double bullSl,
                        out double bullTp1,
                        out double bullTp2,
                        out double bullTp3,
                        out double bullTp4,
                        out double bullRR);

                if (!bullRiskValid)
                    bullCandidate = false;
            }

            if (bearCandidate)
            {
                bearRiskValid =
                    ValidateTradeRiskReward(
                        _m5,
                        m5Index,                        -1,
                        Symbol.Bid,                        out double bearSl,
                        out double bearTp1,
                        out double bearTp2,
                        out double bearTp3,
                        out double bearTp4,
                        out double bearRR);

                if (!bearRiskValid)
                    bearCandidate = false;
            }

            // ========================================================
            // STATE
            // ========================================================

            string state = "WAITING";

            if (_predictionDirection == 1)
                state = "BUY WATCH";
            else if (_predictionDirection == -1)
                state = "SELL WATCH";

            if (_liveReactionDirection == 1)
                state = "BUY REACTION";
            else if (_liveReactionDirection == -1)
                state = "SELL REACTION";

            if (bullCandidate)
                state = "BUY CONFIRMED";
            else if (bearCandidate)
                state = "SELL CONFIRMED";

            if (_signalActive && _signalDirection != 0)
                state = _signalDirection == 1 ? "BUY ACTIVE" : "SELL ACTIVE";


            DrawStatus(
                "CFIP MTF INTELLIGENCE  |  " +
                state + "\n" +
                "TF  M5 " + DirectionText(m5.Direction) +
                "  M15 " + DirectionText(m15.Direction) +
                "  M30 " + DirectionText(m30 == null ? 0 : m30.Direction) +
                "  H1 " + DirectionText(h1 == null ? 0 : h1.Direction) +
                "  H4 " + DirectionText(h4 == null ? 0 : h4.Direction) +
                "\n" +
                "STABILITY M5 " +
                (m5BullStable ? "BUY" : m5BearStable ? "SELL" : "MIXED") +
                "  M15 " +
                (m15BullStable ? "BUY" : m15BearStable ? "SELL" : "MIXED") +
                "  BIAS " +
                (_lastDirectionalBias == 1 ? "BUY LOCK" :
                 _lastDirectionalBias == -1 ? "SELL LOCK" : "UNSET") +
                "\n" +
                "FILTERS " +
                (sessionOk ? "SESSION OK" : "SESSION OFF") +
                "  " +
                (spreadOk ? "SPREAD OK" : "SPREAD HIGH") +
                "  " +
                (fridayOk ? "DAY OK" : "FRIDAY CUTOFF") +
                 "  " +
                 (newsOk ? "NEWS OK" : "NEWS BLOCK") +
                 "  " +
                 (regimeOk ? "REGIME OK" : "NO-TRADE " + _smartRegime));

            // ========================================================
            // CREATE CONFIRMED SIGNAL
            // ========================================================

            if (bullCandidate &&
                _lastSignalDecisionM5Bar != m5LiveIndex)
            {
                CreateLiveSignal(
                    chartIndex,
                    m5LiveIndex,
                    m5Index,
                    1,
                    bullConfidence);
            }
            else if (bearCandidate &&
                     _lastSignalDecisionM5Bar != m5LiveIndex)
            {
                CreateLiveSignal(
                    chartIndex,
                    m5LiveIndex,
                    m5Index,
                    -1,
                    bearConfidence);
            }
        }

        // ============================================================
        // LIVE REACTION / INTRABAR WATCH
        // ============================================================

        private bool IsDirectionalBiasReady(int direction, Analysis m5, Analysis m15)
        {
            if (m5 == null || _m5 == null || _m5.Count < 25)
                return false;

            if (_lastDirectionalBias == direction)
                return true;

            DateTime liveReferenceTime = _m5.OpenTimes[Math.Max(1, _m5.Count - 1)];
            int closedIndex = GetLastClosedIndexBefore(_m5, liveReferenceTime);
            int required = RequireStableM5Direction ? Math.Max(1, StableM5Bars) : 1;
            bool stable = !RequireStableM5Direction ||
                          HasStableSimpleDirection(_m5, closedIndex, direction, required);
            if (!stable || m5.Direction != direction)
                return false;

            int m15Direction = m15 != null ? m15.Direction : 0;
            bool coreAllows = !RequireCoreAgreement ||
                               m15Direction == direction ||
                               (AllowM15NeutralPullback && m15Direction == 0);
            if (!coreAllows)
                return false;

            if (_lastDirectionalBias == 0)
                return true;

            // A previously locked bias is allowed to become stale when the
            // opposite closed-M5 structure has genuinely reversed. This avoids
            // permanently suppressing a valid new cycle after a regime change.
            bool reversalEvidence = direction == 1
                ? (m5.MssBull || m5.ChochBull || m5.DisplacementBull || m5.LiquidityBull)
                : (m5.MssBear || m5.ChochBear || m5.DisplacementBear || m5.LiquidityBear);

            return reversalEvidence;
        }

        private void EvaluateLiveReaction(int chartIndex)
        {
            if (!EnableLiveReaction || _m5 == null || _m15 == null || _m5.Count < 70 || _m15.Count < 70)
            {
                ClearLiveReactionObjects();
                return;
            }

            // Keep live counter-reactions visible while a plan is active.
            // They remain informational and cannot override execution safety gates.

            int liveIndex = _m5.Count - 1;
            int closedIndex = liveIndex - 1;
            DateTime referenceTime = _m5.OpenTimes[liveIndex];
            int m15Index = GetLastClosedIndexBefore(_m15, referenceTime);
            if (closedIndex < 50 || m15Index < 50)
            {
                ClearLiveReactionObjects();
                return;
            }

            Analysis m5 = GetCachedClosedAnalysis(_m5, closedIndex);
            Analysis m15 = GetCachedClosedAnalysis(_m15, m15Index);
            if (m5 == null || m15 == null)
            {
                ClearLiveReactionObjects();
                return;
            }

            double atr = GetAtr(_m5, closedIndex, AtrPeriod);
            if (atr <= 0)
            {
                ClearLiveReactionObjects();
                return;
            }

            double bullPrice = Symbol.Ask;
            double bearPrice = Symbol.Bid;
            double open = _m5.OpenPrices[liveIndex];
            double high = _m5.HighPrices[liveIndex];
            double low = _m5.LowPrices[liveIndex];
            double range = Math.Max(Symbol.PipSize, high - low);
            double bodyBull = Math.Abs(bullPrice - open);
            double bodyBear = Math.Abs(bearPrice - open);
            double closeLocationBull = Clamp((bullPrice - low) / range, 0.0, 1.0);
            double closeLocationBear = Clamp((high - bearPrice) / range, 0.0, 1.0);
            double fast = GetEma(_m5, liveIndex, FastEma);
            double slow = GetEma(_m5, liveIndex, SlowEma);
            double fastPast = GetEma(_m5, Math.Max(1, liveIndex - 3), FastEma);
            double rsi = GetRsi(_m5, liveIndex, RsiPeriod);
            double priorHigh = HighestHigh(_m5, Math.Max(0, closedIndex - 6), Math.Max(0, closedIndex - 1));
            double priorLow = LowestLow(_m5, Math.Max(0, closedIndex - 6), Math.Max(0, closedIndex - 1));

            Zone bullZone = FindNearestBullishZone(_m5, closedIndex);
            Zone bearZone = FindNearestBearishZone(_m5, closedIndex);
            bool bullZoneTouch = bullZone != null && low <= bullZone.High && high >= bullZone.Low;
            bool bearZoneTouch = bearZone != null && high >= bearZone.Low && low <= bearZone.High;

            int bull = 0;
            int bear = 0;
            int bullEvidence = 0;
            int bearEvidence = 0;

            // Trend family.
            if (bullPrice > fast && fast > slow) { bull += 18; bullEvidence++; }
            if (bearPrice < fast && fast < slow) { bear += 18; bearEvidence++; }
            if (fast > fastPast) bull += 6;
            if (fast < fastPast) bear += 6;

            // HTF / confirmed structure family.
            if (m5.Direction == 1) { bull += 12; bullEvidence++; }
            if (m5.Direction == -1) { bear += 12; bearEvidence++; }
            if (m15.Direction == 1) { bull += 14; bullEvidence++; }
            if (m15.Direction == -1) { bear += 14; bearEvidence++; }
            if (m5.MssBull || m5.ChochBull || m5.DisplacementBull) { bull += 8; bullEvidence++; }
            if (m5.MssBear || m5.ChochBear || m5.DisplacementBear) { bear += 8; bearEvidence++; }

            // Zone / liquidity family.
            if (m5.FvgBull || m5.ObBull || m5.LiquidityBull || bullZoneTouch) { bull += 9; bullEvidence++; }
            if (m5.FvgBear || m5.ObBear || m5.LiquidityBear || bearZoneTouch) { bear += 9; bearEvidence++; }
            if (m15.FvgBull || m15.ObBull || m15.LiquidityBull) bull += 6;
            if (m15.FvgBear || m15.ObBear || m15.LiquidityBear) bear += 6;

            // Current price-action trigger family.
            bool bullBody = bullPrice > open && bodyBull >= atr * Math.Max(0.04, MinimumTriggerBodyAtr * 0.55);
            bool bearBody = bearPrice < open && bodyBear >= atr * Math.Max(0.04, MinimumTriggerBodyAtr * 0.55);
            bool bullBreak = bullPrice > _m5.HighPrices[closedIndex] || bullPrice > priorHigh;
            bool bearBreak = bearPrice < _m5.LowPrices[closedIndex] || bearPrice < priorLow;
            bool bullSweep = HasBullLiquiditySweep(_m5, liveIndex);
            bool bearSweep = HasBearLiquiditySweep(_m5, liveIndex);
            bool bullLocation = closeLocationBull >= Math.Max(0.55, MinimumCloseLocation - 0.05);
            bool bearLocation = closeLocationBear >= Math.Max(0.55, MinimumCloseLocation - 0.05);

            if (bullBody) { bull += 9; bullEvidence++; }
            if (bearBody) { bear += 9; bearEvidence++; }
            if (bullBreak) { bull += 10; bullEvidence++; }
            if (bearBreak) { bear += 10; bearEvidence++; }
            if (bullSweep) { bull += 7; bullEvidence++; }
            if (bearSweep) { bear += 7; bearEvidence++; }
            if (bullLocation) bull += 4;
            if (bearLocation) bear += 4;

            // Momentum / exhaustion family.
            double dmi = GetDmiBias(_m5, liveIndex, AdxPeriod);
            double adx = GetAdx(_m5, liveIndex, AdxPeriod);
            if (rsi >= 52 && rsi < 75) bull += 5;
            if (rsi <= 48 && rsi > 25) bear += 5;
            if (adx >= AdxMinimum)
            {
                if (dmi > 0.05) bull += 5;
                if (dmi < -0.05) bear += 5;
            }

            // Optional advanced confluence is used as supporting evidence in
            // the live layer too. It can strengthen a reaction, but cannot
            // create one without price-action evidence.
            if (UseAdvancedConfluence)
            {
                if (HasVolumeExpansion(_m5, liveIndex, 1)) { bull += 3; bullEvidence++; }
                if (HasVolumeExpansion(_m5, liveIndex, -1)) { bear += 3; bearEvidence++; }
                if (HasMacdBias(_m5, liveIndex, 1)) bull += 2;
                if (HasMacdBias(_m5, liveIndex, -1)) bear += 2;
                if (HasVwapBias(_m5, liveIndex, 1)) bull += 2;
                if (HasVwapBias(_m5, liveIndex, -1)) bear += 2;
                if (HasHealthyVolatility(_m5, liveIndex, 1)) bull += 2;
                if (HasHealthyVolatility(_m5, liveIndex, -1)) bear += 2;
            }

            // Closed M1 confirmation gives the live layer an additional fast
            // signal without leaking the still-forming M1 candle.
            if (UseM1Trigger && _m1 != null && _m1.Count >= 70)
            {
                int m1Index = GetLastClosedIndexBefore(_m1, referenceTime);
                if (m1Index >= 50)
                {
                    Analysis m1 = GetCachedClosedAnalysis(_m1, m1Index);
                    if (m1 != null)
                    {
                        if (m1.Direction == 1) { bull += 5; bullEvidence++; }
                        if (m1.Direction == -1) { bear += 5; bearEvidence++; }
                    }
                }
            }

            int direction = 0;
            int watchThreshold = Math.Min(LiveReactionThreshold - 1, Math.Max(1, LiveReactionWatchThreshold));
            bool bullActionable = bull >= LiveReactionThreshold &&
                                  bullEvidence >= Math.Max(1, MinimumLiveReactionEvidence) &&
                                  bull >= bear + 5;
            bool bearActionable = bear >= LiveReactionThreshold &&
                                  bearEvidence >= Math.Max(1, MinimumLiveReactionEvidence) &&
                                  bear >= bull + 5;
            bool bullWatch = bull >= watchThreshold && bullEvidence >= 1 && bull >= bear + 3;
            bool bearWatch = bear >= watchThreshold && bearEvidence >= 1 && bear >= bull + 3;

            if (bullActionable || (!bearActionable && bullWatch))
                direction = 1;
            else if (bearActionable || (!bullActionable && bearWatch))
                direction = -1;

            bool triggerPresent = direction == 1
                ? (bullBody || bullBreak || bullSweep || bullZoneTouch)
                : direction == -1
                    ? (bearBody || bearBreak || bearSweep || bearZoneTouch)
                    : false;

            if (direction == 0 || !triggerPresent)
            {
                // Keep only a strong reaction after a normal retrace. A decisive
                // opposite break invalidates the previous intrabar marker.
                bool keepLatched =
                    _liveReactionBar == liveIndex &&
                    _liveReactionDirection != 0 &&
                    _liveReactionConfidence >= LiveReactionStrongThreshold &&
                    _liveReactionEvidence >= Math.Max(2, MinimumLiveReactionEvidence);

                if (keepLatched)
                {
                    int opposite = _liveReactionDirection == 1 ? -1 : 1;
                    bool oppositeBreak = opposite == 1
                        ? Symbol.Ask < _m5.LowPrices[closedIndex] && Symbol.Ask < fast
                        : Symbol.Bid > _m5.HighPrices[closedIndex] && Symbol.Bid > fast;

                    if (!oppositeBreak)
                    {
                        // Keep the latched reaction state; the final renderer owns drawing.
                        return;
                    }
                }

                ClearLiveReactionObjects();
                return;
            }

            int confidence = (int)Clamp(direction == 1 ? bull : bear, 0, 100);
            _liveReactionDirection = direction;
            _liveReactionConfidence = confidence;
            _liveReactionEvidence = direction == 1 ? bullEvidence : bearEvidence;
            _liveReactionBar = liveIndex;

            bool actionableReaction = confidence >= LiveReactionThreshold &&
                                      _liveReactionEvidence >= Math.Max(1, MinimumLiveReactionEvidence);
            bool counterReaction = _signalActive &&
                                   _signalDirection != 0 &&
                                   direction != _signalDirection;
            if (AlertOnLiveReaction && actionableReaction &&
                (_lastLiveReactionAlertBar != liveIndex || _lastLiveReactionAlertDirection != direction) &&
                (!_signalActive || counterReaction))
            {
                _lastLiveReactionAlertBar = liveIndex;
                _lastLiveReactionAlertDirection = direction;
                string reactionMessage = counterReaction
                    ? ((direction == 1 ? "COUNTER BUY" : "COUNTER SELL") +
                       " | EXIT WATCH | Q " + confidence + " | EVIDENCE " + _liveReactionEvidence)
                    : ((direction == 1 ? "LIVE BUY REACTION" : "LIVE SELL REACTION") +
                       " | Q " + confidence + " | EVIDENCE " + _liveReactionEvidence +
                       (confidence >= LiveReactionStrongThreshold ? " | STRONG" : " | TRIGGERING"));

                QueueReactionDecisionAlert(
                    reactionMessage +
                    " | SMART Q " + _smartQuality +
                    " | REGIME " + _smartRegime,
                    direction,
                    liveIndex);
            }

            // Evaluate the fresh live reaction immediately after it is calculated.
            // MonitorActiveLevels runs earlier in Calculate() to protect a newly
            // created plan from self-triggering; this second pass handles a true
            // same-tick structural reversal without waiting for the next tick.
            if (_signalActive &&
                EnableLiveStructuralReversal &&
                direction != 0 &&
                direction != _signalDirection &&
                actionableReaction)
            {
                double reversalMarket = direction == 1 ? bullPrice : bearPrice;
                int liveClosedIndex = GetLastClosedIndexBefore(
                    _m5,
                    _m5.OpenTimes[liveIndex]);
                double reversalAtr = liveClosedIndex >= 30
                    ? GetAtr(_m5, liveClosedIndex, AtrPeriod)
                    : atr;

                if (reversalAtr > 0 &&
                    EvaluateLiveStructuralReversalAgainstActiveSignal(
                        liveIndex,
                        liveClosedIndex,
                        reversalMarket,
                        reversalAtr))
                {
                    int oldDirection = _signalDirection;
                    int reversalDirection = _liveReversalDirection;
                    _signalActive = false;
                    _signalOutcome = "LIVE STRUCTURAL REVERSAL";
                    _lastExitM5Bar = liveIndex;
                    RecordSignalOutcome(false);
                    QueueExitDecisionAlert(
                        (oldDirection == 1 ? "BUY" : "SELL") +
                        " INVALIDATED BY LIVE " +
                        (reversalDirection == 1 ? "BUY" : "SELL") +
                        " REVERSAL | " + SymbolName +
                        " | SCORE " + _liveReversalScore,
                        reversalDirection,
                        liveIndex);
                    DrawOutcomeMarker("REVERSAL", reversalMarket, false);
                }
            }
        }

        private void BuildLiveReactionPlan(
            int direction,
            double market,
            int closedIndex)
        {
            _reactionEntry = 0;
            _reactionSl = 0;
            _reactionTp1 = 0;
            _reactionTp2 = 0;
            _reactionTp3 = 0;
            _reactionTp4 = 0;

            if (_m5 == null ||
                closedIndex < 30 ||
                closedIndex >= _m5.Count ||
                !IsFinitePositive(market))
                return;

            double entry = NormalizePrice(market);
            double sl;
            double tp1;
            double tp2;
            double tp3;
            double tp4;

            bool built = EnableSmartDecisionEngine
                ? TryBuildSmartRiskPlan(
                    _m5,
                    closedIndex,
                    direction,
                    entry,
                    out sl,
                    out tp1,
                    out tp2,
                    out tp3,
                    out tp4)
                : TryBuildFallbackRiskPlan(
                    _m5,
                    closedIndex,
                    direction,
                    entry,
                    out sl,
                    out tp1,
                    out tp2,
                    out tp3,
                    out tp4);

            if (!built)
                return;

            _reactionEntry = entry;
            _reactionSl = NormalizePrice(sl);
            _reactionTp1 = NormalizePrice(tp1);
            _reactionTp2 = NormalizePrice(tp2);
            _reactionTp3 = tp3 > 0
                ? NormalizePrice(tp3)
                : 0;
            _reactionTp4 = tp4 > 0
                ? NormalizePrice(tp4)
                : 0;

            bool valid = direction == 1
                ? _reactionSl < _reactionEntry &&
                  _reactionEntry < _reactionTp1 &&
                  _reactionTp1 < _reactionTp2
                : _reactionSl > _reactionEntry &&
                  _reactionEntry > _reactionTp1 &&
                  _reactionTp1 > _reactionTp2;

            if (!valid)
            {
                _reactionEntry = 0;
                _reactionSl = 0;
                _reactionTp1 = 0;
                _reactionTp2 = 0;
                _reactionTp3 = 0;
                _reactionTp4 = 0;
            }
        }

        private void DrawLiveReaction(int chartIndex, int direction, int confidence, int evidence)
        {
            if (Bars == null || Bars.Count == 0)
                return;

            int anchorIndex = MapM5BarToChartIndex(_liveReactionBar, chartIndex);
            double atr = GetAtr(Bars, Math.Max(1, anchorIndex), AtrPeriod);            double offset = atr > 0
                ? Math.Max(atr * Math.Max(0.05, ArrowOffsetAtr), Symbol.PipSize * Math.Max(1.0, MinimumArrowOffsetPips))
                : Symbol.PipSize * Math.Max(1.0, MinimumArrowOffsetPips);

            bool counterReaction = _signalActive &&
                                   _signalDirection != 0 &&
                                   direction != _signalDirection;

            if (ShowReactionArrow)
            {
                DrawStableIcon(
                    ReactionPrefix + "ARROW",
                    direction == 1 ? ChartIconType.UpArrow : ChartIconType.DownArrow,
                    anchorIndex,
                    direction == 1 ? Bars.LowPrices[anchorIndex] - offset : Bars.HighPrices[anchorIndex] + offset,
                    GetReactionArrowColor(direction, confidence, counterReaction));
            }
            else
            {
                Chart.RemoveObject(ReactionPrefix + "ARROW");
            }

            double reactionMarket = direction == 1 ? Symbol.Ask : Symbol.Bid;
            int reactionClosedIndex = -1;
            if (_m5 != null && _m5.Count >= 2)
            {
                DateTime liveReferenceTime = _m5.OpenTimes[_m5.Count - 1];
                reactionClosedIndex = GetLastClosedIndexBefore(_m5, liveReferenceTime);
            }
            BuildLiveReactionPlan(direction, reactionMarket, reactionClosedIndex);

            if (!_signalActive && ShowLevelLines)
            {
                GetFinitePlanRange(anchorIndex, out int reactionStart, out int reactionEnd);
                DrawExactLevelLineByIndex(ReactionPrefix + "ENTRY", reactionStart, reactionEnd, _reactionEntry, EntryColor, ShowEntry && _reactionEntry > 0);
                DrawExactLevelLineByIndex(ReactionPrefix + "SL", reactionStart, reactionEnd, _reactionSl, SlColor, ShowSL && _reactionSl > 0);
                DrawExactLevelLineByIndex(ReactionPrefix + "TP1", reactionStart, reactionEnd, _reactionTp1, TpColor, ShowTP1 && _reactionTp1 > 0);
                DrawExactLevelLineByIndex(ReactionPrefix + "TP2", reactionStart, reactionEnd, _reactionTp2, TpColor, ShowTP2 && _reactionTp2 > 0);
                DrawExactLevelLineByIndex(ReactionPrefix + "TP3", reactionStart, reactionEnd, _reactionTp3, TpColor, ShowTP3 && _reactionTp3 > 0);
                DrawExactLevelLineByIndex(ReactionPrefix + "TP4", reactionStart, reactionEnd, _reactionTp4, TpColor, ShowTP4 && _reactionTp4 > 0);
            }

            bool actionable =
                confidence >= LiveReactionThreshold &&
                evidence >= Math.Max(1, MinimumLiveReactionEvidence);
            _earlyStatusText = (counterReaction ? "COUNTER " : "REACTION ") +
                               (direction == 1 ? "BUY" : "SELL") +
                               " | Q " + confidence + " | EVIDENCE " + evidence +
                               " | " + (confidence >= LiveReactionStrongThreshold ? "STRONG" : actionable ? "TRIGGERING" : "FORMING");

            // The header must never say WAITING while a live reaction is visible.
            // Confirmed ACTIVE always has priority over the informational reaction.
            // Final panel rendering is handled once per Calculate() pass.
        }

