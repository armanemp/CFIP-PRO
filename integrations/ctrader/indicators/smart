        private void DrawAuthoritativeLevelLine(
            string name,
            int startIndex,
            int endIndex,
            double price,
            Color color,
            bool visible,
            LineStyle? styleOverride = null,
            bool? fullWidthOverride = null)
        {
            if (!visible ||
                !IsFinitePositive(price) ||
                Bars == null ||
                Bars.Count < 1)
            {
                RemoveLevelDrawing(name);
                return;
            }

            double normalizedPrice =
                NormalizePrice(price);

            if (!IsFinitePositive(normalizedPrice))
            {
                RemoveLevelDrawing(name);
                return;
            }

            LineStyle lineStyle =
                styleOverride ?? PlanLineStyle;

            bool fullWidth =
                fullWidthOverride ?? FullWidthLevelLines;

            try
            {
                if (fullWidth)
                {
                    ChartHorizontalLine line =
                        Chart.FindObject(name) as ChartHorizontalLine;

                    if (line == null)
                    {
                        Chart.RemoveObject(name);

                        line =
                            Chart.DrawHorizontalLine(
                                name,
                                normalizedPrice,
                                color,
                                Math.Max(1, LevelLineThickness),
                                lineStyle);
                    }

                    if (line != null)
                    {
                        line.Y =
                            normalizedPrice;
                        line.Color = color;
                        line.Thickness =
                            Math.Max(1, LevelLineThickness);
                        line.LineStyle = lineStyle;
                        line.IsInteractive = false;

                        Chart.RemoveObject(
                            name + "_FALLBACK");
                        Chart.RemoveObject(
                            name + "_SEG");
                        return;
                    }

                    if (TryDrawLevelFallback(
                            name + "_FALLBACK",
                            startIndex,
                            endIndex,
                            normalizedPrice,
                            color,
                            lineStyle,
                            true))
                        return;

                    Print(
                        "CFIP level render failed [{0}]: horizontal line unavailable",
                        name);
                    return;
                }

                int safeStart =
                    Math.Max(
                        0,
                        Math.Min(
                            startIndex,
                            Bars.Count - 2));

                int safeEnd =
                    Math.Max(
                        safeStart + 1,
                        Math.Min(
                            endIndex,
                            Bars.Count - 1));

                ChartTrendLine trend =
                    Chart.FindObject(name) as ChartTrendLine;

                if (trend == null)
                {
                    Chart.RemoveObject(name);

                    trend =
                        Chart.DrawTrendLine(
                            name,
                            Bars.OpenTimes[safeStart],
                            normalizedPrice,
                            Bars.OpenTimes[safeEnd],
                            normalizedPrice,
                            color,
                            Math.Max(1, LevelLineThickness),
                            lineStyle);
                }

                if (trend != null)
                {
                    trend.Time1 =
                        Bars.OpenTimes[safeStart];
                    trend.Y1 =
                        normalizedPrice;
                    trend.Time2 =
                        Bars.OpenTimes[safeEnd];
                    trend.Y2 =
                        normalizedPrice;
                    trend.Color = color;
                    trend.Thickness =
                        Math.Max(1, LevelLineThickness);
                    trend.LineStyle = lineStyle;
                    trend.ExtendToInfinity = false;
                    trend.IsInteractive = false;

                    Chart.RemoveObject(
                        name + "_FALLBACK");
                    Chart.RemoveObject(
                        name + "_SEG");
                    return;
                }

                if (TryDrawLevelFallback(
                        name + "_FALLBACK",
                        safeStart,
                        safeEnd,
                        normalizedPrice,
                        color,
                        lineStyle,
                        false))
                    return;

                Print(
                    "CFIP level render failed [{0}]: trend line unavailable",
                    name);
            }
            catch (Exception ex)
            {
                Chart.RemoveObject(name);

                if (!TryDrawLevelFallback(
                        name + "_FALLBACK",
                        startIndex,
                        endIndex,
                        normalizedPrice,
                        color,
                        lineStyle,
                        fullWidth))
                {
                    Print(
                        "CFIP level render failed [{0}]: {1}",
                        name,
                        ex.Message);
                }
            }
        }


        private void DrawSignal(
            int index,
            double rr)
        {
            if (Bars == null || Bars.Count == 0 || _signalDirection == 0)
                return;


            int anchorIndex = Math.Max(0, Math.Min(index, Bars.Count - 1));
            GetFinitePlanRange(anchorIndex, out int startIndex, out int endIndex);

            // Active plan levels are finite chart-local segments; the price levels remain frozen until the plan is replaced or structurally repriced.

            int m5Anchor = _m5 != null && _m5.Count > 2
                ? Math.Max(1, Math.Min(_m5.Count - 1, (_predictionBar > 0 ? _predictionBar - 1 : _m5.Count - 1)))
                : Math.Max(1, anchorIndex);
            double atr = _m5 != null ? GetAtr(_m5, m5Anchor, AtrPeriod) : GetAtr(Bars, Math.Max(1, anchorIndex), AtrPeriod);
            double arrowOffset = atr > 0
                ? Math.Max(atr * Math.Max(0.05, ArrowOffsetAtr), Symbol.PipSize * Math.Max(1.0, MinimumArrowOffsetPips))
                : Symbol.PipSize * Math.Max(1.0, MinimumArrowOffsetPips);
            Color directionColor = GetSignalArrowColor(_signalDirection, _signalConfidence);

            if (ShowSignalArrow)
            {
                DrawStableIcon(
                    Prefix + "ARROW",
                    _signalDirection == 1 ? ChartIconType.UpArrow : ChartIconType.DownArrow,
                    anchorIndex,
                    _signalDirection == 1 ? Bars.LowPrices[anchorIndex] - arrowOffset : Bars.HighPrices[anchorIndex] + arrowOffset,
                    directionColor);
            }

            DrawExactLevelLineByIndex(Prefix + "ENTRY", startIndex, endIndex, _signalEntry, EntryColor, ShowLevelLines && ShowEntry);
            DrawExactLevelLineByIndex(Prefix + "SL", startIndex, endIndex, _signalSl, SlColor, ShowLevelLines && ShowSL);
            DrawExactLevelLineByIndex(Prefix + "TP1", startIndex, endIndex, _signalTp1, TpColor, ShowLevelLines && ShowTP1);
            DrawExactLevelLineByIndex(Prefix + "TP2", startIndex, endIndex, _signalTp2, TpColor, ShowLevelLines && ShowTP2);
            DrawExactLevelLineByIndex(Prefix + "TP3", startIndex, endIndex, _signalTp3, TpColor, ShowLevelLines && ShowTP3 && _signalTp3 > 0);
            DrawExactLevelLineByIndex(Prefix + "TP4", startIndex, endIndex, _signalTp4, TpColor, ShowLevelLines && ShowTP4 && _signalTp4 > 0);

            // All default text lives in the single unified static panel.
            // No level text is drawn on top of candles.

            // Visible rendering is owned by RenderSynchronizedPresentation().
        }

