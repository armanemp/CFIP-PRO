        private double FindTightProtectiveLow(Bars bars, int index, double entry)
        {
            if (bars == null || bars.Count < 20)
                return 0;

            index = Math.Min(index, bars.Count - 1);
            int last = index - SwingStrength;
            int first = Math.Max(SwingStrength, index - SlStructureLookback);
            double best = double.MinValue;

            for (int i = last; i >= first; i--)
            {
                double low = bars.LowPrices[i];
                if (low >= entry)
                    continue;

                bool swing = true;
                for (int j = 1; j <= SwingStrength; j++)
                {
                    if (i - j < 0 || i + j > index ||
                        low >= bars.LowPrices[i - j] ||
                        low >= bars.LowPrices[i + j])
                    {
                        swing = false;
                        break;
                    }
                }

                if (swing && low > best)
                    best = low;
            }

            return best == double.MinValue
                ? LowestLow(bars, Math.Max(0, index - SlStructureLookback), index)
                : best;
        }

        private double FindTightProtectiveHigh(Bars bars, int index, double entry)
        {
            if (bars == null || bars.Count < 20)
                return 0;

            index = Math.Min(index, bars.Count - 1);
            int last = index - SwingStrength;
            int first = Math.Max(SwingStrength, index - SlStructureLookback);
            double best = double.MaxValue;

            for (int i = last; i >= first; i--)
            {
                double high = bars.HighPrices[i];
                if (high <= entry)
                    continue;

                bool swing = true;
                for (int j = 1; j <= SwingStrength; j++)
                {
                    if (i - j < 0 || i + j > index ||
                        high <= bars.HighPrices[i - j] ||
                        high <= bars.HighPrices[i + j])
                    {
                        swing = false;
                        break;
                    }
                }

                if (swing && high < best)
                    best = high;
            }

            return best == double.MaxValue
                ? HighestHigh(bars, Math.Max(0, index - SlStructureLookback), index)
                : best;
        }

        private bool ValidateTradeRiskReward(
            Bars riskBars,
            int closedIndex,
            int direction,
            double entry,
            out double sl,
            out double tp1,
            out double tp2,
            out double tp3,
            out double tp4,
            out double rr)
        {
            sl = tp1 = tp2 = tp3 = tp4 = 0;
            rr = 0;

            if (riskBars == null ||
                direction == 0 ||
                riskBars.Count < 40 ||
                closedIndex < 30 ||
                closedIndex >= riskBars.Count ||
                !IsFinitePositive(entry))
                return false;

            entry = NormalizePrice(entry);
            if (entry <= 0)
                return false;

            bool planBuilt;

            if (EnableSmartDecisionEngine)
            {
                planBuilt = TryBuildSmartRiskPlan(
                    riskBars,
                    closedIndex,
                    direction,
                    entry,
                    out sl,
                    out tp1,
                    out tp2,
                    out tp3,
                    out tp4);

                // Smart structural planning is always first. If a transient/sparse
                // market produces no usable structural stop/target, do not silently
                // discard an otherwise valid confirmed signal: use the deterministic
                // execution-frame risk model as a safety net.
                if (!planBuilt && AllowExecutionFrameStopFallback)
                {
                    planBuilt = TryBuildFallbackRiskPlan(
                        riskBars,
                        closedIndex,
                        direction,
                        entry,
                        out sl,
                        out tp1,
                        out tp2,
                        out tp3,
                        out tp4);
                }
            }
            else
            {
                planBuilt = TryBuildFallbackRiskPlan(
                    riskBars,
                    closedIndex,
                    direction,
                    entry,
                    out sl,
                    out tp1,
                    out tp2,
                    out tp3,
                    out tp4);
            }

            if (!planBuilt)
                return false;

            double executionAtr = GetAtr(riskBars, closedIndex, AtrPeriod);
            if (!IsFinitePositive(executionAtr))
                return false;

            double finalRisk = Math.Abs(entry - sl);
            if (finalRisk <= Symbol.PipSize)
                return false;

            double maximumRisk = executionAtr * Math.Max(
                0.50,
                Math.Min(MaximumStructuralStopAtr, Math.Max(0.50, MaximumSlAtr)));
            double minimumRisk = executionAtr * Math.Max(
                0.10,
                MinimumSlAtr);

            if (finalRisk > maximumRisk || finalRisk < minimumRisk)
                return false;

            double reward = direction == 1
                ? tp1 - entry
                : entry - tp1;

            if (reward <= 0)
                return false;

            rr = reward / finalRisk;

            if (AvoidLateEntry)
            {
                double extension = Math.Abs(
                    entry - riskBars.ClosePrices[closedIndex]);

                if (extension > executionAtr * MaximumEntryExtensionAtr)
                    return false;
            }

            double minimumRR = EnableSmartDecisionEngine
                ? CalculateAdaptiveMinimumRR()
                : (UseRRFilter ? MinimumTradeRR : 0.0);

            if (rr < minimumRR)
                return false;

            if (EnableSmartDecisionEngine && UseProxyExpectedValueGate)
            {
                int planQuality = (int)Clamp(
                    (_smartEntryQuality > 0 ? _smartEntryQuality : 70) * 0.55 +
                    _smartStructuralSequence * 0.25 +
                    _smartEntryLocationQuality * 0.20,
                    0, 100);
                _smartProxyExpectedValue = CalculateProxyExpectedValue(planQuality, rr);
                if (_smartProxyExpectedValue < MinimumProxyExpectedValue)
                    return false;
            }

            sl = NormalizePrice(sl);
            tp1 = NormalizePrice(tp1);
            tp2 = NormalizePrice(tp2);
            if (tp3 > 0) tp3 = NormalizePrice(tp3);
            if (tp4 > 0) tp4 = NormalizePrice(tp4);

            return NormalizeAndValidatePlanLevels(
                direction,
                ref entry,
                ref sl,
                ref tp1,
                ref tp2,
                ref tp3,
                ref tp4);
        }

        private double FindHtfProtectiveLow(
            Bars bars,
            int index,
            double entry)
        {
            if (bars == null || bars.Count < 20)
                return 0;

            index = Math.Min(index, bars.Count - 1);
            int last = index - SwingStrength;
            int first = Math.Max(
                SwingStrength,
                index - Math.Max(SlStructureLookback * 3, 30));
            double best = double.MinValue;

            for (int i = last; i >= first; i--)
            {
                double low = bars.LowPrices[i];
                if (low >= entry)
                    continue;

                bool swing = true;
                for (int j = 1; j <= SwingStrength; j++)
                {
                    if (i - j < 0 || i + j > index ||
                        low >= bars.LowPrices[i - j] ||
                        low >= bars.LowPrices[i + j])
                    {
                        swing = false;
                        break;
                    }
                }

                if (!swing)
                    continue;

                bool broken = false;
                for (int j = i + 1; j <= index; j++)
                {
                    if (bars.ClosePrices[j] < low)
                    {
                        broken = true;
                        break;
                    }
                }

                if (!broken && low > best)
                    best = low;
            }

            return best == double.MinValue ? 0 : NormalizePrice(best);
        }

        private double FindHtfProtectiveHigh(
            Bars bars,
            int index,
            double entry)
        {
