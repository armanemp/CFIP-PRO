                   s.Contains("TP4 HIT") ||
                   s.Contains("SL HIT") ||
                   s.Contains("INVALIDATED") ||
                   s.Contains("REVERSAL") ||
                   s.Contains("TIMEOUT") ||
                   s.Contains("EXIT RISK") ||
                   s.Contains("EXIT DECISION") ||
                   s.Contains("NEWS / EVENT GUARD");
