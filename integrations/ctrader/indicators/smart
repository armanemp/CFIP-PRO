        private Color GetSignalArrowColor(int direction, int confidence)
        {
            // Arrow color encodes signal state, not merely direction:
            // strong/high-confidence = strong color, confirmed = directional color,
            // caution/late/transition = caution color.
            bool highQuality = EnableSmartDecisionEngine &&
                               _smartQuality >= Math.Max(MinimumSmartQuality + 8, HighConfidenceThreshold - 4);
            bool aligned = EnableSmartDecisionEngine &&
                           _smartDirection == direction &&
                           (_smartRegime == "TREND" || _smartRegime == "EXPANSION");
            bool cautionRegime = _smartRegime == "RANGE" ||
                                 _smartRegime == "COMPRESSION" ||
                                 _smartRegime == "TRANSITION" ||
                                 _smartRegime == "UNKNOWN";

            if (confidence >= HighConfidenceThreshold || (highQuality && aligned))
                return direction == 1 ? StrongBuyArrowColor : StrongSellArrowColor;

            if (confidence >= MinimumConfidence && !cautionRegime)
                return direction == 1 ? ConfirmedBuyArrowColor : ConfirmedSellArrowColor;

            return direction == 1 ? CautionBuyArrowColor : CautionSellArrowColor;
        }

        private Color GetReactionArrowColor(int direction, int confidence, bool counterReaction)
        {
            if (counterReaction)
                return BlockedReactionArrowColor;
            return GetSignalArrowColor(direction, confidence);
        }

        private bool IsValidDirectionalStop(
            int direction,
            double entry,
            double stop)
        {
            if (!IsFinitePositive(entry) ||
                !IsFinitePositive(stop))
                return false;

            return direction == 1
                ? stop < entry
                : direction == -1 && stop > entry;
        }

        private bool IsValidDirectionalTarget(
            int direction,
            double entry,
            double target)
        {
            if (!IsFinitePositive(entry) ||
                !IsFinitePositive(target))
                return false;

            return direction == 1
                ? target > entry
                : direction == -1 && target < entry;
        }

        private void EnsureConfirmedPlanLines(int chartIndex)
        {
            if (Bars == null || Bars.Count < 2)
                return;

            if (!_signalActive ||
                _signalDirection == 0 ||
                !ShowLevelLines)
            {
                RemoveLevelDrawing(Prefix + "ENTRY");
                RemoveLevelDrawing(Prefix + "SL");
                RemoveLevelDrawing(Prefix + "TP1");
                RemoveLevelDrawing(Prefix + "TP2");
                RemoveLevelDrawing(Prefix + "TP3");
                RemoveLevelDrawing(Prefix + "TP4");
                return;
            }

            int anchor = _signalBar >= 0
                ? Math.Max(
                    0,
                    Math.Min(
                        _signalBar,
                        Bars.Count - 1))
                : Math.Max(
                    0,
                    Math.Min(
                        chartIndex,
                        Bars.Count - 1));

            GetFinitePlanRange(
                anchor,
                out int startIndex,
                out int endIndex);

            double entry = NormalizePrice(_signalEntry);
            double sl = NormalizePrice(_signalSl);
            double tp1 = _signalTp1 > 0
                ? NormalizePrice(_signalTp1)
                : 0;
            double tp2 = _signalTp2 > 0
                ? NormalizePrice(_signalTp2)
                : 0;
            double tp3 = _signalTp3 > 0
                ? NormalizePrice(_signalTp3)
                : 0;
            double tp4 = _signalTp4 > 0
                ? NormalizePrice(_signalTp4)
                : 0;

            bool entryOk =
                IsFinitePositive(entry);

            bool slOk =
                entryOk &&
                IsValidDirectionalStop(
                    _signalDirection,
                    entry,
                    sl);

            bool tp1Ok =
                entryOk &&
                IsValidDirectionalTarget(
                    _signalDirection,
                    entry,
                    tp1);

            bool tp2Ok =
                entryOk &&
                IsValidDirectionalTarget(
                    _signalDirection,
                    entry,
                    tp2);

            bool tp3Ok =
                entryOk &&
                IsValidDirectionalTarget(
                    _signalDirection,
                    entry,
                    tp3);

            bool tp4Ok =
                entryOk &&
                IsValidDirectionalTarget(
                    _signalDirection,
                    entry,
                    tp4);

            DrawAuthoritativeLevelLine(
                Prefix + "ENTRY",
                startIndex,
                endIndex,
                entry,
                EntryColor,
                ShowEntry && entryOk);

            DrawAuthoritativeLevelLine(
                Prefix + "SL",
                startIndex,
                endIndex,
                sl,
                SlColor,
                ShowSL && slOk);

            DrawAuthoritativeLevelLine(
                Prefix + "TP1",
                startIndex,
                endIndex,
                tp1,
                TpColor,
                ShowTP1 && tp1Ok);

            DrawAuthoritativeLevelLine(
                Prefix + "TP2",
                startIndex,
                endIndex,
                tp2,
                TpColor,
                ShowTP2 && tp2Ok);

            DrawAuthoritativeLevelLine(
                Prefix + "TP3",
                startIndex,
                endIndex,
                tp3,
                TpColor,
                ShowTP3 && tp3Ok);

            DrawAuthoritativeLevelLine(
                Prefix + "TP4",
                startIndex,
                endIndex,
                tp4,
                TpColor,
                ShowTP4 && tp4Ok);
        }


        private bool TryDrawLevelFallback(
            string fallbackName,
            int startIndex,
            int endIndex,
            double price,
            Color color,
            LineStyle lineStyle,
            bool extendToInfinity)
        {
            if (Bars == null || Bars.Count < 2)
                return false;

            int safeStart =
                Math.Max(
                    0,
                    Math.Min(
                        startIndex,
                        Bars.Count - 2));

            int safeEnd =
                Math.Max(
                    safeStart + 1,
                    Math.Min(
                        endIndex,
                        Bars.Count - 1));

            try
            {
                ChartTrendLine fallback =
                    Chart.FindObject(fallbackName) as ChartTrendLine;

                if (fallback == null)
                {
                    Chart.RemoveObject(fallbackName);

                    fallback =
                        Chart.DrawTrendLine(
                            fallbackName,
                            Bars.OpenTimes[safeStart],
                            price,
                            Bars.OpenTimes[safeEnd],
                            price,
                            color,
                            Math.Max(1, LevelLineThickness),
                            lineStyle);
                }

                if (fallback == null)
                    return false;

                fallback.Time1 =
                    Bars.OpenTimes[safeStart];
                fallback.Y1 = price;
                fallback.Time2 =
                    Bars.OpenTimes[safeEnd];
                fallback.Y2 = price;
                fallback.Color = color;
                fallback.Thickness =
                    Math.Max(1, LevelLineThickness);
                fallback.LineStyle = lineStyle;
                fallback.ExtendToInfinity =
                    extendToInfinity;
                fallback.IsInteractive = false;
                return true;
            }
            catch
            {
                return false;
            }
        }

