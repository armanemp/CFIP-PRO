            int start = Math.Max(2, index - FvgLookback);

            for (int i = index - 1; i >= start; i--)
            {
                double gap = bars.LowPrices[i - 2] - bars.HighPrices[i];
                if (gap < atr * MinimumFvgAtr || index - i > MaximumZoneAgeBars)
                    continue;

                double zoneLow = bars.HighPrices[i];
                double zoneHigh = bars.LowPrices[i - 2];
                bool invalidated = false;

for (int j = i + 1; j <= index; j++)
                {
                    if (bars.ClosePrices[j] > zoneHigh)
                    {
                        invalidated = true;
                        break;
                    }
                }

                if (invalidated)
                    continue;

                bool currentRetest =
                    bars.HighPrices[index] >= zoneLow &&
                    bars.LowPrices[index] <= zoneHigh;

                if (RequireFvgRetest && !currentRetest)
                    continue;

                if (!RequireFvgRetest || currentRetest)
                    return true;
            }

            return false;
        }

        // ============================================================
        // ORDER BLOCK
        // ============================================================

        private bool HasBullOb(
            Bars bars,
            int index)
        {
            double atr = GetAtr(bars, index, AtrPeriod);
            if (atr <= 0 || index < 4)
                return false;

            int start = Math.Max(2, index - ObLookback);

            for (int i = index - 2; i >= start; i--)
            {
                if (bars.ClosePrices[i] >= bars.OpenPrices[i])
                    continue;

                int impulse = i + 1;
                double impulseBody = Math.Abs(bars.ClosePrices[impulse] - bars.OpenPrices[impulse]);
                bool displaced = bars.ClosePrices[impulse] > bars.HighPrices[i] &&
                                 (!RequireObDisplacement || impulseBody >= atr * ObDisplacementAtr);

                if (!displaced || index - i > MaximumZoneAgeBars)
                    continue;

                double zoneLow = bars.LowPrices[i];
                double zoneHigh = bars.HighPrices[i];
                bool invalidated = false;

for (int j = impulse + 1; j <= index; j++)
                {
                    if (bars.ClosePrices[j] < zoneLow)
                    {
                        invalidated = true;
                        break;
                    }
                }

                if (invalidated)
                    continue;

                bool currentRetest =
                    bars.LowPrices[index] <= zoneHigh &&
                    bars.HighPrices[index] >= zoneLow;

                if (currentRetest && bars.ClosePrices[index] >= zoneLow)
                    return true;
            }

            return false;
        }

