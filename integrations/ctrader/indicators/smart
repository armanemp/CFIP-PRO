        private void SendContextAlerts(
            Analysis m5,
            Analysis m15,
            int chartIndex,
            int m5BarIndex)
        {
            if (m5 == null || m15 == null)
                return;

            List<string> buyEvents = new List<string>();
            List<string> sellEvents = new List<string>();

            if (AlertOnBos && (m5.MssBull || m5.MssBear || m15.MssBull || m15.MssBear))
            {
                if (m5.MssBull || m15.MssBull) buyEvents.Add("BOS/MSS BUY");
                if (m5.MssBear || m15.MssBear) sellEvents.Add("BOS/MSS SELL");
            }

            if (AlertOnMssChoch && (m5.ChochBull || m5.ChochBear || m15.ChochBull || m15.ChochBear))
            {
                if (m5.ChochBull || m15.ChochBull) buyEvents.Add("CHOCH BUY");
                if (m5.ChochBear || m15.ChochBear) sellEvents.Add("CHOCH SELL");
            }

            if (AlertOnLiquiditySweep && (m5.LiquidityBull || m5.LiquidityBear || m15.LiquidityBull || m15.LiquidityBear))
            {
                if (m5.LiquidityBull || m15.LiquidityBull) buyEvents.Add("LIQUIDITY SWEEP BUY");
                if (m5.LiquidityBear || m15.LiquidityBear) sellEvents.Add("LIQUIDITY SWEEP SELL");
            }

            if (buyEvents.Count == 0 && sellEvents.Count == 0)
                return;

            // A mixed BUY+SELL context on the same decision bar is ambiguous and
            // must never be turned into an alert.
            if (buyEvents.Count > 0 && sellEvents.Count > 0)
            {
                _contextStatusText = "CONTEXT MIXED | NO DIRECTIONAL ALERT";
                if (!_suppressIntermediatePanelRender)
                    DrawUnifiedPanel();
                return;
            }

            int direction = buyEvents.Count > 0 ? 1 : -1;

            if (direction == 0)
                return;

            // Context notifications must not contradict an established execution bias
            // unless a genuine M15 reversal is present. They are informational, not trades.
            if (PreventRapidDirectionFlip && _lastDirectionalBias != 0 && direction != _lastDirectionalBias)
            {
                bool structural = direction == 1
                    ? (m15.MssBull || m15.ChochBull)
                    : (m15.MssBear || m15.ChochBear);
                bool force = direction == 1
                    ? (m15.DisplacementBull || m15.LiquidityBull)
                    : (m15.DisplacementBear || m15.LiquidityBear);
                bool reversal = RequireReversalForce ? structural && force : structural || force;
                if (!reversal || m15.Direction != direction)
                    return;
            }

            // Context alerts are informative, but they must not create the same
            // rapid BUY/SELL flip that was previously confusing as a trade trigger.
            if (PreventRapidDirectionFlip &&
                _lastContextAlertDirection != 0 &&
                direction != _lastContextAlertDirection)
            {
                int elapsed = m5BarIndex - _lastContextAlertDirectionBar;
                if (elapsed < Math.Max(1, OppositeSignalCooldownBars))
                    return;

                if (RequireM15ReversalForOpposite)
                {
                    bool structural = direction == 1
                        ? (m15.MssBull || m15.ChochBull)
                        : (m15.MssBear || m15.ChochBear);
                    bool force = direction == 1
                        ? (m15.DisplacementBull || m15.LiquidityBull)
                        : (m15.DisplacementBear || m15.LiquidityBear);
                    bool reversal = RequireReversalForce
                        ? structural && force
                        : structural || force;
                    if (m15.Direction != direction || !reversal)
                        return;
                }
            }

            List<string> aligned = direction == 1 ? buyEvents : sellEvents;
            if (aligned.Count == 0)
                return;

            string label = string.Join(" + ", aligned);
            DrawContextEventMarker(label, direction, chartIndex);
            QueueContextDecisionAlert(label + " | CONTEXT ONLY | " + SymbolName, direction, m5BarIndex);

            _lastContextAlertDirection = direction;
            _lastContextAlertDirectionBar = m5BarIndex;
            _contextStatusText = "CONTEXT  " + label;
            if (!_suppressIntermediatePanelRender)
                DrawUnifiedPanel();
        }

