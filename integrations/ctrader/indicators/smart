        private int MapM5BarToChartIndex(int m5BarIndex, int fallbackIndex)
        {
            int fallback = Bars == null || Bars.Count == 0
                ? 0
                : Math.Max(0, Math.Min(fallbackIndex, Bars.Count - 1));

            if (_m5 == null || m5BarIndex < 0 || m5BarIndex >= _m5.Count || Bars == null || Bars.Count == 0)
                return fallback;

            int mapped = Bars.OpenTimes.GetIndexByTime(_m5.OpenTimes[m5BarIndex]);
            return mapped >= 0 && mapped < Bars.Count ? mapped : fallback;
        }

        private void GetFinitePlanRange(int anchorIndex, out int startIndex, out int endIndex)
        {
            int safeAnchor = Bars == null || Bars.Count < 2
                ? 0
                : Math.Max(0, Math.Min(anchorIndex, Bars.Count - 1));

            int before = Math.Max(1, LineLengthBars);
            int after = Math.Max(1, LineStartBars);
            startIndex = Math.Max(0, safeAnchor - before);
            endIndex = Math.Min(Bars.Count - 1, safeAnchor + after);

            if (endIndex <= startIndex)
            {
                startIndex = Math.Max(0, safeAnchor - 1);
                endIndex = Math.Min(Bars.Count - 1, safeAnchor + 1);
            }
        }

        private void GetFinitePredictionRange(int anchorIndex, out int startIndex, out int endIndex)
        {
            GetFinitePlanRange(anchorIndex, out startIndex, out endIndex);

            if (Bars == null || Bars.Count < 2)
                return;

            int safeAnchor = Math.Max(0, Math.Min(anchorIndex, Bars.Count - 1));
            int lookback = Math.Max(1, LineLengthBars);
            int forward = Math.Max(Math.Max(1, LineStartBars), Math.Max(2, PredictionLookahead));

            startIndex = Math.Max(0, safeAnchor - lookback);
            endIndex = Math.Min(Bars.Count - 1, safeAnchor + forward);

            if (endIndex <= startIndex)
            {
                startIndex = Math.Max(0, safeAnchor - 1);
                endIndex = Math.Min(Bars.Count - 1, safeAnchor + 1);
            }
        }

