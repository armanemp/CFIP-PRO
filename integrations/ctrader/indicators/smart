                    if (m5.DisplacementBear) confirmations++;
                    if (m5.LiquidityBear) confirmations++;
                    if (m5.FvgBear || m5.ObBear) confirmations++;
                }
            }

            if (m15 != null)
            {
                if (direction == 1)
                {
                    if (m15.MssBull || m15.ChochBull) confirmations++;
                    if (m15.DisplacementBull) confirmations++;
                    if (m15.LiquidityBull) confirmations++;
                    if (m15.FvgBull || m15.ObBull) confirmations++;
