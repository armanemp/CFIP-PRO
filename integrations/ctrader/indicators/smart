        private bool EntryTriggerReached(Bars bars, int closedIndex, int direction)
        {
            if (bars == null || closedIndex < 20 || closedIndex >= bars.Count)
                return false;

            double atr = GetAtr(bars, closedIndex, AtrPeriod);
            if (atr <= 0)
                return false;

            double buffer = atr * Math.Max(0.0, EntryTriggerBufferAtr);
            double close = bars.ClosePrices[closedIndex];

            int triggerScore = direction == 1
                ? LiveBullTriggerScore(bars, closedIndex)
                : LiveBearTriggerScore(bars, closedIndex);

            // A high-quality closed-bar trigger is executable immediately.
            if (triggerScore >= PrecisionTriggerScore)
                return true;

            double priorHigh = HighestHigh(
                bars,
                Math.Max(0, closedIndex - 6),
                closedIndex - 1);
            double priorLow = LowestLow(
                bars,
                Math.Max(0, closedIndex - 6),
                closedIndex - 1);

            bool bullishBreak = close > priorHigh;
            bool bearishBreak = close < priorLow;

            // A retrace is valid only after the confirmation candle actually
            // broke the relevant micro-structure level. This prevents the old
            // condition from approving almost every price near the close.
            double retraceAllowance = atr * Math.Max(0.05, MaximumEntryExtensionAtr * 0.35);
            if (direction == 1)
            {
                // Once a closed confirmation candle has genuinely broken the
                // prior micro-range, a normal post-break retest must not erase
                // the opportunity. The market-side checks below still reject
                // an excessive extension.
                if (bullishBreak &&
                    Symbol.Ask >= close - retraceAllowance)
                    return true;

                return Symbol.Ask >= close + buffer;
            }

            if (bearishBreak &&
                Symbol.Bid <= close + retraceAllowance)
                return true;

            return Symbol.Bid <= close - buffer;
        }

        private double GetPreciseExecutionEntry(Bars bars, int closedIndex, int direction)
        {
            // Never fabricate a fill price. The only executable price is the
            // current market side of the spread.
            double market = direction == 1 ? Symbol.Ask : Symbol.Bid;
            return NormalizePrice(market);
        }



        private void CreateLiveSignal(
            int chartIndex,
            int m5LiveIndex,
            int m5ClosedIndex,
            int direction,
            int confidence)
        {
            if (_m5 == null ||
                m5ClosedIndex < 20 ||
                m5ClosedIndex >= _m5.Count)
                return;

            double entry = UsePrecisionExecutionModel
                ? GetPreciseExecutionEntry(_m5, m5ClosedIndex, direction)
                : NormalizePrice(direction == 1 ? Symbol.Ask : Symbol.Bid);

            double sl;
            double tp1;
            double tp2;
            double tp3;
            double tp4;
            double rr;

            if (!ValidateTradeRiskReward(
                    _m5,
                    m5ClosedIndex,
                    direction,
                    entry,
                    out sl,
                    out tp1,
                    out tp2,
                    out tp3,
                    out tp4,
                    out rr))
            {
                return;
            }

            if (!NormalizeAndValidatePlanLevels(
                    direction,
                    ref entry,
                    ref sl,
                    ref tp1,
                    ref tp2,
                    ref tp3,
                    ref tp4))
                return;

            // Anchor the visible signal to the actual closed M5 decision bar.
            _signalBar = MapM5BarToChartIndex(m5ClosedIndex, chartIndex);
            _signalDirection = direction;
            _signalEntry = entry;
            _signalSl = NormalizePrice(sl);
            _signalTp1 = NormalizePrice(tp1);
            _signalTp2 = NormalizePrice(tp2);
            _signalTp3 = tp3 > 0 ? NormalizePrice(tp3) : 0;
            _signalTp4 = tp4 > 0 ? NormalizePrice(tp4) : 0;
            double blendedConfidence = EnableSmartDecisionEngine
                ? (confidence * 0.45) + (_smartQuality * 0.55)
                : confidence;
            _signalConfidence = (int)Clamp(Math.Round(blendedConfidence), 0.0, 100.0);
            _signalRR = rr;
            _smartProxyExpectedValue = CalculateProxyExpectedValue((int)Clamp((_smartEntryQuality > 0 ? _smartEntryQuality : 70) * 0.55 + _smartStructuralSequence * 0.25 + _smartEntryLocationQuality * 0.20, 0, 100), rr);
            _signalInitialRisk = Math.Abs(_signalEntry - _signalSl);
            RefreshSignalLevelMetadata(
                _m5,
                m5ClosedIndex);
            _maxFavorablePrice = _signalEntry;
            _lastLiveExitSl = _signalSl;
            _lastExitM5Bar = m5LiveIndex;
            _lastSmartTargetCalcM5Bar = -1;
            _lastSmartTargetCalcPrice = 0;
            _lastSmartStructuralStopCalcM5Bar = -1;
            _lastSmartStructuralStopCalcPrice = 0;
            _cachedSmartStructuralStop = 0;
            _signalActive = true;
            _signalOutcome = "ACTIVE";
            _signalCreatedM5Bar = m5LiveIndex;
            _signalMfe = 0;
            _signalMae = 0;
            _signalMfeR = 0;
            _signalMaeR = 0;
            _signalMfeBars = 0;
            _signalMaeBars = 0;
            _signalTp1Bars = -1;
            _signalTp2Bars = -1;
            _signalTp3Bars = -1;
            _signalTp4Bars = -1;
            _signalSlBars = -1;
            _signalOutcomeBar = -1;
            _smartInvalidationScore = 0;
            _falseSignalAlerted = false;
            _outcomeRecorded = false;
            SetEngineStateHeader(direction == 1 ? "BUY ACTIVE" : "SELL ACTIVE");
            _lastSignalDecisionM5Bar = m5LiveIndex;
            _lastConfirmedSignalDirection = direction;
            _lastConfirmedSignalM5Bar = m5LiveIndex;

            _tp1Alerted = false;
            _tp2Alerted = false;
            // TP3/TP4 may be discovered later by the structural target map.
            // They must remain alertable/populatable even if the first snapshot had only TP1/TP2.
            _tp3Alerted = false;
            _tp4Alerted = false;
            _slAlerted = false;

            ClearEarlyObjects();
            _liveReactionDirection = 0;
            _liveReactionConfidence = 0;
            _liveReactionEvidence = 0;
            _liveReactionBar = -1;
            ClearLiveReactionObjects();
            _predictionDirection = 0;
            _predictionConfidence = 0;

            string signalAlert = BuildSignalAlertMessage(direction, _signalConfidence, _signalRR) +
                " | STRUCTURAL EXIT " +
                (_signalTp4 > 0 ? "TP1-TP4" : _signalTp3 > 0 ? "TP1-TP3" : "TP1-TP2") +
                " | SL " + FormatPrice(_signalSl) +
                " | TP1 " + FormatPrice(_signalTp1) +
                " | TP2 " + FormatPrice(_signalTp2);
            if (AlertOnHighConfidenceEntry && _signalConfidence >= HighConfidenceThreshold)
                signalAlert = "HIGH-CONFIDENCE ENTRY | " + signalAlert;

            _pendingHighConfidenceSignalAlert =
                AlertOnHighConfidenceEntry &&
                _signalConfidence >= HighConfidenceThreshold;

            QueueSignalDecisionAlert(
                signalAlert,
                direction,
                m5LiveIndex);
        }

